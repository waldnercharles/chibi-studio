# Assemble a runnable, editable application using only installed SDK products.
set(destination "@web_destination@")
set(data "${destination}/data")
# This build-owned directory is the complete web product; replacing it prevents
# obsolete native editor bundles from leaking into the next installation.
file(REMOVE_RECURSE "${destination}")
file(MAKE_DIRECTORY "${data}/application" "${data}/workspace" "${data}/sdk")
file(COPY "@CHIBI_AUTHOR_WEB_DIR@/" DESTINATION "${destination}")
file(COPY "@app@/" DESTINATION "${data}/application")
file(COPY "@CHIBI_STUDIO_ARTIFACT@" DESTINATION "${data}/application")
set(workspace "null")
if(NOT "@CHIBI_STUDIO_WORKSPACE_ROOT@" STREQUAL "")
    file(COPY "@CHIBI_STUDIO_WORKSPACE_ROOT@/" DESTINATION "${data}/workspace")
    set(workspace "\"/data/workspace\"")
endif()
file(COPY "@sdk_destination@/" DESTINATION "${data}/sdk")
# Runtime evidence identifies the actual web host, while retaining the selected
# SDK's exact manifest separately as the offline compiler/resource provenance.
file(RENAME "${data}/sdk/package.json" "${data}/sdk/source-sdk-package.json")
file(COPY "@CHIBI_AUTHOR_WEB_DIR@/package.json" "@CHIBI_AUTHOR_WEB_DIR@/engine.json" DESTINATION "${data}/sdk")
file(COPY_FILE "${destination}/index.html" "${destination}/chibi-studio.html")
set(channels "{}")
set(service "@CHIBI_STUDIO_COLLAB_URL@")
if(service)
    string(REPLACE "\\" "\\\\" service "${service}")
    string(REPLACE "\"" "\\\"" service "${service}")
    string(JSON channels SET "${channels}" collaboration "{}")
    string(JSON channels SET "${channels}" collaboration service_url "\"${service}\"")
endif()
file(WRITE "${destination}/author.json" "{\"artifact\":\"/data/application/game.chibip\",\"resource_root\":\"/data/application\",\"workspace_root\":${workspace},\"sdk_resource_root\":\"/data/sdk\",\"channels\":${channels}}\n")
file(GLOB_RECURSE paths LIST_DIRECTORIES FALSE RELATIVE "${data}" "${data}/*")
list(SORT paths)
set(json "[]")
set(index 0)
foreach(path IN LISTS paths)
    string(REPLACE "\\" "\\\\" escaped "${path}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(JSON json SET "${json}" ${index} "\"${escaped}\"")
    math(EXPR index "${index}+1")
endforeach()
file(WRITE "${destination}/files.json" "${json}\n")
file(WRITE "${destination}/.nojekyll" "")
