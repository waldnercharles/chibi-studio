+NVec4f ZepWindow::GetTextScrollInfo()
+{
+    UpdateLayout();
+    return NVec4f(m_textOffsetPx, std::max(0.0f, m_textSizePx.y - m_textRegion->rect.Height()),
+        m_textRegion->rect.Top(), m_textRegion->rect.Bottom());
+}
+
+void ZepWindow::SetTextOffsetY(float offset)
+{
+    UpdateLayout();
+    m_textOffsetPx = std::max(0.0f, std::min(offset, m_textSizePx.y - m_textRegion->rect.Height()));
+    m_cursorMoved = false;
+    UpdateVisibleLineRange();
+}
