.studio-model { display: block; padding: 12dp; overflow-y: auto; }
.studio-model-heading { display: flex; align-items: center; justify-content: space-between; gap: 8dp; margin-bottom: 8dp; }
.studio-model-heading .title { font-weight: 600; }
.studio-model-preview { display: flex; align-items: center; justify-content: center; height: 240dp; overflow: hidden; background-color: var(--rail); border: 1dp var(--edge); border-radius: var(--r); }
.studio-model-preview:focus { border-color: var(--ring); }
.studio-model-preview > texture-view { display: block; width: 100%; height: 100%; }
.studio-model-preview > span { color: var(--muted-foreground); }
.studio-model-view { display: flex; align-items: center; gap: 6dp; margin-top: 8dp; }
.studio-model-view > [data-ui=NumberField], .studio-model-view > .field { flex: 1; min-width: 0dp; }
.studio-model-defaults { margin: 16dp 0dp; }
.studio-model-parameter { margin-bottom: 12dp; }
.studio-model-components { display: flex; width: 100%; }
.studio-model-components > * { flex: 1; min-width: 0dp; }
.studio-model-stat, .studio-model-part, .studio-model-anchor { display: flex; justify-content: space-between; gap: 12dp; padding: 3dp 0dp; }
.studio-model-diagnostics { margin-top: 16dp; }
.studio-model-diagnostics .panel-head { width: 100%; text-align: left; }
.studio-model-bake { border-top: 1dp var(--line); margin-top: 16dp; padding-top: 12dp; }
.studio-model-bake > [data-ui=NumberField] { margin-top: 6dp; }
.studio-model p { margin: 6dp 0dp; line-height: 1.45; }
.studio-model .notice { margin: 8dp 0dp; }

.studio-model-parts { max-height: 196dp; overflow-y: auto; display: flex; flex-direction: column; }
.studio-model-parts .btn { min-height: 28dp; text-align: left; }
.studio-model-inspection { margin-top: 8dp; }
