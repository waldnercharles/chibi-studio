<span class="dim" data-if="self.graph.document == 0">No behavior open</span>
<div class="graph-head" data-if="self.graph.document &gt; 0">
  <button class="btn icon-only" data-tip="Back" data-kbd="Alt+Left" data-attrif-data-disabled="!self.graph.canBack" data-event-click="emit('StudioGraphCommand','back','')"><span class="icon">&#xea9b;</span></button>
  <button class="btn icon-only" data-tip="Forward" data-kbd="Alt+Right" data-attrif-data-disabled="!self.graph.canForward" data-event-click="emit('StudioGraphCommand','forward','')"><span class="icon">&#xea9c;</span></button>
  <div class="crumbs"><span class="btn crumb"><span class="icon">&#xf0169;</span><span class="label">{{ self.graph.assetLabel }}</span></span><span class="icon crumb-sep">&#xeab6;</span>
    <div class="caller" data-for="caller : self.graph.callerSlots"><button class="btn crumb" data-event-click="emit('StudioGraphAction','caller',caller + '',self.graph.document,self.graph.revision)"><span class="label">{{ self.graph.callerLabels[caller] }}</span></button><span class="icon crumb-sep">&#xeab6;</span></div>
    <button class="btn crumb current" data-attr-popovertarget="'studio-graph-picker-' + pane" aria-haspopup="listbox" data-tip="Choose event or function"><span class="icon">&#xf0871;</span><span class="label">{{ self.graph.scopeName == '' ? 'Event Graph' : self.graph.scopeName }}</span></button>
  </div>
  <div class="segmented" data-if="self.graph.dialect == 'chibi'" data-tip="Behavior view">
    <button class="seg" data-attrif-data-pressed="area.graphView == 'graph'" data-event-click="emit('StudioAreaViewChanged',pane,'graph')">Graph</button>
    <button class="seg" data-attrif-data-pressed="area.graphView == 'code'" data-event-click="emit('StudioAreaViewChanged',pane,'code')">Code</button>
    <button class="seg" data-attrif-data-pressed="area.graphView == 'both'" data-event-click="emit('StudioAreaViewChanged',pane,'both')">Both</button>
  </div>
  <span class="badge" data-if="self.graph.readonly" data-tip="Read-only">Read-only</span><div class="spacer"/>
  <button class="btn subtle sm debug-target" data-if="self.debugSession &gt; 0" data-attr-popovertarget="'studio-graph-debug-targets-' + pane" aria-haspopup="listbox" data-tip="Debug target"><span class="icon">&#xebf8;</span><span class="label">{{ self.debugName == '' ? 'No target' : self.debugName }}</span></button>
  <button class="btn sm zoom" data-tip="Zoom to 100%" data-event-click="emit('StudioGraphCommand','zoomActual','')"><number-flow class="number-flow readout" data-attr-value="self.graph.zoom * 100" precision="0" prefix="" suffix="%"/></button>
  <button class="btn icon-only" data-attr-popovertarget="'studio-graph-actions-' + pane" aria-haspopup="menu" data-tip="Graph"><span class="icon">&#xea7c;</span></button>
  <button class="btn icon-only" data-tip="Arrange" data-kbd="Shift+Alt+A" data-attrif-data-disabled="self.graph.readonly || self.graph.busy" data-event-click="emit('StudioGraphAction','arrange','',self.graph.document,self.graph.revision)"><span class="icon">&#xebeb;</span></button>
  <button class="btn icon-only" data-tip="Find" data-kbd="Mod+F" data-event-click="emit('StudioGraphCommand','find','')"><span class="icon">&#xea6d;</span></button>
  <button class="btn icon-only" data-tip="Frame all" data-kbd="Home" data-event-click="emit('StudioGraphAction','home','',self.graph.document,self.graph.revision)"><span class="icon">&#xf004c;</span></button>
  <button class="btn icon-only" data-attr-popovertarget="'studio-graph-view-' + pane" aria-haspopup="menu" data-tip="View"><span class="icon">&#xeb2f;</span></button>
  <use ui="Menu" data-attr-id="'studio-graph-picker-' + pane"><choice-list class="choice-list" data-event-change="emit('StudioGraphAction','graph',ev.value,self.graph.document,self.graph.revision)"><div class="field search"><input type="text" class="part value" placeholder="Search graphs" data-event-change="stop()"/></div><div class="graph-header-options"><div class="menu-item" role="option" data-for="scope : self.graph.scopes" data-attr-value="scope.graph" data-attr-data-label="scope.name" data-attrif-data-current="scope.graph == self.graph.active"><span class="icon lead">&#xf0871;</span><span class="text"><span class="label">{{ scope.name == '' ? 'Event Graph' : scope.name }}</span></span></div></div></choice-list></use>
  <use ui="Menu" data-attr-id="'studio-graph-actions-' + pane"><button class="menu-item" role="menuitem" data-event-click="emit('StudioGraphAction','palette','',self.graph.document,self.graph.revision)">Add Node</button><button class="menu-item" role="menuitem" data-event-click="emit('StudioGraphAction','functionAdd','',self.graph.document,self.graph.revision)">Add Function</button><button class="menu-item" role="menuitem" data-event-click="emit('StudioGraphAction','macroAdd','',self.graph.document,self.graph.revision)">Add Macro</button><use ui="MenuSeparator"/><button class="menu-item" role="menuitem" data-event-click="emit('StudioGraphAction','validate','',self.graph.document,self.graph.revision)">Validate</button><button class="menu-item" role="menuitem" data-event-click="emit('StudioGraphAction','frame','',self.graph.document,self.graph.revision)">Frame Selected</button></use>
  <use ui="Menu" data-attr-id="'studio-graph-view-' + pane"><use ui="MenuGroup">Wires</use><button class="menu-item" role="menuitemradio" data-attr-aria-checked="self.graph.wireStyle == 0" data-event-click="emit('StudioPreferenceNumber','wires',0)">Curved</button><button class="menu-item" role="menuitemradio" data-attr-aria-checked="self.graph.wireStyle == 1" data-event-click="emit('StudioPreferenceNumber','wires',1)">Orthogonal</button><button class="menu-item" role="menuitemradio" data-attr-aria-checked="self.graph.wireStyle == 2" data-event-click="emit('StudioPreferenceNumber','wires',2)">Straight</button><button class="menu-item" role="menuitemradio" data-attr-aria-checked="self.graph.wireStyle == 3" data-event-click="emit('StudioPreferenceNumber','wires',3)">Subway</button><use ui="MenuSeparator"/><use ui="MenuGroup">Nodes</use><button class="menu-item" role="menuitemcheckbox" data-attr-aria-checked="self.graph.titleFlow" data-event-click="emit('StudioPreferenceNumber','nodes.titleFlow',self.graph.titleFlow ? 0 : 1)">Flow in Titles</button><button class="menu-item" role="menuitemcheckbox" data-attr-aria-checked="self.graph.compact" data-event-click="emit('StudioPreferenceNumber','nodes.compact',self.graph.compact ? 0 : 1)">Compact Nodes</button><button class="menu-item" role="menuitemcheckbox" data-event-click="emit('StudioGraphCommand','showLiveValues','')">Live Values</button></use>
  <use ui="Menu" data-attr-id="'studio-graph-debug-targets-' + pane"><div class="graph-header-options"><button class="menu-item" role="option" data-for="target : self.debugTargetSlots" data-event-click="emit('StudioDebuggerTarget',self.debugTargets[target].name,self.debugTargets[target].owner,self.debugSession,self.debugViewRevision)">{{ self.debugTargets[target].name }}</button></div></use>
</div>
