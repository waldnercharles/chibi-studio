<div class="popup menu refactor" popover role="menu" id="refactor">
  <div class="menu-group">{{ refactor.title }}</div>
  <div class="refactor-field" data-if="refactor.rename"><div class="field text"><input type="text" class="part value" id="refactor-name" data-keys="Enter:refactor.enter" data-event-input="emit('refactor.name', ev.value)"/></div></div>
  <div class="refactor-row" data-if="refactor.error != ''"><span class="icon lead">&#xea6c;</span><span class="label">{{ refactor.error }}</span></div>
  <div class="refactor-row" data-for="row : refactor.rows"><span class="icon lead">{{ row.icon }}</span><span class="label">{{ row.label }}</span><span class="kbd" data-if="row.meta != ''">{{ row.meta }}</span></div>
  <use ui="MenuSeparator"/>
  <use ui="MenuItem" data-alias-item="refactor.apply" data-event-click="emit('refactor.apply')"/>
</div>
