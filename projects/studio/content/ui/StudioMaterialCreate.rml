<use ui="Menu" id="studio-material-create" class="material-create-menu">
  <div class="material-create-title">New material</div>
  <label class="material-create-name"><span>Name</span><input id="studio-material-create-name" class="field text" aria-label="Material name" data-attr-value="self.materialCreate.name" data-attrif-readonly="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-input="emit('StudioMaterialCreateName', ev.value)"/></label>
  <div class="material-create-row"><label>Starting material</label><use ui="Select"><select aria-label="Starting material" data-value="self.materialCreate.preset" data-attrif-disabled="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-change="emit('StudioMaterialCreatePreset', ev.value)"><option value="matte">Matte</option><option value="metal">Metal</option><option value="emissive">Emissive</option><option value="unlit">Unlit</option></select></use></div>
  <div class="material-create-row"><label>Base color</label><use ui="ColorField" aria-label="Base color" data-attr-value="self.materialCreate.baseColor" data-attrif-disabled="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-change="emit('StudioMaterialCreateColor', 'base', ev.value)"/></div>
  <div class="material-create-row"><label>Roughness</label><use ui="NumberField" aria-label="Roughness" min="0" max="1" step="0.01" data-attr-value="self.materialCreate.roughness" data-attrif-readonly="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-change="emit('StudioMaterialCreateNumber', 'roughness', ev.value, ev.canceled)"/></div>
  <div class="material-create-row"><label>Metallic</label><use ui="NumberField" aria-label="Metallic" min="0" max="1" step="0.01" data-attr-value="self.materialCreate.metallic" data-attrif-readonly="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-change="emit('StudioMaterialCreateNumber', 'metallic', ev.value, ev.canceled)"/></div>
  <div class="material-create-row"><label>Emission color</label><use ui="ColorField" aria-label="Emission color" data-attr-value="self.materialCreate.emissionColor" data-attrif-disabled="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-change="emit('StudioMaterialCreateColor', 'emission', ev.value)"/></div>
  <div class="material-create-row"><label>Emission strength</label><use ui="NumberField" aria-label="Emission strength" min="0" max="16" step="0.1" data-attr-value="self.materialCreate.emissionGain" data-attrif-readonly="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-change="emit('StudioMaterialCreateNumber', 'emissionGain', ev.value, ev.canceled)"/></div>
  <div class="material-create-row"><label>Alpha mode</label><use ui="Select"><select aria-label="Alpha mode" data-value="self.materialCreate.alpha" data-attrif-disabled="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-change="emit('StudioMaterialCreateAlpha', ev.value)"><option value="blend">Blend</option><option value="opaque">Opaque</option><option value="mask">Mask</option></select></use></div>
  <div class="material-create-row" data-if="self.materialCreate.alphaMode != 1"><label>Opacity</label><use ui="NumberField" aria-label="Opacity" min="0" max="1" step="0.01" data-attr-value="self.materialCreate.opacity" data-attrif-readonly="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-change="emit('StudioMaterialCreateNumber', 'opacity', ev.value, ev.canceled)"/></div>
  <div class="material-create-row" data-if="self.materialCreate.alphaMode == 2"><label>Alpha cutoff</label><use ui="NumberField" aria-label="Alpha cutoff" min="0" max="1" step="0.01" data-attr-value="self.materialCreate.alphaCutoff" data-attrif-readonly="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-change="emit('StudioMaterialCreateNumber', 'alphaCutoff', ev.value, ev.canceled)"/></div>
  <div class="material-create-row"><label>Unlit</label><use ui="Checkbox" data-attrif-checked="self.materialCreate.unlit" data-attrif-disabled="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-change="emit('StudioMaterialCreateUnlit', ev.value)"/></div>
  <div class="material-create-hint">Colors are shown in sRGB and stored as linear RGB. Emission strength multiplies its color.</div>
  <div class="material-create-error" data-if="self.materialCreate.error != ''" role="alert">{{ self.materialCreate.error }}</div>
  <div class="material-create-hint" data-if="self.materialCreate.done" role="status">Material created and opened.</div>
  <button class="btn primary" data-attrif-data-disabled="self.materialCreate.busy || self.materialCreate.readOnly || self.materialCreate.done" data-event-click="emit('StudioMaterialCreateConfirm')">Create material</button>
</use>
