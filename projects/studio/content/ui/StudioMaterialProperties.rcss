/* Shared field, panel, button and typography tokens govern this authored view. */
.studio-visual { display: block; padding: 12dp; overflow-y: auto; }
.studio-visual-empty { color: var(--muted-foreground); padding: 12dp 0dp; }
.studio-visual-heading { display: flex; align-items: center; justify-content: space-between; gap: 8dp; margin-bottom: 8dp; }
.studio-visual-heading .title { font-weight: 600; }
.studio-visual-preview { display: flex; align-items: center; justify-content: center; width: 100%; height: 200dp; overflow: hidden; background-color: var(--rail); border: 1dp var(--edge); border-radius: var(--r); }
.studio-visual-preview > texture-view { display: block; width: 100%; height: 100%; }
.studio-visual-preview > span { color: var(--muted-foreground); }
.studio-visual-preview:focus { border-color: var(--ring); }
.studio-visual-view, .studio-visual-probe-controls { display: flex; align-items: center; gap: 6dp; margin-top: 8dp; }
.studio-visual-view > *, .studio-visual-probe-controls > [data-ui=NumberField] { flex: 1 1 0dp; min-width: 0dp; }
.studio-visual-defaults { display: block; margin: 16dp 0dp; }
.studio-visual-parameter { display: block; margin-bottom: 12dp; }
.studio-visual-label { display: flex; align-items: center; justify-content: space-between; gap: 8dp; margin-bottom: 5dp; }
.studio-visual-label .dim { font-size: var(--studio-font-11, 11dp); }
.studio-visual-components { display: flex; width: 100%; }
.studio-visual-components > * { flex: 1 1 0dp; min-width: 0dp; }
.studio-visual-diagnostics { margin-top: 16dp; }
.studio-visual-diagnostics .panel-head { width: 100%; text-align: left; }
.studio-visual-diagnostics p, .studio-visual-evidence p { margin: 6dp 0dp; line-height: 1.45; }
.studio-visual-cost, .studio-visual-sample { display: flex; justify-content: space-between; gap: 12dp; padding: 3dp 0dp; }
.studio-visual-sample { font-size: var(--studio-font-11, 11dp); }
.studio-visual-evidence { display: block; border-top: 1dp var(--line); margin-top: 16dp; padding-top: 12dp; }
.studio-visual .notice { margin: 8dp 0dp; }

.studio-visual-textures { margin-top: 16dp; }
.studio-visual-textures .field.select { width: 100%; margin-top: 5dp; }
.studio-visual-textures .field.select > span:nth-child(2) { flex: 1; overflow: hidden; text-overflow: ellipsis; }
.studio-visual-picker { padding: 8dp 0dp; }
.studio-visual-picker .choice-results { max-height: 196dp; overflow-y: auto; }
.studio-visual-picker .menu-item { height: 28dp; }
.studio-visual-label [data-ui=ColorField] { width: 54dp; }
