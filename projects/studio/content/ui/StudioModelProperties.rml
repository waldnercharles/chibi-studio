<div class="studio-model" data-if="self.modelActive">
  <use ui="StudioModelRuntime"/>
  <p class="dim" data-if="self.modelShared">Shared changes update the preview when accepted.</p><p role="status" data-if="self.modelProposalPending">Waiting for shared edit acceptance…</p>
  <div class="studio-model-heading"><span class="title">Model</span><button class="btn icon-only sm" aria-label="Refresh model dependencies" data-event-click="emit('StudioModelView','refresh',0)"><span class="icon">&#xeae2;</span></button><button class="btn icon-only sm" aria-label="Reset model view" data-event-click="emit('StudioModelView','reset',0)"><span class="icon">&#xeae2;</span></button></div>
  <div id="studio-model-preview" data-measure class="studio-model-preview" tabindex="0" aria-label="Model preview. Drag to orbit; middle drag to pan; scroll to zoom." data-event-mousedown="emit('StudioModelOrbit','down',ev.mouse_x,ev.mouse_y)" data-event-mousemove="emit('StudioModelOrbit','move',ev.mouse_x,ev.mouse_y)" data-event-mouseup="emit('StudioModelOrbit','up',ev.mouse_x,ev.mouse_y)" data-event-mouseleave="emit('StudioModelOrbit','up',ev.mouse_x,ev.mouse_y)" data-event-mousescroll="emit('StudioModelOrbit','wheel',0,ev.wheel_delta_y)">
    <texture-view data-if="self.modelImage != ''" data-attr-src="self.modelImage"/><span data-if="self.modelImage == ''">Preview unavailable</span>
  </div>
  <div class="studio-model-view"><button class="btn outline sm" data-event-click="emit('StudioModelView','front',0)">Front</button><button class="btn outline sm" data-event-click="emit('StudioModelView','side',0)">Side</button><button class="btn outline sm" data-event-click="emit('StudioModelView','top',0)">Top</button></div>
  <div class="studio-model-view"><use ui="NumberField" addon="Time" unit="s" step="0.05" aria-label="Model preview time" data-attr-value="self.modelTime" data-event-change="emit('StudioModelView','time',ev.value)"/><use ui="NumberField" addon="Zoom" min="0.25" max="4" step="0.05" aria-label="Model preview zoom" data-attr-value="self.modelZoom" data-event-change="emit('StudioModelView','zoom',ev.value)"/></div>
  <section class="studio-model-inspection" data-if="self.modelValid">
    <div class="studio-model-heading"><span class="title">Inspect model</span><button class="btn outline sm" data-event-click="emit('StudioModelInspection',-1,self.modelSectionAxis,self.modelSectionOffset)">Show all</button></div>
    <div class="field text"><input type="text" class="part value" aria-label="Find model part" placeholder="Find a part…" data-attr-value="self.modelPartSearch" data-event-input="emit('StudioModelEvidence','search',ev.value)"/></div>
    <div class="studio-model-parts" role="list" aria-label="Model parts"><button class="btn ghost sm" data-for="part : self.modelVisibleParts" data-attr-aria-pressed="self.modelPart == part.index ? 'true' : 'false'" data-event-click="emit('StudioModelInspection',part.index,self.modelSectionAxis,self.modelSectionOffset)">{{ part.name }}</button></div>
    <div class="studio-model-view" role="group" aria-label="Section plane"><button class="btn outline sm" data-attr-aria-pressed="self.modelSectionAxis == 0" data-event-click="emit('StudioModelInspection',self.modelPart,0,0)">None</button><button class="btn outline sm" data-attr-aria-pressed="self.modelSectionAxis == 1" data-event-click="emit('StudioModelInspection',self.modelPart,1,self.modelSectionOffset)">X</button><button class="btn outline sm" data-attr-aria-pressed="self.modelSectionAxis == 2" data-event-click="emit('StudioModelInspection',self.modelPart,2,self.modelSectionOffset)">Y</button><button class="btn outline sm" data-attr-aria-pressed="self.modelSectionAxis == 3" data-event-click="emit('StudioModelInspection',self.modelPart,3,self.modelSectionOffset)">Z</button></div>
    <use ui="NumberField" float addon="Plane offset" step="0.01" aria-label="Section plane offset" data-if="self.modelSectionAxis &gt; 0" data-attr-value="self.modelSectionOffset" data-event-change="emit('StudioModelInspection',self.modelPart,self.modelSectionAxis,ev.value)"/>
  </section>
  <div class="notice error" role="alert" data-if="self.modelError != ''">{{ self.modelError }}</div>
  <div class="studio-model-defaults" data-if="self.modelValid">
    <div class="studio-model-parameter" data-for="parameter : self.modelParameters"><div class="studio-model-heading"><label>{{ parameter.name }}</label><span class="dim" data-if="!parameter.local">{{ parameter.asset }}</span></div>
      <div class="studio-model-components">
        <use ui="NumberField" float step="0.01" precision="3" data-if="parameter.width &gt; 0" data-attrif-disabled="!parameter.local || self.modelReadonly" data-attr-aria-label="parameter.name + ' X'" data-attr-addon="parameter.width == 1 ? '' : 'X'" data-attr-min="parameter.min_x" data-attr-max="parameter.max_x" data-attr-value="parameter.x" data-event-mousedown="emit('StudioModelArm',self.modelDocument)" data-event-keydown="emit('StudioModelArm',self.modelDocument)" data-event-input="emit('StudioModelParameter',self.modelDocument,parameter.node,0, false)" data-event-change="emit('StudioModelParameter',self.modelDocument,parameter.node,0, true)"/>
        <use ui="NumberField" float step="0.01" precision="3" data-if="parameter.width &gt; 1" data-attrif-disabled="!parameter.local || self.modelReadonly" data-attr-aria-label="parameter.name + ' Y'" data-attr-addon="parameter.width == 1 ? '' : 'Y'" data-attr-min="parameter.min_y" data-attr-max="parameter.max_y" data-attr-value="parameter.y" data-event-mousedown="emit('StudioModelArm',self.modelDocument)" data-event-keydown="emit('StudioModelArm',self.modelDocument)" data-event-input="emit('StudioModelParameter',self.modelDocument,parameter.node,1, false)" data-event-change="emit('StudioModelParameter',self.modelDocument,parameter.node,1, true)"/>
        <use ui="NumberField" float step="0.01" precision="3" data-if="parameter.width &gt; 2" data-attrif-disabled="!parameter.local || self.modelReadonly" data-attr-aria-label="parameter.name + ' Z'" data-attr-addon="parameter.width == 1 ? '' : 'Z'" data-attr-min="parameter.min_z" data-attr-max="parameter.max_z" data-attr-value="parameter.z" data-event-mousedown="emit('StudioModelArm',self.modelDocument)" data-event-keydown="emit('StudioModelArm',self.modelDocument)" data-event-input="emit('StudioModelParameter',self.modelDocument,parameter.node,2, false)" data-event-change="emit('StudioModelParameter',self.modelDocument,parameter.node,2, true)"/>
        <use ui="NumberField" float step="0.01" precision="3" data-if="parameter.width &gt; 3" data-attrif-disabled="!parameter.local || self.modelReadonly" data-attr-aria-label="parameter.name + ' W'" data-attr-addon="parameter.width == 1 ? '' : 'W'" data-attr-min="parameter.min_w" data-attr-max="parameter.max_w" data-attr-value="parameter.w" data-event-mousedown="emit('StudioModelArm',self.modelDocument)" data-event-keydown="emit('StudioModelArm',self.modelDocument)" data-event-input="emit('StudioModelParameter',self.modelDocument,parameter.node,3, false)" data-event-change="emit('StudioModelParameter',self.modelDocument,parameter.node,3, true)"/>
      </div><p class="dim" data-if="!parameter.local">Edit this declaration in its source model.</p>
    </div>
  </div>
  <section class="panel studio-model-diagnostics" data-attrif-data-open="self.modelDiagnostics"><button class="panel-head" data-attr-aria-expanded="self.modelDiagnostics ? 'true' : 'false'" data-event-click="emit('StudioModelView','diagnostics',0)"><span class="icon chev">&#xeab4;</span><span class="title">Diagnostics</span></button>
    <div class="panel-body" data-if="self.modelDiagnostics &amp;&amp; self.modelValid">
      <p class="dim">Static model costs and local bounds. Rendered pixels use the production scene renderer.</p>
      <div class="studio-model-stat"><span>Distance / hit expressions</span><span>{{ self.modelInfo.distance_nodes }} / {{ self.modelInfo.hit_nodes }}</span></div>
      <div class="studio-model-stat"><span>Public / private parameters</span><span>{{ self.modelInfo.public_slots }} / {{ self.modelInfo.private_slots }}</span></div>
      <div class="studio-model-stat"><span>Materials / images</span><span>{{ self.modelInfo.materials }} / {{ self.modelInfo.images }}</span></div>
      <div class="studio-model-stat"><span>Minimum</span><span>{{ self.modelInfo.min_x }}, {{ self.modelInfo.min_y }}, {{ self.modelInfo.min_z }}</span></div>
      <div class="studio-model-stat"><span>Maximum</span><span>{{ self.modelInfo.max_x }}, {{ self.modelInfo.max_y }}, {{ self.modelInfo.max_z }}</span></div>
      <div class="studio-model-part" data-for="part : self.modelParts"><span>{{ part.name }}</span><span class="dim">{{ part.distance_nodes }} expressions</span></div>
      <div class="studio-model-anchor" data-for="anchor : self.modelAnchors"><span>{{ anchor.name }}</span><span class="dim">{{ anchor.x }}, {{ anchor.y }}, {{ anchor.z }} · angles {{ anchor.pitch }}, {{ anchor.yaw }}, {{ anchor.roll }} rad</span></div>
    </div>
  </section>
  <use ui="StudioModelReference"/>
  <section class="studio-model-bake"><div class="studio-model-heading"><span class="title">Bake mesh</span><button class="btn outline sm" data-attrif-disabled="!self.modelValid" data-event-click="emit('StudioModelBake')">Bake</button></div>
    <p class="dim">Create an indexed triangle approximation of the current model. Smaller cells add detail and work.</p>
    <use ui="NumberField" addon="Cell size" min="0.0001" step="0.01" float aria-label="Mesh bake cell size" data-attr-value="self.modelCellSize" data-event-change="emit('StudioModelView','cell',ev.value)"/>
    <use ui="NumberField" addon="Triangle limit" min="1" max="100000" step="1000" aria-label="Mesh bake triangle budget" data-attr-value="self.modelTriangleBudget" data-event-change="emit('StudioModelView','triangles',ev.value)"/>
    <use ui="NumberField" addon="Sample limit" min="1" max="2000000" step="1000" integer aria-label="Mesh bake sample budget" data-attr-value="self.modelSampleBudget" data-event-change="emit('StudioModelBudgets',ev.value,self.modelWorkBudget)"/>
    <use ui="NumberField" addon="Work limit" min="1" max="100000000" step="100000" integer aria-label="Mesh bake node work budget" data-attr-value="self.modelWorkBudget" data-event-change="emit('StudioModelBudgets',self.modelSampleBudget,ev.value)"/>
    <div data-if="self.modelBake &gt; 0"><p>{{ self.modelBakedTriangles }} triangles · {{ self.modelBakedSamples }} samples</p><p class="dim">Cell diagonal {{ self.modelBakedDiagonal }} · maximum residual {{ self.modelBakedResidual }}</p><p class="dim" data-if="!self.modelBakeCurrent">The model changed. Bake again to export the current revision.</p></div>
    <div class="studio-model-view"><div class="field text"><input type="text" class="part value" aria-label="New workspace mesh path" data-attr-value="self.modelDestination" data-event-change="emit('StudioModelDestination',ev.value)"/></div><button class="btn outline sm" data-attrif-disabled="!self.modelBakeCurrent" data-event-click="emit('StudioModelExport')">Export</button></div>
    <div class="studio-model-view"><div class="field text"><input type="text" class="part value" aria-label="New model bundle folder" data-attr-value="self.modelBundleDestination" data-event-change="emit('StudioModelBundle','destination',ev.value)"/></div><button class="btn outline sm" data-attrif-disabled="!self.modelBakeCurrent" data-event-click="emit('StudioModelBundle','export','')">Export bundle</button></div>
    <p class="dim">Bundle contains model.mesh, OBJ/MTL and provenance. OBJ materials are neutral placeholders; procedural appearance is not baked.</p>
    <p class="dim">Save a new .mesh file relative to the workspace.</p><p role="status" data-if="self.modelSaved">Saved {{ self.modelDestination }}</p><div class="notice error" role="alert" data-if="self.modelBakeError != ''">{{ self.modelBakeError }}</div>
  </section>
  <section class="panel studio-model-evidence" data-attrif-data-open="self.modelEvidence"><button class="panel-head" data-event-click="emit('StudioModelEvidence','toggle','')" data-attr-aria-expanded="self.modelEvidence ? 'true' : 'false'"><span class="icon chev">&#xeab4;</span><span class="title">Export evidence</span></button>
    <div class="panel-body" data-if="self.modelEvidence"><p class="dim">Freeze this view, model sources, images and settings in a new workspace folder.</p><div class="field text"><input type="text" class="part value" aria-label="New evidence folder" data-attr-value="self.modelEvidenceDestination" data-event-change="emit('StudioModelEvidence','destination',ev.value)"/></div><button class="btn outline sm" data-attrif-disabled="!self.modelValid || self.modelExportState == 0" data-event-click="emit('StudioModelEvidence','export','')">{{ self.modelExportState == 0 ? 'Exporting…' : 'Export view' }}</button><p role="status" data-if="self.modelExportState == 1">Saved {{ self.modelExportPath }}</p><div class="notice error" role="alert" data-if="self.modelExportError != ''">{{ self.modelExportError }}</div></div>
  </section>
</div>
