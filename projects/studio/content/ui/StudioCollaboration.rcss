.collaboration-panel { display: flex; flex-direction: column; gap: 8dp; padding: 12dp; max-height: 420dp; overflow-y: auto; background: var(--background); color: var(--foreground); border-top: 1dp var(--border); }
.collaboration-head, .collaboration-actions, .collaboration-peers li { display: flex; align-items: center; gap: 8dp; }
.collaboration-panel p { margin: 0; word-break: break-word; }
.collaboration-panel label { display: flex; flex-direction: column; gap: 4dp; margin-bottom: 8dp; }
.collaboration-panel input { width: 100%; }
.collaboration-error { color: var(--destructive); }
.collaboration-peers { padding: 0; max-height: 120dp; overflow-y: auto; }
.collaboration-note { color: var(--muted-foreground); font-size: 12dp; }
