<div class="studio-application" data-keys="Escape:StudioShellClose" data-attr-data-keys="self.studioCommandBindings">
  <header class="topbar" data-event-mouseenter="emit('StudioPaneHover', 'Global')">
    <div class="brand">
      <div class="mark" />
    </div>
