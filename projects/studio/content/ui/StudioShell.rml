        </div>
        <use ui="MenuSeparator" />
        <div class="menu-item" role="menuitem" data-attrif-data-disabled="!self.studioCommandEnabled[self.studioCommandIndex.about]" data-event-click="emit('StudioCommand', 'about', '')">
          <span class="icon lead">{{ self.studioCommands[self.studioCommandIndex.about].icon }}</span>
          <span class="text">
            <span class="label">{{ self.studioCommands[self.studioCommandIndex.about].label }}</span>
          </span>
          <span class="kbd">{{ self.studioCommandShortcuts[self.studioCommandIndex.about] }}</span>
        </div>
      </use>
    </menubar>
    <div class="spacer" />
    <div class="transport">
      <button class="btn subtle target" data-tip="Play target" popovertarget="target-menu" aria-haspopup="menu">
        <span class="icon"></span>
        <span class="label">{{ self.sceneRuntime.targetPreview ? 'Preview' : 'Scene' }} · {{ self.sceneRuntime.targetPreview ? self.sceneRuntime.previewName : self.shellRuntimeName }}</span>
      </button>
      <div class="group">
        <button class="btn icon-only" data-for="command, i : self.studioCommands" data-if="(!self.debugPaused &amp;&amp; (command.id == 'play' || command.id == 'stop' || command.id == 'step')) || (self.debugPaused &amp;&amp; (command.id == 'play' || command.id == 'stop' || command.id == 'stepOver' || command.id == 'stepInto' || command.id == 'stepOut'))" data-attr-data-tip="command.label" data-attr-data-kbd="self.studioCommandShortcuts[i]" data-attrif-disabled="!self.studioCommandEnabled[i]" data-attr-data-state="command.id == 'play' &amp;&amp; self.sceneRuntime.playing ? 'on' : 'off'" data-event-click="emit('StudioCommand', command.id, '')">
          <span class="icon">{{ command.icon }}</span>
        </button>
      </div>
      <div id="speed">
        <button class="btn subtle speed" popovertarget="speed-menu" data-tip="Playback Speed" data-attr-data-state="self.sceneInput.speed != 1 ? 'on' : 'off'">
          <span class="label">{{ self.sceneInput.speed }}×</span>
        </button>
        <use ui="StudioMenu" id="speed-menu">
          <div class="menu-item" role="menuitem" data-attrif-data-disabled="!self.studioCommandEnabled[self.studioCommandIndex.slower]" data-event-click="emit('StudioCommand', 'slower', '')">
            <span class="text">{{ self.studioCommands[self.studioCommandIndex.slower].label }}</span>
          </div>
          <div class="menu-item" role="menuitem" data-attrif-data-disabled="!self.studioCommandEnabled[self.studioCommandIndex.faster]" data-event-click="emit('StudioCommand', 'faster', '')">
            <span class="text">{{ self.studioCommands[self.studioCommandIndex.faster].label }}</span>
          </div>
          <div class="menu-item" role="menuitem" data-attrif-data-disabled="!self.studioCommandEnabled[self.studioCommandIndex.normalSpeed]" data-event-click="emit('StudioCommand', 'normalSpeed', '')">
            <span class="text">{{ self.studioCommands[self.studioCommandIndex.normalSpeed].label }}</span>
          </div>
          <use ui="MenuSeparator" />
          <div class="menu-item" role="menuitem" data-for="speed : self.shellSpeedPresets" data-attrif-data-disabled="!self.sceneRuntime.ready" data-attrif-data-checked="speed == self.sceneInput.speed" data-event-click="emit('StudioSceneSpeed', speed)">
            <span class="icon lead" data-if="speed == self.sceneInput.speed"></span>
            <span class="text">{{ speed }}×</span>
          </div>
        </use>
      </div>
      <use ui="StudioMenu" id="target-menu">
        <div class="menu-item" role="menuitem" data-attrif-data-disabled="self.sceneRuntime.playing || self.sceneRuntime.preparing || self.sceneRuntime.steps &gt; 0" data-event-click="emit('StudioSceneCommand', 'playTarget', 'scene')">
          <span class="text">Scene</span>
        </div>
        <div class="menu-item" role="menuitem" data-attrif-data-disabled="self.sceneRuntime.playing || self.sceneRuntime.preparing || self.sceneRuntime.steps &gt; 0 || !self.sceneRuntime.previewAvailable" data-event-click="emit('StudioSceneCommand', 'playTarget', 'preview')">
          <span class="text">Preview</span>
        </div>
      </use>
    </div>
    <div class="spacer" />
    <button class="btn icon-only collaboration-trigger" data-tip="Collaboration" data-attr-data-state="self.collaborationActive ? 'on' : 'off'" data-event-click="emit('StudioCommand', 'collaboration', '')">
      <span class="icon">󰘬</span>
    </button>
    <div class="sep" />
    <div id="layout">
      <button class="btn icon-only" popovertarget="layout-menu" aria-haspopup="menu" data-tip="Layout">
        <span class="icon"></span>
      </button>
      <use ui="StudioMenu" id="layout-menu">
        <div class="menu-item" role="menuitem" data-for="command, i : self.studioCommands" data-if="command.id == 'workspaceHorizontalSplit' || command.id == 'workspaceVerticalSplit' || command.id == 'maximize' || command.id == 'resetLayout'" data-event-click="emit('StudioCommand', command.id, '')">
          <span class="icon lead">{{ command.icon }}</span>
          <span class="text">
            <span class="label">{{ command.label }}</span>
          </span>
        </div>
      </use>
    </div>
    <button class="btn icon-only side-pane" data-tip="Side Pane" data-attr-data-state="self.shellSideOpen ? 'on' : 'off'" data-event-click="emit('StudioCommand', 'toggleSidePane', '')">
      <span class="icon"></span>
    </button>
    <button class="btn icon-only" data-tip="Settings" data-event-click="emit('StudioCommand', 'settings', '')">
      <span class="icon"></span>
    </button>
    <button class="btn search-trigger" data-tip="Search" data-kbd="Mod+K" data-event-click="emit('StudioCommand', 'search', '')">
      <span class="icon"></span>
      <span class="label">Search</span>
      <span class="kbd">Mod+K</span>
    </button>
  </header>
  <div class="studio-conflict" role="alert" data-if="self.shellConflict">This file changed on disk. Review the changes before saving.</div>
  <main class="studio-workspace-host">
    <slot />
  </main>
  <footer class="statusbar" data-class-live="self.sceneRuntime.playing" data-event-mouseenter="emit('StudioPaneHover', 'Global')">
    <div class="hints">
      <div class="hint-group" data-if="self.shellHoverContext == 'properties' || self.shellHoverContext == 'visual'">
        <span class="icon">󰍽</span>
        <span class="label">Drag to scrub</span>
        <span class="kbd-key">Alt</span>
        <span class="label">Fine</span>
        <span class="kbd-key">Shift</span>
        <span class="label">Coarse</span>
        <span class="kbd-key">Ctrl</span>
        <span class="label">Snap</span>
      </div>
      <div class="hint-group" data-if="self.shellHoverContext == 'outliner'">
        <span class="icon">󰍽</span>
        <span class="label">Select</span>
        <span class="icon">󰍽</span>
        <span class="kbd-key">Mod</span>
        <span class="label">Toggle</span>
        <span class="icon">󰍽</span>
        <span class="kbd-key">Shift</span>
        <span class="label">Range</span>
        <span class="kbd-key">{{ self.studioCommandShortcuts[self.studioCommandIndex.frame] }}</span>
        <span class="label">Frame</span>
        <span class="kbd-key">{{ self.studioCommandShortcuts[self.studioCommandIndex.rename] }}</span>
        <span class="label">Rename</span>
      </div>
      <div class="hint-group" data-if="self.shellHoverContext == 'graph' &amp;&amp; !self.graph.readonly">
        <span class="icon">󰍽</span>
        <span class="label">Select</span>
        <span class="kbd-key">Shift+A</span>
        <span class="label">Add</span>
        <span class="kbd-key">Q</span>
        <span class="label">Straighten</span>
      </div>
      <div class="hint-group" data-if="self.shellHoverContext == 'graph' &amp;&amp; self.graph.readonly">
        <span class="icon">󰍽</span>
        <span class="label">Select</span>
        <span class="kbd-key">F</span>
        <span class="label">Frame</span>
      </div>
      <div class="hint-group" data-if="self.shellHoverContext == 'scene' &amp;&amp; !self.sceneRuntime.perspective">
        <span class="icon">󰍽</span>
        <span class="label">{{ self.sceneRuntime.tool == 'move' ? 'Drag arrows' : self.sceneRuntime.tool == 'rotate' ? 'Drag ring' : self.sceneRuntime.tool == 'scale' ? 'Drag handles' : 'Select' }}</span>
        <span class="icon">󰍽</span>
        <span class="kbd-key">Shift</span>
        <span class="label">Toggle</span>
        <span class="kbd-key">{{ self.studioCommandShortcuts[self.studioCommandIndex.grab] }}</span>
        <span class="label">Grab</span>
        <span class="kbd-key">Ctrl</span>
        <span class="label">{{ self.sceneRuntime.snap ? 'Free' : 'Snap' }}</span>
        <span class="kbd-key">{{ self.studioCommandShortcuts[self.studioCommandIndex.frame] }}</span>
        <span class="label">Frame</span>
        <span class="kbd-key">{{ self.studioCommandShortcuts[self.studioCommandIndex.hideSelected] }}</span>
        <span class="label">Hide</span>
      </div>
      <div class="hint-group" data-if="self.shellHoverContext == 'scene' &amp;&amp; self.sceneRuntime.perspective">
        <span class="icon">󰍽</span>
        <span class="label">{{ self.sceneRuntime.tool == 'move' ? 'Drag arrows' : self.sceneRuntime.tool == 'rotate' ? 'Drag rings' : self.sceneRuntime.tool == 'scale' ? 'Drag handles' : 'Select' }}</span>
        <span class="icon">󰍽</span>
        <span class="kbd-key">Alt</span>
        <span class="label">Orbit</span>
        <span class="icon">󰍽</span>
        <span class="label">Right-drag to fly</span>
        <span class="icon">󰍽</span>
        <span class="kbd-key">Shift</span>
        <span class="label">Toggle</span>
        <span class="kbd-key">{{ self.studioCommandShortcuts[self.studioCommandIndex.frame] }}</span>
        <span class="label">Frame</span>
      </div>
      <div class="hint-group" data-if="self.shellHoverContext != 'scene' &amp;&amp; self.shellHoverContext != 'graph' &amp;&amp; self.shellHoverContext != 'outliner' &amp;&amp; self.shellHoverContext != 'properties' &amp;&amp; self.shellHoverContext != 'visual'">
        <span class="kbd-key">{{ self.studioCommandShortcuts[self.studioCommandIndex.search] }}</span>
        <span class="label">Search</span>
        <span class="kbd-key">{{ self.studioCommandShortcuts[self.studioCommandIndex.keyboardShortcuts] }}</span>
        <span class="label">Shortcuts</span>
      </div>
    </div>
    <div class="report-area">
      <div class="report" data-if="self.shellReporting" data-class-warning="self.shellMessageKind == 'warning' || self.shellMessageKind == 'error'" presence="">
        <span class="icon"></span>
        <morph-text>{{ self.shellMessage }}</morph-text>
      </div>
    </div>
    <div class="drawers">
      <button class="btn sm toggle-drawer" data-attr-data-state="self.shellDrawerOpen &amp;&amp; self.shellDrawer == 'assets' ? 'on' : 'off'" data-event-click="emit('StudioCommand', 'toggleAssets', '')">
        <span class="icon"></span>
        <span class="label">Assets</span>
      </button>
      <button class="btn sm toggle-drawer" data-attr-data-state="self.shellDrawerOpen &amp;&amp; self.shellDrawer == 'output' ? 'on' : 'off'" data-event-click="emit('StudioCommand', 'toggleOutput', '')">
        <span class="icon"></span>
        <span class="label">Output</span>
      </button>
      <button class="btn sm toggle-drawer" data-attr-data-state="self.shellDrawerOpen &amp;&amp; self.shellDrawer == 'performance' ? 'on' : 'off'" data-event-click="emit('StudioCommand', 'togglePerformance', '')">
        <span class="icon">󰓅</span>
        <span class="label">Performance</span>
      </button>
    </div>
    <div class="stats">
      <span class="strong">{{ self.shellRuntimeName }}</span>
      <span data-class-strong="self.outliner.selectedName != ''">{{ self.outliner.selectedName != '' ? self.outliner.selectedName : 'No selection' }}</span>
      <span class="count objects">Objects <number-flow data-attr-value="self.outliner.selectionCount" />/<number-flow data-attr-value="self.outliner.total" />
      </span>
      <span class="count speed strong" data-if="self.sceneInput.speed != 1" data-event-click="emit('StudioCommand', 'normalSpeed', '')">{{ self.sceneInput.speed }}×</span>
      <span class="count hidden-objects" data-if="self.outliner.hiddenCount &gt; 0" data-tip="Show All" data-event-click="emit('StudioCommand', 'showAll', '')">
        <number-flow data-attr-value="self.outliner.hiddenCount" /> hidden</span>
    </div>
    <div id="ui-scale">
      <button class="btn sm ui-scale" popovertarget="scale-menu" data-tip="UI Scale">{{ self.shellScale }}</button>
      <use ui="StudioMenu" id="scale-menu">
        <div class="menu-item" data-for="command, i : self.studioCommands" data-if="command.id == 'zoomIn' || command.id == 'zoomOut' || command.id == 'zoomReset'" data-event-click="emit('StudioCommand', command.id, '')">
          <span class="text">{{ command.label }}</span>
          <span class="kbd">{{ self.studioCommandShortcuts[i] }}</span>
        </div>
        <use ui="MenuSeparator" />
        <div class="menu-item" role="menuitem" data-for="scale : self.shellScalePresets" data-event-click="emit('StudioPreferenceNumber', 'uiScale', scale)">
          <span class="text">{{ scale * 100 }}%</span>
        </div>
      </use>
    </div>
  </footer>
  <div data-when="self.projectNewOpen">
    <use ui="NewProject" />
  </div>
  <div data-if="self.platformVisible">
    <use ui="StudioPlatform" />
  </div>
  <div data-if="self.shellSettingsOpen">
    <use ui="StudioPreferences" />
  </div>
  <div data-when="self.shellPaletteOpen">
    <use ui="StudioCommands" />
  </div>
  <div data-if="self.shellAboutOpen">
    <use ui="Dialog">
      <div class="studio-about" role="dialog" aria-modal="true" aria-label="About Chibi Studio">
        <h2>Chibi Studio</h2>
        <p>Build games with authored scenes, components, materials and behaviors.</p>
        <button class="btn" data-event-click="emit('StudioShellClose')">Close</button>
      </div>
    </use>
  </div>
</div>
