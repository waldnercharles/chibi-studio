<body data-class-dark="(save.theme == 'system' &amp;&amp; system.dark) || (save.theme != 'system' &amp;&amp; save.theme != 'light' &amp;&amp; save.theme != 'solarized-light' &amp;&amp; save.theme != 'tokyo-day' &amp;&amp; save.theme != 'catppuccin-latte' &amp;&amp; save.theme != 'rose-pine-dawn' &amp;&amp; save.theme != 'gruvbox-light')"
      data-class-comfortable="save.density == 'comfortable'"
      data-class-theme-dracula="save.theme == 'dracula'"
      data-class-theme-solarized-light="save.theme == 'solarized-light'"
      data-class-theme-solarized-dark="save.theme == 'solarized-dark'"
      data-class-theme-tokyo-night="save.theme == 'tokyo-night'"
      data-class-theme-tokyo-storm="save.theme == 'tokyo-storm'"
      data-class-theme-tokyo-day="save.theme == 'tokyo-day'"
      data-class-theme-catppuccin-latte="save.theme == 'catppuccin-latte'"
      data-class-theme-catppuccin-frappe="save.theme == 'catppuccin-frappe'"
      data-class-theme-catppuccin-macchiato="save.theme == 'catppuccin-macchiato'"
      data-class-theme-catppuccin-mocha="save.theme == 'catppuccin-mocha'"
      data-class-theme-rose-pine="save.theme == 'rose-pine'"
      data-class-theme-rose-pine-moon="save.theme == 'rose-pine-moon'"
      data-class-theme-rose-pine-dawn="save.theme == 'rose-pine-dawn'"
      data-class-theme-gruvbox-light="save.theme == 'gruvbox-light'"
      data-class-theme-gruvbox-dark="save.theme == 'gruvbox-dark'"><slot/></body>
