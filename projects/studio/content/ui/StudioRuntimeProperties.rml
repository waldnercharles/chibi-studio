<div class="runtime-properties properties" data-event-focusin="emit('StudioRuntimePropertiesFocus', true)" data-event-focusout="emit('StudioRuntimePropertiesFocus', false)">
  <nav class="prop-tabs"><div class="tab" data-for="category : self.runtimeProperties.categories"><button class="btn icon-only" data-attr-data-state="self.runtimeProperties.category == category ? 'on' : 'off'" data-attr-data-tip="category == 'object' ? 'Object' : category == 'physics' ? 'Physics' : category == 'material' ? 'Material' : 'Gameplay'" data-tip-side="right" data-event-click="emit('StudioRuntimePropertiesCategory', category)"><span class="icon">{{ category == 'object' ? '󰆧' : category == 'physics' ? '󰹻' : category == 'material' ? '󰏘' : '󰓥' }}</span></button></div></nav>
  <div class="prop-scroll">
  <div class="identity" data-if="self.runtimeProperties.category == 'object'"><div class="glyph"><span class="icon">&#xf01a7;</span></div><div class="who"><span class="title">{{ self.runtimeProperties.name }}</span><div class="lineage" data-if="self.runtimeProperties.originKnown &amp;&amp; self.runtimeProperties.prototype != ''"><span>{{ self.runtimeProperties.spawned ? 'Spawned from' : 'Instance of' }}</span><span>{{ self.runtimeProperties.prototype }}</span></div></div></div>
  <span class="prop-note" data-if="self.runtimeProperties.room">Runtime edits are unavailable during collaboration.</span>
  <div class="runtime-properties-error" role="alert" data-if="self.runtimeProperties.error != ''">{{ self.runtimeProperties.error }}</div>
  <p class="runtime-properties-notice" data-if="self.runtimeProperties.filter != '' &amp;&amp; self.runtimeProperties.slots.size == 0">No matching fields on this page.</p>
  <section class="panel" data-for="group : self.runtimeProperties.panelSlots" data-alias-panel="self.runtimeProperties.panels[group]" data-attrif-data-open="panel.open">
    <div class="panel-head"><div class="panel-fold" data-event-click="emit('StudioRuntimePropertiesFold', self.runtimeProperties.session, self.runtimeProperties.subject, panel.component)"><span class="icon chev">&#xeab4;</span><span class="title">{{ panel.title }}</span><span class="badge override" data-if="panel.computed">Computed</span><span class="spacer"/></div><button class="btn icon-only" aria-label="Keep component changes" data-attr-data-tip="'Keep ' + panel.title + ' changes when you stop'" data-if="panel.keepable &amp;&amp; self.runtimeProperties.originKnown &amp;&amp; self.runtimeProperties.authored &amp;&amp; !self.runtimeProperties.spawned" data-attrif-disabled="!self.runtimeProperties.canKeepChanges || !self.sceneRuntime.canKeepChanges || self.sceneRuntime.keepApplying" data-event-click="emit('StudioRuntimePropertiesKeep', self.runtimeProperties.session, self.runtimeProperties.subject, panel.component); stop()"><span class="icon">&#xf0931;</span></button></div>
    <div class="panel-body" data-if="panel.open">
  <div class="runtime-property" data-for="index : self.runtimeProperties.slots" data-if="self.runtimeProperties.rows[index].component == panel.component">
    <div class="prop runtime-property-fields">
    <label class="label">{{ self.runtimeProperties.rows[index].label }}</label>
    <div class="control">
    <use ui="NumberField" data-if="self.runtimeProperties.rows[index].kind == 'number'" data-attr-aria-label="self.runtimeProperties.rows[index].label" data-attr-value="self.runtimeProperties.rows[index].number" data-attr-min="self.runtimeProperties.rows[index].bounded ? self.runtimeProperties.rows[index].min : ''" data-attr-max="self.runtimeProperties.rows[index].bounded ? self.runtimeProperties.rows[index].max : ''" data-attr-unit="self.runtimeProperties.rows[index].unit" data-attrif-readonly="!self.runtimeProperties.rows[index].writable || self.runtimeProperties.readOnly" data-event-change="emit('StudioRuntimePropertiesEdit', self.runtimeProperties.session, self.runtimeProperties.subject, self.runtimeProperties.rows[index].component, self.runtimeProperties.rows[index].field, ev.value + '')"/>
    <use ui="Checkbox" data-if="self.runtimeProperties.rows[index].kind == 'bool'" data-attr-aria-label="self.runtimeProperties.rows[index].label" data-attrif-checked="self.runtimeProperties.rows[index].boolean" data-attrif-disabled="!self.runtimeProperties.rows[index].writable || self.runtimeProperties.readOnly" data-event-change="emit('StudioRuntimePropertiesEdit', self.runtimeProperties.session, self.runtimeProperties.subject, self.runtimeProperties.rows[index].component, self.runtimeProperties.rows[index].field, ev.value ? 'true' : 'false')"/>
    <use ui="ColorField" data-if="self.runtimeProperties.rows[index].color" data-attr-aria-label="self.runtimeProperties.rows[index].label" data-attr-value="self.runtimeProperties.colors[index]" data-attrif-disabled="!self.runtimeProperties.rows[index].writable || self.runtimeProperties.readOnly" data-event-change="emit('StudioRuntimePropertiesColor', self.runtimeProperties.session, self.runtimeProperties.subject, self.runtimeProperties.rows[index].component, self.runtimeProperties.rows[index].field, ev.value, ev.canceled)"/>
    <input class="field text" data-if="!self.runtimeProperties.rows[index].color &amp;&amp; (self.runtimeProperties.rows[index].kind == 'integer' || self.runtimeProperties.rows[index].kind == 'handle' || self.runtimeProperties.rows[index].kind == 'string')" data-attr-aria-label="self.runtimeProperties.rows[index].label" data-attr-value="self.runtimeProperties.rows[index].kind == 'string' ? self.runtimeProperties.rows[index].text : self.runtimeProperties.rows[index].json" data-attrif-readonly="!self.runtimeProperties.rows[index].writable || self.runtimeProperties.readOnly" data-event-change="emit('StudioRuntimePropertiesEdit', self.runtimeProperties.session, self.runtimeProperties.subject, self.runtimeProperties.rows[index].component, self.runtimeProperties.rows[index].field, ev.value)"/>
    <use ui="Select" data-if="self.runtimeProperties.rows[index].kind == 'enum' &amp;&amp; self.runtimeProperties.rows[index].writable"><select data-attr-aria-label="self.runtimeProperties.rows[index].label" data-attr-value="self.runtimeProperties.rows[index].json" data-attrif-disabled="!self.runtimeProperties.rows[index].writable || self.runtimeProperties.readOnly" data-event-change="emit('StudioRuntimePropertiesEdit', self.runtimeProperties.session, self.runtimeProperties.subject, self.runtimeProperties.rows[index].component, self.runtimeProperties.rows[index].field, ev.value)"><option data-for="choice : self.runtimeProperties.choices" data-if="choice.component == self.runtimeProperties.rows[index].component &amp;&amp; choice.field == self.runtimeProperties.rows[index].field" data-attr-value="choice.json">{{ choice.label }}</option></select></use>
    <span class="runtime-property-readonly" data-if="self.runtimeProperties.rows[index].kind == 'enum' &amp;&amp; !self.runtimeProperties.rows[index].writable">{{ self.runtimeProperties.rows[index].text }}</span>
    <span class="runtime-property-readonly" data-if="self.runtimeProperties.rows[index].kind == 'unsupported'">{{ self.runtimeProperties.rows[index].text != '' ? self.runtimeProperties.rows[index].text : 'This value cannot be edited safely.' }}</span>
    <span class="runtime-property-readonly" data-if="!self.runtimeProperties.rows[index].writable &amp;&amp; self.runtimeProperties.rows[index].kind != 'unsupported'">Read only</span>
    <button class="btn subtle" data-if="self.runtimeProperties.rows[index].target != ''" data-event-click="emit('StudioRuntimePropertiesReveal', self.runtimeProperties.session, self.runtimeProperties.subject, self.runtimeProperties.rows[index].component, self.runtimeProperties.rows[index].field)">Reveal target</button>
    </div>
    </div>
  </div>
    </div>
  </section>
  <div class="runtime-properties-pages" data-if="self.runtimeProperties.previous || self.runtimeProperties.next"><button class="btn subtle" data-attrif-data-disabled="!self.runtimeProperties.previous" data-event-click="emit('StudioRuntimePropertiesPage', -1)">Previous</button><span>{{ self.runtimeProperties.total }} fields</span><button class="btn subtle" data-attrif-data-disabled="!self.runtimeProperties.next" data-event-click="emit('StudioRuntimePropertiesPage', 1)">Next</button></div>
  </div>
</div>
