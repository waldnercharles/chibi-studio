@import "StudioPropertyLayout.rcss";
.runtime-properties { position: relative; width: 100%; height: 100%; min-width: 0dp; min-height: 0dp; }
.runtime-property-fields .control > .field, .runtime-property-fields .control > [data-ui=NumberField] { flex: 1 1 0dp; min-width: 0dp; }
.runtime-properties-error { color: var(--destructive); padding: 6dp 0dp; }
.runtime-property-readonly { color: var(--muted-foreground); }
.runtime-properties-pages { display: flex; justify-content: space-between; align-items: center; margin-top: 12dp; color: var(--muted-foreground); }
