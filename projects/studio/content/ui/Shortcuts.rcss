/* Keyboard Shortcuts: a search over every key Studio takes, an area per
   group in two columns (studio_keymap.c's `shortcuts`). */
.shortcuts { display: flex; flex-direction: column; flex: 1 1 auto; }
.head {
  display: flex; align-items: center; gap: 12dp; flex: 0 0 auto; height: var(--panel-h); padding: 0dp 12dp 0dp 16dp;
  border-bottom: 1dp var(--line);
}
.head-side { display: flex; align-items: center; gap: 8dp; flex: 1 1 0dp; }
.head-side.end { justify-content: flex-end; }
.head-title { font-size: var(--studio-font-13, 13dp); font-weight: 600; color: var(--foreground); }
.search { position: relative; display: flex; flex: 0 0 auto; width: 320dp; }
.search .lead {
  position: absolute; left: 7dp; top: 0dp; height: var(--h); line-height: var(--h); font-size: var(--studio-font-13, 13dp);
  color: var(--faint-foreground); pointer-events: none;
}
.search-input {
  display: block; flex: 1 1 auto; height: var(--h); padding: var(--input-pad) 24dp var(--input-pad) 27dp;
  line-height: var(--input-line); color: var(--foreground); cursor: text;
  background-color: var(--field-edit); border: 1dp var(--border); border-radius: var(--r);
}
.search-input:hover { background-color: var(--input-hover); }
.search-input:focus { border-color: var(--ring); }
.search-input:placeholder-shown { color: var(--faint-foreground); }
.search-input selection { background-color: var(--primary); color: var(--primary-foreground); }
.search .clear {
  position: absolute; right: 3dp; top: 50%; width: 16dp; height: 16dp; line-height: 16dp;
  text-align: center; border-radius: 3dp; cursor: pointer; transform: translateY(-50%);
}
.search .clear .icon { font-size: 12dp; width: 16dp; line-height: 16dp; }
.search .clear:hover { background-color: var(--press); }
.sheet {
  display: flex; flex-wrap: wrap; align-content: flex-start; flex: 1 1 0dp; overflow-y: auto;
  padding: 8dp 12dp 16dp 12dp;
}
.section { box-sizing: border-box; width: 50%; padding: 8dp 12dp; }
.heading {
  margin-bottom: 4dp; padding-bottom: 4dp; font-size: var(--studio-font-12, 12dp); line-height: var(--studio-line-18, 18dp);
  font-weight: 600; color: var(--muted-foreground); border-bottom: 1dp var(--line);
}
.binding { display: flex; align-items: center; gap: 12dp; min-height: var(--row); }
.action { flex: 1 1 auto; color: var(--foreground); line-height: var(--studio-line-18, 18dp); }
.chords { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 4dp; flex: 0 0 auto; max-width: 60%; }
.chord {
  min-width: 20dp; height: var(--studio-height-20, 20dp); line-height: var(--studio-line-19, 19dp); padding: 0dp 6dp; text-align: center; font-size: var(--studio-font-11, 11dp);
  color: var(--foreground); background-color: var(--secondary); border-radius: 4dp;
  border-bottom: 1dp color-mix(in srgb, var(--foreground) 14%, transparent); font-family: "JetBrains Mono";
}
.empty { display: flex; flex-direction: column; align-items: center; gap: 6dp; width: 100%; padding: 56dp 0dp; }
.empty-icon { font-size: var(--studio-font-28, 28dp); line-height: var(--studio-line-32, 32dp); width: var(--studio-height-32, 32dp); color: var(--disabled-foreground); }
.empty-title { font-size: var(--studio-font-13, 13dp); font-weight: 600; color: var(--foreground); }
.empty-hint { color: var(--muted-foreground); }
.foot {
  display: flex; align-items: center; justify-content: space-between; flex: 0 0 auto; height: var(--panel-h);
  padding: 0dp 12dp 0dp 16dp; border-top: 1dp var(--line);
}
.foot .hint { color: var(--muted-foreground); }

/* One column where two would cramp the actions. */
@media (max-width: 900dp) {
  .section { width: 100%; }
  .search { width: 220dp; }
}
