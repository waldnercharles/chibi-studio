<div class="gallery">
  <div class="menu-group">Menu</div>
  <div class="sample">
    <button class="btn" popovertarget="gallery-menu" aria-haspopup="menu"><span class="label">Edit</span></button>
    <use ui="Menu" id="gallery-menu">
      <use ui="MenuCommand" data-alias-command="self.galleryCommands.undo" data-event-click="emit('StudioGalleryCommand', 'undo', '', pane)"/>
      <use ui="MenuCommand" data-alias-command="self.galleryCommands.redo" data-event-click="emit('StudioGalleryCommand', 'redo', '', pane)"/>
      <use ui="MenuSeparator"/>
      <use ui="MenuCheck" data-checked="save.galleryChecked">Snap to grid</use>
      <use ui="MenuSeparator"/>
      <use ui="Submenu" data-alias-item="self.galleryChoices.panels">
        <use ui="MenuItem" data-for="name, i : self.galleryPanels" data-alias-item="self.galleryPanelItems[i]" data-event-click="emit('StudioGalleryCommand', 'panel', name, pane)"/>
      </use>
    </use>
  </div>
  <div class="menu-group">EnumField</div>
  <div class="sample"><use ui="EnumField" data-alias-table="self.galleryChoices.fields.Body.type" data-alias-value="save.galleryBody" data-event-change="save.galleryBody = ev.value * 1"/></div>
  <div class="menu-group">AssetField</div>
  <div class="sample"><use ui="AssetField" data-alias-table="self.galleryChoices.assets.prototype" data-alias-value="save.galleryAsset" data-event-click="emit('StudioGalleryCommand', 'assets', '', pane)" data-event-change="save.galleryAsset = ev.value"/></div>
  <use ui="StudioMenu" id="gallery-prototypes">
    <use ui="ChoiceList" data-event-input="emit('StudioGalleryPrototypeQuery', ev.value)" data-event-change="emit('StudioGalleryCommand', 'pick', ev.value, pane)">
      <div class="menu-item" role="option" value="" data-label="None"><span class="text">None</span></div>
      <div class="menu-item" role="option" data-for="prototype : self.galleryPrototypes" data-attr-value="prototype.Name" data-attr-data-label="prototype.Name"><span class="icon lead">&#xf01a7;</span><span class="text">{{ prototype.Name }}</span></div>
    </use>
    <div class="collection-notice" data-if="self.galleryPrototypeError != ''" role="status">{{ self.galleryPrototypeError }}</div>
    <div class="collection-history sample"><button class="btn subtle" data-attrif-disabled="self.galleryPrototypeFirst == 0" data-event-click="emit('StudioGalleryCommand', 'previous', '', pane)">Previous</button><button class="btn subtle" data-attrif-disabled="self.galleryPrototypeFirst + 64 &gt;= self.galleryPrototypeTotal" data-event-click="emit('StudioGalleryCommand', 'next', '', pane)">Next</button></div>
  </use>
  <div class="menu-group">MenuOption</div>
  <use ui="MenuOption" value="first">First</use>
  <use ui="MenuOption" value="second">Second</use>
  <div class="menu-sep"/>
  <div class="menu-group">MenuCheck</div>
  <use ui="MenuCheck">Check</use>
  <div class="menu-sep"/>
  <div class="menu-group">Switch</div>
  <div class="sample"><use ui="Switch"/><use ui="Switch" checked=""/></div>
  <div class="menu-group">Segmented</div>
  <div class="sample">
    <use ui="Segmented">
      <label><input type="radio" name="size" value="small"/><span class="face">Small</span></label>
      <label><input type="radio" name="size" value="medium" checked=""/><span class="face">Medium</span></label>
      <label><input type="radio" name="size" value="large"/><span class="face">Large</span></label>
    </use>
  </div>
  <div class="menu-group">Select</div>
  <div class="sample">
    <use ui="Select">
      <select>
        <option value="low">Low</option>
        <option value="high" selected="">High</option>
        <option value="ultra">Ultra</option>
      </select>
    </use>
  </div>
  <div class="menu-group">Slider</div>
  <div class="sample"><use ui="Slider" min="0" max="10" step="1" value="4"/></div>
  <div class="menu-group">NumberField</div>
  <div class="sample">
    <use ui="NumberField" step="0.5" precision="2" unit="m" data-attr-value="save.galleryNumber == '' ? 12.5 : save.galleryNumber" data-event-change="save.galleryNumber = ev.value"/>
    <use ui="NumberField" min="0" max="1" step="0.05" precision="2" slider="" data-attr-value="save.galleryRatio == '' ? 0.4 : save.galleryRatio" data-event-input="save.galleryRatio = ev.value"/>
  </div>
  <div class="menu-group">ColorField</div>
  <div class="sample">
    <use ui="ColorField" data-attr-value="save.galleryColor == '' ? '#3b82f6ff' : save.galleryColor" data-event-input="save.galleryColor = ev.value"/>
  </div>
  <div class="menu-group">Checkbox</div>
  <div class="sample"><use ui="Checkbox" data-checked="save.galleryChecked">Snap to grid</use></div>
  <div class="menu-group">Splitter</div>
  <div class="sample split-sample">
    <span class="split-pane" data-style-width="(save.gallerySplit == '' ? 90 : save.gallerySplit) + 'dp'"/>
    <use ui="Splitter" axis="x" min="40" max="180" data-attr-value="save.gallerySplit == '' ? 90 : save.gallerySplit" data-event-input="save.gallerySplit = ev.value"/>
    <span class="split-pane rest"/>
  </div>
  <div class="menu-group">SidebarNav</div>
  <use ui="SidebarNav">
    <label class="nav-item"><input type="radio" name="page" value="audio" checked=""/><span class="nav-face"><span class="icon">&#xf03d8;</span><span class="label">Display</span></span></label>
    <label class="nav-item"><input type="radio" name="page" value="video"/><span class="nav-face"><span class="icon">&#xf097b;</span><span class="label">Controls</span><span class="dot"/></span></label>
    <label class="nav-item"><input type="radio" name="page" value="game"/><span class="nav-face"><span class="icon">&#xf0297;</span><span class="label">Gameplay</span><span class="count">3</span></span></label>
  </use>
  <div class="menu-group">NumberFlow</div>
  <div class="sample">
    <use ui="Slider" min="0" max="2000" step="125" data-value="save.galleryCount"/>
    <number-flow data-attr-value="save.galleryCount == '' ? 0 : save.galleryCount" grouping=""/>
  </div>
  <div class="menu-group">MorphText</div>
  <div class="sample">
    <use ui="Segmented">
      <label><input type="radio" data-checked="save.galleryWord" value="Play"/><span class="face">Play</span></label>
      <label><input type="radio" data-checked="save.galleryWord" value="Pause"/><span class="face">Pause</span></label>
      <label><input type="radio" data-checked="save.galleryWord" value="Stop"/><span class="face">Stop</span></label>
    </use>
    <morph-text>{{ save.galleryWord == '' ? 'Play' : save.galleryWord }}</morph-text>
  </div>
  <div class="menu-group">VirtualList</div>
  <div class="sample list-sample">
    <use ui="VirtualList" id="list">
      <div class="list-row" data-for="row, i : self.rows">Row {{ self.first + i + 1 }} of {{ self.total }}</div>
    </use>
  </div>
  <div class="menu-group">Project resources</div>
  <div class="sample"><input class="field text" aria-label="Filter collection resources" placeholder="Filter resources" data-attr-value="self.assetCollection.filter" data-event-input="emit('CollectionFilterTyped', ev.value)"/></div>
  <div class="sample assets-sample">
    <use ui="List" id="gallery-assets" data-measure="" data-event-scroll="emit('CollectionViewportChanged')" data-style---collection-height="self.assetCollection.availableHeight + 'dp'">
      <div class="collection-window" data-style-top="self.assetCollection.availableTop + 'dp'">
        <use ui="TreeRow" data-for="slot : self.assetCollection.availableSlots" data-alias-row="self.assetCollection.availableItems[slot]" data-alias-item="row" data-attr-data-drag="row.drag" data-attr-data-drag-payload="row.key" data-attr-data-drag-icon="row.icon" data-attr-data-tip-about="row.path"/>
      </div>
    </use>
    <div class="bin-empty" data-if="self.assetCollection.availableEmpty">No matching resources</div>
  </div>
  <div class="menu-group">Collected resources · {{ self.assetCollection.count }}</div>
  <div class="sample collection-history">
    <button class="btn subtle" data-attrif-data-disabled="!self.assetCollection.canUndo" data-event-click="emit('CollectionUndo')">Undo last change</button>
    <button class="btn subtle" data-attrif-data-disabled="!self.assetCollection.canRedo" data-event-click="emit('CollectionRedo')">Redo</button>
  </div>
  <div class="bin" data-drop="scene prototype behavior event material shape field system library shader-library model ui image mesh sound font" data-drop-hint="Collect" data-event-drop="emit('CollectionDrop', ev.type, ev.payload, '', ev.zone)">
    <div class="bin-empty" data-if="self.assetCollection.count == 0">Drag resources here to collect them.</div>
    <div class="collection-row" data-for="slot : self.assetCollection.slots" data-alias-row="self.assetCollection.items[slot]" data-attr-data-key="row.key">
      <use ui="TreeRow" data-alias-item="row" data-drop="scene prototype behavior event material shape field system library shader-library model ui image mesh sound font" data-drop-zones="list" data-drop-hint="Insert" data-event-drop="emit('CollectionDrop', ev.type, ev.payload, row.key, ev.zone)" data-event-click="emit('CollectionSelected', row.key)" data-attr-data-drag="row.drag" data-attr-data-drag-payload="row.key" data-attr-data-drag-icon="row.icon"/>
      <button class="btn icon-only subtle" aria-label="Move resource up" data-event-click="emit('CollectionMove', row.key, -1)"><span class="icon">&#xea77;</span></button>
      <button class="btn icon-only subtle" aria-label="Move resource down" data-event-click="emit('CollectionMove', row.key, 1)"><span class="icon">&#xea74;</span></button>
      <button class="btn icon-only subtle" aria-label="Remove from collection" data-event-click="emit('CollectionRemove', row.key)"><span class="icon">&#xeb1f;</span></button>
    </div>
  </div>
  <div class="collection-notice" data-if="self.assetCollection.notice != ''" role="status">{{ self.assetCollection.notice }}</div>
  <div class="menu-group">Collected tiles</div>
  <div class="sample tiles">
    <use ui="Tile" class="tile-sample" data-for="slot : self.assetCollection.slots" data-alias-row="self.assetCollection.items[slot]" data-alias-tile="row" data-attr-data-drag="row.drag" data-attr-data-drag-payload="row.key" data-attr-data-drag-icon="row.icon" data-event-click="emit('CollectionSelected', row.key)"/>
    <span class="bin-empty" data-if="self.assetCollection.count == 0">Collected resources appear here.</span>
  </div>
  <div class="menu-group">Presence</div>
  <div class="sample"><use ui="Switch" data-checked="save.galleryShown"/><span class="shown" data-if="save.galleryShown" presence>Shown</span></div>
</div>
