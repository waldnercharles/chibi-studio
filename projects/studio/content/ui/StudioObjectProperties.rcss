@import "StudioPropertyLayout.rcss";
.authored-object-properties { position: relative; width: 100%; height: 100%; min-width: 0dp; min-height: 0dp; }
.object-property-group { display: flex; gap: 6dp; align-items: center; padding: 4dp 0dp; width: 100%; background-color: transparent; color: var(--muted-foreground); }
.object-property .control > .field, .object-property .control > [data-ui=NumberField] { flex: 1 1 0dp; min-width: 0dp; }
.object-property-kind { color: var(--muted-foreground); font-size: var(--studio-font-11, 11dp); }
.object-properties-error { padding: 8dp; color: var(--destructive); }
.object-prototype-popover > [data-ui=StudioPrototypeActions] > .prototype-actions > .btn { display: none; }
.object-reference-menu { width: 300dp; padding: 8dp; }
.object-reference-menu > input { width: 100%; margin-bottom: 6dp; }
.object-reference-options { max-height: 182dp; overflow-y: auto; }
.object-reference-pages { display: flex; justify-content: space-between; margin-top: 6dp; }
