.studio-area { display: flex; flex-direction: column; flex: 1 1 0dp; width: 100%; height: 100%; min-width: 0dp; min-height: 0dp; }
.studio-area > .area-head { flex: 0 0 auto; }
.studio-area-body, .studio-area-content { display: flex; flex-direction: column; flex: 1 1 0dp; min-width: 0dp; min-height: 0dp; overflow: hidden; }
.studio-area-content > [data-ui], .studio-area-graph-view > [data-ui], .studio-area-code-view > [data-ui] { display: flex; flex: 1 1 0dp; min-width: 0dp; min-height: 0dp; }
.studio-area-graph { flex-direction: row; }
.studio-area-graph-view { display: flex; flex: 0 0 auto; min-width: 0dp; min-height: 0dp; }
.studio-area-graph[data-view=graph] .studio-area-graph-view { flex: 1 1 0dp; }
.studio-area-code-view { display: flex; flex: 1 1 0dp; min-width: 0dp; min-height: 0dp; }
.studio-graph-code-split { flex: 0 0 6dp; width: 6dp; cursor: ew-resize; }

.studio-registered-panel-choices { max-height: var(--menu-seven-row-max, 154dp); overflow-y: auto; }
.studio-registered-panel > [data-ui-embedded-root] { display: flex; flex-direction: column; flex: 1 1 0dp; overflow: auto; }
