<div class="menu-item" role="menuitem" attrs data-attrif-data-disabled="item.disabled" data-attrif-data-checked="item.checked"><span class="icon lead" data-if="!item.checked">{{ item.icon }}</span><span class="icon lead" data-if="item.checked">&#xeab2;</span><span class="text"><span class="label">{{ item.label }}<slot/></span></span><span class="kbd" data-if="item.shortcut != ''">{{ item.shortcut }}</span><span class="icon chev">&#xeab6;</span></div>
