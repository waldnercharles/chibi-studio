<div id="studio-theme-tokens" data-measure>
<div class="panel" data-open="" data-for="section : self.themeTokenSections">
  <div class="panel-head"><span class="title">{{ section.file }}</span><span class="badge">{{ section.selector }}</span></div>
  <div class="panel-body">
    <div class="prop" data-for="row : self.themeTokenRows" data-if="row.index &gt;= section.start &amp;&amp; row.index &lt; section.end">
      <div class="label">{{ row.name }}</div>
      <div class="control">
        <div class="field text swatched" data-if="row.color">
          <span class="swatch" data-style-background-color="row.value"/>
          <input type="text" class="value" data-attr-value="row.value" data-event-change="emit('StudioThemeTokenEdit', row.index, ev.value)"/>
        </div>
        <div class="field text" data-if="!row.color"><input type="text" class="value" data-attr-value="row.value" data-event-change="emit('StudioThemeTokenEdit', row.index, ev.value)"/></div>
      </div>
    </div>
  </div>
</div>
<div class="empty" data-if="self.themeTokenSections.size == 0">No theme</div>
</div>
