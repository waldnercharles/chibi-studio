<section class="studio-model-reference" data-if="self.modelReference.active">
  <div class="studio-model-heading"><span class="title">Reference image</span><button class="btn outline sm" data-attrif-disabled="self.modelReference.readOnly" data-event-click="emit('StudioModelReferenceEdit','picker',self.modelDocument,self.modelRevision,'',0.0,false)">Choose image</button></div>
  <div class="studio-model-reference-current"><span>{{ self.modelReference.image == '' ? 'No reference image' : self.modelReference.image }}</span><button class="btn ghost sm" data-if="self.modelReference.image != ''" data-attrif-disabled="self.modelReference.readOnly" data-event-click="emit('StudioModelReferenceEdit','image',self.modelDocument,self.modelRevision,'',0.0,false)">Clear</button></div>
  <div class="studio-model-reference-picker" data-if="self.modelReference.picker">
    <div class="studio-model-heading"><span>Project images</span><button class="btn icon-only sm" aria-label="Close reference picker" data-event-click="emit('StudioModelReferenceEdit','close',self.modelDocument,self.modelRevision,'',0.0,false)"><span class="icon">&#xeb0a;</span></button></div>
    <div class="field search"><input type="text" class="part value" aria-label="Search reference images" data-attr-value="self.modelReference.query" data-event-input="emit('StudioModelReferenceEdit','query',self.modelDocument,self.modelRevision,ev.value,0.0,false)"/></div>
    <div class="studio-model-reference-choices"><button class="btn ghost sm" data-for="image : self.modelReference.rows" data-event-click="emit('StudioModelReferenceEdit','image',self.modelDocument,self.modelRevision,image.Reference,0.0,false)">{{ image.Name }}</button></div>
    <div class="studio-model-view"><button class="btn sm" data-attrif-disabled="self.modelReference.first == 0" data-event-click="emit('StudioModelReferenceEdit','previous',self.modelDocument,self.modelRevision,'',0.0,false)">Previous</button><span>{{ self.modelReference.total }} images</span><button class="btn sm" data-attrif-disabled="self.modelReference.first + 7 &gt;= self.modelReference.total" data-event-click="emit('StudioModelReferenceEdit','next',self.modelDocument,self.modelRevision,'',0.0,false)">Next</button></div>
  </div>
  <div data-if="self.modelReference.image != ''">
    <use ui="Checkbox" label="Lock reference alignment" data-checked="self.modelReference.locked" data-attrif-disabled="self.modelReference.readOnly" data-event-change="emit('StudioModelReferenceEdit','locked',self.modelDocument,self.modelRevision,'',0.0,ev.value)"/>
    <div class="studio-model-components">
      <use ui="NumberField" addon="emit('StudioModelReferenceEdit','x',self.modelDocument,self.modelRevision,'',ev.value,false)" float step="0.1" precision="3" aria-label="Reference center X" data-attr-value="self.modelReference.x" data-attrif-disabled="self.modelReference.readOnly || self.modelReference.locked" data-event-change="emit('StudioModelReferenceEdit','x',self.modelDocument,self.modelRevision,'',ev.value,false)"/>
      <use ui="NumberField" addon="emit('StudioModelReferenceEdit','y',self.modelDocument,self.modelRevision,'',ev.value,false)" float step="0.1" precision="3" aria-label="Reference center Y" data-attr-value="self.modelReference.y" data-attrif-disabled="self.modelReference.readOnly || self.modelReference.locked" data-event-change="emit('StudioModelReferenceEdit','y',self.modelDocument,self.modelRevision,'',ev.value,false)"/>
    </div>
    <use ui="NumberField" addon="Height" min="0.001" max="1000000" float step="0.1" precision="3" aria-label="Reference image height" data-attr-value="self.modelReference.height" data-attrif-disabled="self.modelReference.readOnly || self.modelReference.locked" data-event-change="emit('StudioModelReferenceEdit','height',self.modelDocument,self.modelRevision,'',ev.value,false)"/>
    <use ui="NumberField" addon="Angle" unit="rad" float step="0.05" precision="3" aria-label="Reference image angle" data-attr-value="self.modelReference.angle" data-attrif-disabled="self.modelReference.readOnly || self.modelReference.locked" data-event-change="emit('StudioModelReferenceEdit','angle',self.modelDocument,self.modelRevision,'',ev.value,false)"/>
    <use ui="Checkbox" label="Show reference overlay" data-checked="self.modelReference.visible" data-event-change="emit('StudioModelReferenceEdit','visible',self.modelDocument,self.modelRevision,'',0.0,ev.value)"/>
    <use ui="NumberField" addon="Opacity" min="0" max="1" float step="0.05" precision="2" aria-label="Reference overlay opacity" data-attr-value="self.modelReference.opacity" data-event-change="emit('StudioModelReferenceEdit','opacity',self.modelDocument,self.modelRevision,'',ev.value,false)"/>
  </div>
  <p class="dim">Alignment is stored in the model source. Visibility and opacity affect this preview and its evidence.</p>
  <p role="status" data-if="self.modelReference.busy">Waiting for the source edit…</p>
  <p class="notice error" role="alert" data-if="self.modelReference.error != ''">{{ self.modelReference.error }}</p>
</section>
