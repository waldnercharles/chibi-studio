.ui-designer-workspace { display: flex; width: 100%; height: 100%; min-height: 0; }
.ui-designer-canvas { flex: 1; min-width: 160dp; height: 100%; min-height: 0; }
.ui-designer { flex: 0 0 280dp; min-width: 220dp; max-width: 360dp; height: 100%; padding: 8dp; overflow-y: auto; border-left: 1dp var(--border); }
.ui-designer-toolbar, .ui-designer-row, .ui-designer-field { display: flex; align-items: center; gap: 6dp; }
.ui-designer-toolbar { padding-bottom: 8dp; }
.ui-designer-toolbar > input { flex: 1; min-width: 80dp; }
.ui-designer-tree { border-bottom: 1dp var(--border); padding-bottom: 8dp; }
.ui-designer-row { min-height: var(--row); }
.ui-designer-label { flex: 1; justify-content: flex-start; min-width: 0; }
.ui-designer-label .dim { margin-left: 6dp; }
.ui-designer-fields { padding: 8dp 0; display: flex; flex-direction: column; gap: 8dp; }
.ui-designer-fields h3 { margin: 0; font-size: 13dp; font-weight: bold; }
.ui-designer-field > label { flex: 1; min-width: 80dp; }
.ui-designer-field > input { flex: 1; min-width: 60dp; }
.ui-designer-fields label > input, .ui-designer-fields label > textarea { display: block; width: 100%; }
