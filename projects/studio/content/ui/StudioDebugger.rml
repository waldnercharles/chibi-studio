<section class="studio-debugger" aria-label="Debugger">
  <header class="studio-debugger-heading"><span class="title">Debugger</span><button class="btn icon-only sm" aria-label="Refresh debug targets" data-attrif-disabled="self.debugSession == 0" data-event-click="emit('StudioDebuggerControl','refresh',self.debugViewRevision)"><span class="icon">&#xeae2;</span></button></header>
  <p class="dim" data-if="self.debugSession == 0 &amp;&amp; self.debugHandle == 0">Prepare a scene to inspect its running behaviors.</p>
  <div data-if="self.debugSession &gt; 0">
    <div class="studio-debugger-heading"><button class="btn outline sm" data-event-click="emit('StudioDebuggerPrototypeAction','open',0,'',self.debugSession,self.debugViewRevision)">Watch prototype…</button><span class="dim">{{ self.debugSpawnBreakCount }} spawn breaks armed</span></div>
<p class="dim" data-if="self.debugWatchedPrototype != ''">{{ self.debugWatchedPrototype }} · {{ self.debugWatchedName == '' ? 'No attached behavior' : self.debugWatchedName }}</p>
<div class="studio-debugger-controls"><button class="btn sm" data-attr-aria-pressed="self.debugFollowNewest" data-event-click="emit('StudioDebuggerPolicy','newest',self.debugSession,self.debugViewRevision)">Follow newest</button><button class="btn sm" data-attr-aria-pressed="self.debugBreakOnSpawn" data-event-click="emit('StudioDebuggerPolicy','spawn',self.debugSession,self.debugViewRevision)">Break on spawn</button><button class="btn sm" data-attr-aria-pressed="self.debugFollowLocation" data-event-click="emit('StudioDebuggerPolicy','followLocation',self.debugSession,self.debugViewRevision)">Follow source</button><button class="btn sm" data-attr-aria-pressed="self.debugFollowEntity" data-event-click="emit('StudioDebuggerPolicy','followEntity',self.debugSession,self.debugViewRevision)">Follow entity</button></div>
<section class="panel" data-when="self.debugPrototypeOpen" data-open aria-label="Registered runtime prototypes">
<header class="panel-head"><span class="title">Registered prototypes</span></header>
<div class="panel-body">
<div class="field search"><input class="part value" type="search" aria-label="Find registered runtime prototype" placeholder="Find a prototype or behavior…" data-attr-value="self.debugPrototypeQuery" data-event-input="emit('StudioDebuggerPrototypeAction','query',0,ev.value,self.debugSession,self.debugViewRevision)"/></div>
<div data-when="self.debugPrototypeRows.size &gt; 0"><button class="menu-item" data-for="row,index : self.debugPrototypeRows" data-event-click="emit('StudioDebuggerPrototypeAction','choose',index,'',self.debugSession,self.debugViewRevision)"><span>{{ row.prototype }}</span><span class="dim">{{ row.name == '' ? (row.text == '' ? 'No behavior' : row.text) : row.name }} · {{ row.object }}</span></button></div>
<p class="dim" data-if="self.debugPrototypeTotal == 0">No matching registered prototypes.</p>
<div class="studio-debugger-controls"><button class="btn sm" data-attrif-disabled="self.debugPrototypeFirst == 0" data-event-click="emit('StudioDebuggerPrototypeAction','previous',0,'',self.debugSession,self.debugViewRevision)">Previous</button><button class="btn sm" data-attrif-disabled="self.debugPrototypeFirst + 7 &gt;= self.debugPrototypeTotal" data-event-click="emit('StudioDebuggerPrototypeAction','next',0,'',self.debugSession,self.debugViewRevision)">More</button></div>
</div></section>
<div class="field search"><input class="part value" type="text" aria-label="Find behavior or system to debug" placeholder="Find a behavior…" data-attr-value="self.debugFilter" data-event-input="emit('StudioDebuggerFilter',ev.value)"/></div>
    <div data-when="self.debugTargetSlots.size &gt; 0" class="studio-debugger-targets" role="listbox" aria-label="Debug targets"><button class="menu-item" role="option" data-for="index : self.debugTargetSlots" data-attr-aria-selected="self.debugTargets[index].name == self.debugName &amp;&amp; self.debugTargets[index].owner == self.debugOwner" data-event-click="emit('StudioDebuggerTarget',self.debugTargets[index].name,self.debugTargets[index].owner,self.debugSession,self.debugViewRevision)"><span>{{ self.debugTargets[index].name }}</span><span class="dim">{{ self.debugTargets[index].prototype == '' ? self.debugTargets[index].owner : self.debugTargets[index].prototype }}</span></button></div>
  </div>
  <div class="notice error" role="alert" data-if="self.debugError != ''">{{ self.debugError }}<button class="btn outline sm" data-if="self.debugHandle &gt; 0" data-event-click="emit('StudioDebuggerControl','clear-error',self.debugViewRevision)">Clear error</button></div>
  <div data-if="self.debugHandle &gt; 0">
    <div class="studio-debugger-heading"><strong>{{ self.debugName }}</strong><button class="btn icon-only sm" aria-label="Detach debugger" data-event-click="emit('StudioDebuggerControl','close',self.debugViewRevision)"><span class="icon">&#xeb0a;</span></button></div>
    
    <p role="status" class="dim">{{ self.debugRetired ? 'Retained snapshot · target retired' : self.debugPaused ? 'Paused in code' : 'Observing execution' }}</p>
    <div class="studio-debugger-controls"><button class="btn outline sm" data-attrif-disabled="self.debugRetired" data-event-click="emit('StudioDebuggerControl',self.debugPaused ? 'resume' : 'pause',self.debugViewRevision)">{{ self.debugPaused ? 'Continue' : 'Pause code' }}</button><button class="btn outline sm" data-attrif-disabled="!self.debugPaused || self.debugRetired" data-event-click="emit('StudioDebuggerControl','over',self.debugViewRevision)" data-tip="Step over (F10)">Over</button><button class="btn outline sm" data-attrif-disabled="!self.debugPaused || self.debugRetired" data-event-click="emit('StudioDebuggerControl','into',self.debugViewRevision)" data-tip="Step into (F11)">Into</button><button class="btn outline sm" data-attrif-disabled="!self.debugPaused || self.debugRetired" data-event-click="emit('StudioDebuggerControl','out',self.debugViewRevision)" data-tip="Step out (Shift+F11)">Out</button></div>
    <button class="studio-debugger-location" data-attrif-disabled="self.debugLine == 0" data-event-click="emit('StudioDebuggerPoint','reveal','cursor',0,self.debugViewRevision)">{{ self.debugSource }}:{{ self.debugLine }}</button>
    <section class="panel" data-open><header class="panel-head"><span class="title">Call stack</span></header><div class="panel-body" data-when="self.debugFrameSlots.size &gt; 0"><button class="studio-debugger-frame" data-for="frame : self.debugFrameSlots" data-event-click="emit('StudioDebuggerPoint','reveal','frame',frame,self.debugViewRevision)"><span>{{ self.debugFrames[frame].name }}</span><span class="dim">{{ self.debugFrames[frame].line }}:{{ self.debugFrames[frame].column }}</span></button></div></section>
    <section class="panel" data-attrif-data-open="self.debugValuesOpen"><button class="panel-head" data-event-click="emit('StudioDebuggerControl','values',self.debugViewRevision)" data-attr-aria-expanded="self.debugValuesOpen ? 'true' : 'false'"><span class="icon chev">&#xeab4;</span><span class="title">Captured values</span></button><div class="panel-body" data-if="self.debugValuesOpen"><p class="dim">Values recorded when their source expression executed.</p><div class="studio-debugger-value" data-for="value : self.debugValues"><span data-attr-data-tip="value.type">{{ value.source }}:{{ value.line }}</span><span data-attr-data-tip="value.text">{{ value.available ? value.text : value.status == 1 ? 'Reference not consumed' : value.status == 2 ? 'Snapshot budget reached' : 'Unavailable' }}</span></div></div></section>
    <section class="panel" data-attrif-data-open="self.debugBreakpointsOpen"><button class="panel-head" data-event-click="emit('StudioDebuggerControl','breakpoints',self.debugViewRevision)" data-attr-aria-expanded="self.debugBreakpointsOpen ? 'true' : 'false'"><span class="icon chev">&#xeab4;</span><span class="title">Source breakpoints</span></button><div class="panel-body studio-debugger-points" data-when="self.debugBreakpointsOpen &amp;&amp; self.debugPointSlots.size &gt; 0"><div class="studio-debugger-point" data-for="point : self.debugPointSlots"><button class="btn icon-only sm" data-attrif-disabled="self.debugRetired" data-attr-aria-pressed="self.debugPoints[point].enabled" data-event-click="emit('StudioDebuggerPoint','breakpoint','point',point,self.debugViewRevision)" aria-label="Toggle source breakpoint"><span class="icon">&#xeb0c;</span></button><button class="studio-debugger-point-label" data-event-click="emit('StudioDebuggerPoint','reveal','point',point,self.debugViewRevision)">{{ self.debugPoints[point].name }}:{{ self.debugPoints[point].line }}</button><button class="btn outline sm" data-attrif-disabled="!self.debugPaused || self.debugRetired" data-event-click="emit('StudioDebuggerPoint','run-to','point',point,self.debugViewRevision)">Run to</button></div></div></section>
    <section class="panel" data-if="self.debugSnapshot != ''" data-open><header class="panel-head"><span class="title">Executable source snapshot</span></header><div class="panel-body"><p class="dim">{{ self.debugSnapshotPath }} · captured from this runtime generation.</p><code-editor class="studio-debugger-source" readonly dialect="chibi" data-attr-value="self.debugSnapshot" data-attr-selection-start="self.debugSnapshotStart" data-attr-selection-end="self.debugSnapshotEnd" data-attr-selection-caret="self.debugSnapshotEnd"/></div></section>
  </div>
</section>
