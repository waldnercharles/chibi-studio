<use ui="Dialog" class="new-project" data-keys="Escape:StudioProjectClose Tab:StudioProjectFocusNext Shift+Tab:StudioProjectFocusPrevious">
  <section id="new-project-form" class="project-form" role="dialog" aria-modal="true" aria-labelledby="new-project-title">
    <header class="project-head"><h2 id="new-project-title" class="project-title">Create a project</h2><p class="project-description">Start with a scene you can edit and play.</p></header>
    <div class="project-body">
      <div class="project-name">
        <label for="new-project-name">Project name</label>
        <div class="field text"><input id="new-project-name" class="value" type="text" maxlength="127" placeholder="e.g. Quiet World" autofocus data-attr-value="self.projectNewName" data-event-input="emit('StudioProjectField', 'name', ev.value)" data-keys="Enter:StudioProjectCreate" data-attrif-disabled="self.projectNewBusy" aria-describedby="new-project-error"/></div>
      </div>
      <div class="project-name"><label for="new-project-template">Starting scene</label><use ui="Select"><select id="new-project-template" data-attr-value="self.projectNewTemplate" data-event-change="emit('StudioProjectField', 'template', ev.value)" data-attrif-disabled="self.projectNewBusy"><option value="empty">Empty scene</option><option value="perspective">Perspective scene</option></select></use></div>
      <div class="project-name" data-if="!self.projectNewWeb"><label>Location</label><div class="project-location"><span class="path" data-attr-data-tip="self.projectNewFolder">{{ self.projectNewFolder != '' ? self.projectNewFolder : 'Choose a parent folder' }}</span><button class="btn outline sm" data-attrif-disabled="self.projectNewBusy" data-event-click="emit('StudioProjectAction', 'location')">Choose…</button></div><div class="project-help" data-if="self.projectNewFolder != ''">A new folder named {{ self.projectNewName != '' ? self.projectNewName : 'after your project' }} will be created here.</div></div>
      <div class="project-help" data-if="self.projectNewWeb">The project opens in this browser. Use Export Project to download its files as a ZIP.</div>
      <div id="new-project-error" class="project-error" role="alert" data-if="self.projectNewError != ''">{{ self.projectNewError }}</div>
      <div class="project-pending" role="status" data-if="self.projectNewBusy">{{ self.projectNewOperation == 'choose-folder' ? 'Choose a folder in the system dialog…' : 'Creating project…' }}</div>
    </div>
    <footer class="project-actions"><button id="new-project-cancel" class="btn outline" data-attrif-disabled="self.projectNewBusy" data-event-click="emit('StudioProjectAction', 'close')">Cancel</button><button class="btn primary" data-attrif-disabled="self.projectNewBusy" data-event-click="emit('StudioProjectAction', 'create')">Create project</button></footer>
  </section>
</use>
