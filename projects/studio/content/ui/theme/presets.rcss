/* Studio palettes from their authors' published values.
   https://draculatheme.com/contribute
   https://ethanschoonover.com/solarized/
   https://github.com/folke/tokyonight.nvim
   https://catppuccin.com/palette/
   https://rosepinetheme.com/palette/
   https://github.com/morhetz/gruvbox
   Subdued text, links and status roles are adjusted to at least 4.5:1.
   Selection is an explicit palette tint so subdued text remains readable. */

body.theme-dracula {
    --background: #282a36;
    --foreground: #f8f8f2;
    --card: #282a36;
    --card-foreground: #f8f8f2;
    --popover: #282a36;
    --popover-foreground: #f8f8f2;
    --primary: #bd93f9;
    --primary-foreground: #000000;
    --secondary: #44475a;
    --secondary-foreground: #f8f8f2;
    --muted: #282a36;
    --muted-foreground: #ced3e3;
    --accent: #343641;
    --accent-foreground: #f8f8f2;
    --border: #6272a4;
    --input: #6272a4;
    --ring: #dfcafc;
    --app: #21222c;
    --primary-text: #dfcafc;
    --link: #dfcafc;
    --selected: #3a374d;
    --active-row: var(--selected);
    --faint-foreground: var(--muted-foreground);
    --destructive: #ffc4c4;
    --warning: #f1fa8c;
    --success: #50fa7b;
    --override: #8be9fd;
    --override-fg: #8be9fd;
    --notice-fg: #f1fa8c;
    --axis-x: #ffc4c4;
    --axis-y: #50fa7b;
    --tok-number: #ffc98f;
    --tok-string: #50fa7b;
    --tok-keyword: #dfcafc;
    --tok-name: #8be9fd;
    --tok-path: #dfcafc;
    --tok-punct: #ced3e3;
    --override-soft: #8be9fd1f;
    --highlight: #f1fa8c44;
    --notice: #282a36f0;
}

