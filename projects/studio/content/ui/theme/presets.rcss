    --ring: #fea55c;
    --app: #1d2021;
    --primary-text: #fea55c;
    --link: #fea55c;
    --selected: #423326;
    --active-row: var(--selected);
    --faint-foreground: var(--muted-foreground);
    --destructive: #fda297;
    --warning: #fabd2f;
    --success: #bdc035;
    --override: #98c688;
    --override-fg: #98c688;
    --notice-fg: #fabd2f;
    --axis-x: #fda297;
    --axis-y: #bdc035;
    --tok-number: #fea55c;
    --tok-string: #bdc035;
    --tok-keyword: #e1acba;
    --tok-name: #98c688;
    --tok-path: #fea55c;
    --tok-punct: #c1b8b0;
    --override-soft: #98c6881f;
    --highlight: #fabd2f44;
    --notice: #1d2021f0;
}
