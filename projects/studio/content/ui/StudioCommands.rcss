.studio-command-modal .dialog-panel { overflow: hidden; }
.studio-command-choices { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0dp; }
.studio-command-dialog { width: 560dp; max-width: 100%; max-height: 100%; min-height: 0dp; display: flex; flex-direction: column; }
.studio-command-search { display: flex; flex: 0 0 auto; align-items: center; gap: 8dp; padding: 12dp; border-bottom: 1dp var(--border); }
.studio-command-search input { flex: 1 1 0dp; min-width: 0dp; height: 28dp; }
.studio-command-results { flex: 1 1 auto; min-height: 0dp; box-sizing: border-box; max-height: 302dp; overflow-y: auto; padding: 4dp; }
.studio-command-row { display: flex; align-items: center; gap: 10dp; box-sizing: border-box; height: 42dp; min-height: 42dp; padding: 4dp 8dp; border-radius: 3dp; }
.studio-command-row:hover, .studio-command-row[data-highlighted] { background-color: var(--accent); }
.studio-command-row[data-disabled] { opacity: 0.45; }
.studio-command-label { display: flex; flex-direction: column; flex: 1 1 0dp; min-width: 0dp; }
.studio-command-context { font-size: 11dp; color: var(--muted-foreground); }
.studio-command-footer { display: flex; flex: 0 0 auto; align-items: center; gap: 6dp; padding: 8dp 12dp; border-top: 1dp var(--border); color: var(--muted-foreground); font-size: 11dp; }
.studio-spacer { flex: 1 1 0dp; }
.studio-command-empty { padding: 24dp; text-align: center; color: var(--muted-foreground); }
