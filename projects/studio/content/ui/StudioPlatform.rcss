.platform-job {
    display: flex;
    flex-direction: column;
    gap: 6dp;
    padding: 10dp 12dp;
    background: var(--background);
    color: var(--foreground);
    border-top: 1dp var(--border);
}
.platform-job-head {
    display: flex;
    align-items: center;
    gap: 8dp;
}
.platform-job-message, .platform-job-path {
    margin: 0;
}
.platform-job-path, .platform-job-log {
    font-family: "JetBrains Mono";
    white-space: pre-wrap;
    word-break: break-word;
}
.platform-job-log {
    max-height: 200dp;
    overflow-y: auto;
    padding: 8dp;
    background: var(--muted);
}
