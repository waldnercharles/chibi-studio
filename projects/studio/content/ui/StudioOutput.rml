<div class="studio-output">
  <div class="studio-output-toolbar" role="group" aria-label="Output views">
    <button class="btn sm" data-attr-aria-pressed="self.outputView == 'log' ? 'true' : 'false'" data-attrif-data-selected="self.outputView == 'log'" data-event-click="emit('StudioOutputCommand', 'log', '')">Log</button>
    <button class="btn sm" data-attr-aria-pressed="self.outputView == 'problems' ? 'true' : 'false'" data-attrif-data-selected="self.outputView == 'problems'" data-event-click="emit('StudioOutputCommand', 'problems', '')">Problems</button>
    <button class="btn sm" data-attr-aria-pressed="self.outputView == 'runtime' ? 'true' : 'false'" data-attrif-data-selected="self.outputView == 'runtime'" data-event-click="emit('StudioOutputCommand', 'runtime', '')">Runtime</button>
    <button class="btn sm" data-attr-aria-pressed="self.outputView == 'history' ? 'true' : 'false'" data-attrif-data-selected="self.outputView == 'history'" data-event-click="emit('StudioOutputCommand', 'history', '')">History</button>
    <button class="btn sm" data-attr-aria-pressed="self.outputView == 'info' ? 'true' : 'false'" data-attrif-data-selected="self.outputView == 'info'" data-event-click="emit('StudioOutputCommand', 'info', '')">Info</button>
    <span data-if="self.outputView == 'references'">References</span><span data-if="self.outputView == 'calls'">Call hierarchy</span>
    <span class="spacer"></span><button class="btn sm" data-event-click="emit('StudioOutputCommand', 'refresh', '')">Refresh</button>
  </div>
  <div class="studio-output-toolbar">
    <input id="studio-output-filter" data-event-mousedown="stop" class="field output-search" type="text" aria-label="Filter output" data-attr-placeholder="self.outputView == 'references' || self.outputView == 'calls' || (self.outputView == 'problems' &amp;&amp; self.outputProblemScope == 'project') ? 'Filter this page' : 'Filter messages'" data-attr-value="self.outputFilter" data-event-input="emit('StudioOutputCommand', 'filter', ev.value)" data-event-focus="emit('StudioPaneFocus',pane,'output',true)" data-event-blur="emit('StudioPaneFocus',pane,'output',false)" />
    <input class="field output-program" type="text" data-if="self.outputView == 'log' || self.outputView == 'runtime' || self.outputView == 'history'" aria-label="Exact program filter" placeholder="All programs" data-attr-value="self.outputProgram" data-event-change="emit('StudioOutputCommand', 'program', ev.value)" />
    <use ui="Select" data-if="self.outputView == 'log'"><select aria-label="Log level" data-attr-value="self.outputLevel" data-event-change="emit('StudioOutputCommand', 'level', ev.value)"><option value="">All levels</option><option value="log">Runtime log</option><option value="info">Information</option><option value="warning">Warning</option><option value="error">Error</option><option value="history">History</option></select></use>
    <use ui="Select" data-if="self.outputView == 'problems'"><select aria-label="Problem scope" data-attr-value="self.outputProblemScope" data-event-change="emit('StudioOutputCommand', 'scope', ev.value)"><option value="project">Project</option><option value="document">Active document</option></select></use>
    <button class="btn sm" data-if="self.outputView == 'log' || self.outputView == 'runtime' || self.outputView == 'history'" data-event-click="emit('StudioOutputCommand', 'clear', '')">Clear logs</button>
    <button class="btn sm" data-if="self.outputView == 'log' || self.outputView == 'runtime' || self.outputView == 'history'" data-attr-aria-pressed="self.outputFollow ? 'true' : 'false'" data-event-click="emit('StudioOutputCommand', 'latest', '')">Latest page</button>
  </div>
  <div class="studio-output-toolbar" data-if="self.outputView == 'calls'"><button class="btn sm" data-attrif-disabled="!self.outputCanBack || self.outputBusy" data-event-click="emit('StudioOutputCommand', 'back', '')">Back</button><use ui="Select"><select aria-label="Call direction" data-attr-value="self.outputDirection == 0 ? 'incoming' : 'outgoing'" data-event-change="emit('StudioOutputCommand', ev.value, '')"><option value="incoming">Incoming calls</option><option value="outgoing">Outgoing calls</option></select></use><span class="dim">{{ self.outputCallPath }}</span></div>
  <div class="notice error" role="alert" data-if="self.outputError != ''">{{ self.outputError }}</div>
  <p class="dim" data-if="self.outputView == 'problems' &amp;&amp; self.outputProblemScope == 'document'">Active document: {{ self.outputPath }}</p>
  <p class="dim" data-if="self.outputView == 'problems' &amp;&amp; self.outputProblemScope == 'project' &amp;&amp; self.outputFilter != ''">Filter applies to this page of project diagnostics.</p>
  <p class="dim" data-if="self.outputDropped &gt; 0 &amp;&amp; (self.outputView == 'log' || self.outputView == 'runtime' || self.outputView == 'history')">{{ self.outputDropped }} older messages were dropped from the bounded log.</p>
  <div class="studio-output-rows" role="region" aria-label="Output results">
    <div class="studio-output-log" data-if="self.outputView == 'log' || self.outputView == 'runtime' || self.outputView == 'history'" data-for="row : self.outputLogs"><span class="dim">{{ row.time }} {{ row.program }} · {{ row.level }}</span><span>{{ row.text }}</span><button class="btn subtle" data-if="row.path != '' &amp;&amp; row.line &gt; 0" data-event-click="emit('StudioTextProjectLine', row.path, row.line)">{{ row.path }}:{{ row.line }}</button><span class="dim" data-if="row.path != '' &amp;&amp; row.line &lt;= 0">{{ row.path }}</span><span class="dim" data-if="row.truncated">Message truncated</span></div>
    <button class="btn subtle studio-output-result" data-if="self.outputView == 'problems' &amp;&amp; self.outputProblemScope == 'document'" data-for="row : self.outputProblems" data-event-click="emit('StudioOutputNavigate', self.outputPath, row.start, row.end)"><span>{{ row.line }}:{{ row.column }}</span><span>{{ row.message }}</span></button>
    <button class="btn subtle studio-output-result" data-if="self.outputView == 'problems' &amp;&amp; self.outputProblemScope == 'project'" data-for="row : self.outputProjectProblems" data-event-click="emit('StudioOutputNavigate', row.path, row.start, row.end)"><span>{{ row.path }}:{{ row.line }}:{{ row.column }}</span><span>{{ row.message }}</span></button>
    <button class="btn subtle studio-output-result" data-if="self.outputView == 'references'" data-for="row : self.outputReferences" data-event-click="emit('StudioOutputNavigate', row.path, row.start, row.end)"><span>{{ row.path }}</span><span>{{ row.name }}</span></button>
    <div class="studio-output-call" data-if="self.outputView == 'calls'" data-for="row : self.outputCalls"><button class="btn subtle studio-output-result" data-event-click="emit('StudioOutputNavigate', row.path, row.start, row.end)"><strong>{{ row.label }}</strong><span class="dim">{{ row.path }}</span><span>{{ row.signature }}</span></button><button class="btn sm" data-attrif-disabled="row.target == '' || self.outputBusy" data-event-click="emit('StudioOutputExpand', row.target, row.target_start)">Expand</button></div>
    <pre class="studio-output-info" data-if="self.outputView == 'info'">{{ self.outputInfo }}</pre>
    <p role="status" data-if="self.outputTotal &gt; 0 &amp;&amp; self.outputShown == 0 &amp;&amp; self.outputFilter != '' &amp;&amp; self.outputView != 'info'">No matches on this page.</p>
    <p role="status" data-if="self.outputTotal == 0 &amp;&amp; self.outputView != 'info' &amp;&amp; self.outputError == ''">No results.</p>
  </div>
  <div class="studio-output-toolbar" data-if="self.outputView != 'info'"><button class="btn sm" data-attrif-disabled="self.outputFirst == 0" data-event-click="emit('StudioOutputCommand', 'previous', '')">Previous</button><span>{{ self.outputFirst }} / {{ self.outputTotal }}</span><button class="btn sm" data-attrif-disabled="self.outputFirst + 64 &gt;= self.outputTotal" data-event-click="emit('StudioOutputCommand', 'next', '')">Next</button></div>
</div>
