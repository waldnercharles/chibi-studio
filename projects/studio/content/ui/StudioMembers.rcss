body, .authored-members { display: flex; flex-direction: column; width: 100%; height: 100%; min-width: 0dp; min-height: 0dp; }
.authored-members .graph-members { flex: 0 1 auto; max-height: 45%; border-right-width: 0dp; border-bottom: 1dp var(--border); padding: 4dp; overflow-y: auto; }
.authored-members .graph-details { flex: 1 1 0dp; min-height: 0dp; border-left-width: 0dp; padding: 8dp; overflow-y: auto; }
.authored-members .graph-member { display: flex; align-items: center; width: 100%; min-width: 0dp; gap: 6dp; margin-bottom: 2dp; }
.authored-members .section-label { display: block; margin: 8dp 0dp; color: var(--muted-foreground); }
.authored-members .graph-details strong, .authored-members .graph-details .meta, .authored-members .graph-details .field { display: block; margin-bottom: 8dp; }
.authored-members .graph-port-field { display: flex; flex-direction: column; gap: 4dp; margin-bottom: 8dp; }
