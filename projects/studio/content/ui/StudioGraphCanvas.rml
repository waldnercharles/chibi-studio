<div class="authored-graph">

  <section class="graph-palette" data-if="self.graph.palette" aria-label="Add graph node">
    <div class="field text"><input class="part value" type="text" placeholder="Search nodes…" aria-label="Search graph nodes" data-attr-value="self.graph.query" data-event-input="emit('StudioGraphAction','query',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
    <div class="graph-palette-results"><button class="btn ghost graph-choice" data-for="choice : self.graph.choices" data-event-click="emit('StudioGraphAction','add',choice.type,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"><span>{{ choice.label }}</span><span class="meta">{{ choice.category }}</span></button></div>
  </section>
  <div class="graph-content">
    <aside class="graph-members" aria-label="Graphs">
      <section class="panel" data-when="self.graph.dialect == 'chibi'" data-attrif-data-open="self.graph.membersOpen">
        <button class="panel-head" data-attr-aria-expanded="self.graph.membersOpen ? 'true' : 'false'" data-event-click="emit('StudioGraphAction','membersToggle','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"><span class="icon chev">&#xeab4;</span><span class="title">Declarations</span></button>
        <div class="panel-body" data-if="self.graph.membersOpen">
          <div class="field text"><input class="part value" type="search" placeholder="Search declarations" aria-label="Search declarations" data-attr-value="self.graph.membersQuery" data-event-input="emit('StudioGraphAction','membersQuery',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
          <button class="graph-member btn sm" data-for="member, index : self.graph.members" data-attr-aria-pressed="index == self.graph.memberSelected ? 'true' : 'false'" data-attr-data-tip="member.type" data-event-click="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','member',index,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"><span>{{ member.name }}</span><span class="meta">{{ member.kind }}</span></button>
          <div class="graph-refactor-actions"><button class="btn sm" data-attrif-disabled="self.graph.membersFirst == 0" data-event-click="emit('StudioGraphAction','membersPrevious','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Previous</button><button class="btn sm" data-attrif-disabled="self.graph.membersFirst + 7 &gt;= self.graph.membersTotal" data-event-click="emit('StudioGraphAction','membersNext','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Next</button></div>
          <label>Name</label><div class="field text"><input class="part value" type="text" data-attr-value="self.graph.declarationName" data-event-change="emit('StudioGraphAction','declarationName',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
          <label>Type</label><div class="field text"><input class="part value" type="text" data-attr-value="self.graph.declarationType" data-event-change="emit('StudioGraphAction','declarationType',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
          <label>Initial expression</label><div class="field text"><input class="part value" type="text" data-attr-value="self.graph.declarationValue" data-event-change="emit('StudioGraphAction','declarationValue',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
          <div class="graph-refactor-actions"><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','newState','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Add state</button><button class="btn sm" data-attrif-disabled="self.graph.memberSelected &lt; 0 || self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','memberRename','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Rename declaration</button><button class="btn sm" data-attrif-disabled="self.graph.memberSelected &lt; 0 || self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','memberType','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Change state type</button><button class="btn sm" data-attrif-disabled="self.graph.memberSelected &lt; 0 || self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','memberInitializer','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Apply initializer</button><button class="btn sm" data-attrif-disabled="self.graph.memberSelected &lt; 0 || self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','duplicateMember',0,'',self.graph.document,self.graph.revision)">Duplicate state</button><button class="btn sm" data-event-click="emit('StudioGraphMemberAction','getMember',0,'',self.graph.document,self.graph.revision)">Create Get</button><button class="btn sm" data-event-click="emit('StudioGraphMemberAction','setMember',0,'',self.graph.document,self.graph.revision)">Create Set</button><button class="btn sm" data-attrif-disabled="self.graph.memberSelected &lt; 0 || self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','removeMember',0,'',self.graph.document,self.graph.revision)">Delete state</button></div>
        </div>
      </section>
      <span class="section-label">Find in graph</span>
      <div class="field text"><input class="part value" type="text" data-attr-id="'studio-graph-find-' + pane" aria-label="Find node, port or value" placeholder="Find…" data-attr-value="self.graph.find" data-event-input="emit('StudioGraphAction','find',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
      <button class="btn sm" data-event-click="emit('StudioGraphAction','findNext','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Next match</button>
      <span class="section-label">Graphs</span>
      <div class="field text"><input class="part value" type="text" aria-label="New function name" data-attr-value="self.graph.newScopeName" data-event-change="emit('StudioGraphAction','scopeName',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
      <button class="btn outline sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','scopeAdd','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">New function</button>
      <button class="btn graph-member" data-for="scope : self.graph.scopes" data-attr-aria-pressed="scope.graph == self.graph.active" data-event-click="emit('StudioGraphAction','graph',scope.graph,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"><span class="icon">&#xeb21;</span>{{ scope.name == '' ? scope.kind : scope.name }}</button>
      <button class="btn outline sm" data-if="self.graph.dialect != 'kdl'" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','macroAdd','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">New macro</button>
    </aside>
    <div data-attr-id="'studio-graph-viewport-' + pane" class="graph-viewport" tabindex="0" data-measure data-keys="Escape:StudioGraphCancel Delete:StudioGraphDelete F:StudioGraphFrame Home:StudioGraphHome Tab:StudioGraphEnterCall Ctrl+Tab:StudioGraphLeaveCall" data-event-mousescroll="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer', 'wheel', -1, self.graph.document, self.graph.revision); stop()" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">
      <div class="graph-pan-surface" data-event-dragstart="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer', 'panBegin', -1, self.graph.document, self.graph.revision)" data-event-drag="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer', 'pan', -1, self.graph.document, self.graph.revision)" data-event-dragend="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer', 'panEnd', -1, self.graph.document, self.graph.revision)"/>
      <div data-when="self.graph.wires.size &gt; 0"><div class="graph-edge" data-attr-data-type="self.graph.edges[index].type" data-attr-data-flow="self.graph.edges[index].flow" data-for="index : self.graph.wires" data-attr-aria-label="self.graph.edges[index].label" data-attr-data-selected="self.graph.edges[index].selected">
        <vector-path class="graph-vector-wire" data-attr-path="self.graph.edges[index].path" data-attr-style="self.graph.edges[index].pathStyle" data-attr-stroke="self.graph.edges[index].color" data-attr-stroke-width="self.graph.edges[index].strokeWidth"/>
        <vector-path class="graph-vector-activity" data-attr-path="self.graph.edges[index].path" data-attr-style="self.graph.edges[index].pathStyle + self.graph.activity.edges[index]" stroke="#e8e8ea8c" data-attr-stroke-width="self.graph.edges[index].strokeWidth + 1.5"/>
        <div data-for="segment : self.graph.edges[index].segments"><button class="graph-wire-hit" data-attr-aria-label="self.graph.edges[index].label" data-attr-style="self.graph.edges[index].hits[segment].hit" data-event-click="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','wire',index,self.graph.document,self.graph.revision); stop()" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"/></div>
      </div></div>
      <div data-for="note : self.graph.noteSlots"><button class="graph-note" data-if="!self.graph.notes[note].hidden" data-attr-data-box="self.graph.notes[note].box" data-attr-style="self.graph.noteStyle[note]" data-event-click="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','note',note,self.graph.document,self.graph.revision); stop()" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">{{ self.graph.notes[note].title }}</button></div>
      <div data-when="self.graph.slots.size &gt; 0"><div class="graph-node" data-attr-data-kind="self.graph.nodes[index].kind" data-attr-data-category="self.graph.nodes[index].category" data-attr-data-form="self.graph.nodes[index].form" data-event-dblclick="emit('StudioGraphCommand','enterCall',''); stop()" data-attr-data-breakpoint="self.graph.nodes[index].breakpoint" data-attr-data-disabled="self.graph.nodes[index].disabled" data-for="index : self.graph.slots" data-attr-style="self.graph.nodes[index].style" data-attr-data-selected="self.graph.nodes[index].selected" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer', 'select', index, self.graph.document, self.graph.revision); stop()">
        <div class="graph-node-title" data-event-dragstart="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer', 'dragBegin', index, self.graph.document, self.graph.revision); stop()" data-event-drag="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer', 'drag', index, self.graph.document, self.graph.revision); stop()" data-event-dragend="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer', 'dragEnd', index, self.graph.document, self.graph.revision); stop()"><span class="icon" data-if="self.graph.nodes[index].category == 'expression'">&#xf0169;</span><span class="icon" data-if="self.graph.nodes[index].category == 'call' || self.graph.nodes[index].kind == 2">&#xf0871;</span><span class="icon" data-if="self.graph.nodes[index].kind == 1">&#xea86;</span><span class="icon" data-if="self.graph.nodes[index].kind == 3">&#xf062c;</span><span class="icon" data-if="self.graph.nodes[index].kind == 4">&#xeb5f;</span><span class="graph-title-text">{{ self.graph.nodes[index].title }}</span></div>
        <div class="graph-selection-ring" data-if="self.graph.nodes[index].selected"/>
        <div class="graph-activity-node" data-attr-style="self.graph.activity.nodes[index]"/>
        <span class="graph-node-symbol" data-attr-style="self.graph.nodes[index].symbolStyle" data-if="self.graph.nodes[index].form == 2">{{ self.graph.nodes[index].symbol }}</span>
        <div class="graph-node-source" data-if="self.graph.nodes[index].codeLines.size &gt; 0"><span class="graph-code-line" data-for="line : self.graph.nodes[index].codeLines">{{ line }}</span></div>
        <div class="graph-node-ports">
          <div class="graph-outputs">
            <div class="graph-output-row" data-for="pin : self.graph.nodes[index].outputs" data-attr-style="self.graph.ports[pin].style" data-attr-data-header="self.graph.ports[pin].header" data-attr-data-flow="self.graph.ports[pin].flow">            <button class="graph-port output" data-attr-data-header="self.graph.ports[pin].header" data-attr-data-connected="self.graph.ports[pin].connected" data-attr-data-type="self.graph.ports[pin].type" data-attr-data-selected="pin == self.graph.wire" data-attr-data-flow="self.graph.ports[pin].flow" data-attr-data-tip="self.graph.ports[pin].type" data-event-click="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','port',pin,self.graph.document,self.graph.revision); stop()" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"><span class="graph-pin-label">{{ self.graph.ports[pin].label }}</span></button>
              <div class="graph-inline-field graph-output-value" data-if="self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[pin].editable" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-click="stop()">
                <div class="graph-vector-field" data-if="self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[pin].vector_width &gt; 0"><use ui="NumberField" float step="0.01" data-for="component : self.graph.ports[pin].components" data-attr-value="self.graph.ports[pin].values[component]" data-attr-aria-label="self.graph.ports[pin].label + ' component ' + (component + 1)" data-event-change="emit('StudioGraphVectorNumber',pin,self.graph.document,self.graph.revision,component,ev.value,ev.canceled)"/></div>
                <use ui="Checkbox" data-if="self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[pin].editable &amp;&amp; self.graph.ports[pin].type == 'bool'" data-attr-aria-label="self.graph.ports[pin].label" data-attrif-checked="self.graph.ports[pin].boolean" data-event-change="emit('StudioGraphValue',pin,self.graph.document,self.graph.revision,ev.value ? 'true' : 'false')" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
                <use ui="NumberField" data-attrif-integer="self.graph.ports[pin].type == 'int'" data-attrif-float="self.graph.ports[pin].type != 'int'" data-attr-step="self.graph.ports[pin].type == 'int' ? 1 : 0.01" data-if="self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[pin].editable &amp;&amp; (self.graph.ports[pin].type == 'float' || self.graph.ports[pin].type == 'double' || self.graph.ports[pin].type == 'int')" data-attr-aria-label="self.graph.ports[pin].label" data-attr-value="self.graph.ports[pin].number" data-event-change="emit('StudioGraphNumber',pin,self.graph.document,self.graph.revision,ev.value)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
                <div class="field text" data-if="self.graph.ports[pin].vector_width == 0 &amp;&amp; !(self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[pin].editable &amp;&amp; (self.graph.ports[pin].type == 'bool' || self.graph.ports[pin].type == 'float' || self.graph.ports[pin].type == 'double' || self.graph.ports[pin].type == 'int'))"><input class="part value" type="text" placeholder="Expression or property path" data-attr-aria-label="self.graph.ports[pin].label" data-attr-value="self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[pin].type != 'const char *' &amp;&amp; self.graph.ports[pin].type != 'name' &amp;&amp; self.graph.ports[pin].type != 'string' ? self.graph.ports[pin].value : self.graph.ports[pin].text" data-event-change="emit('StudioGraphValue',pin,self.graph.document,self.graph.revision,ev.value)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
              </div>
              <span class="socket"><shape-glyph class="socket-glyph" data-attr-shape="self.graph.ports[pin].flow ? 'arrow' : (self.graph.ports[pin].container != 0 ? 'square' : 'circle')" data-attr-fill="self.graph.ports[pin].connected ? self.graph.ports[pin].colorText : self.graph.nodeColor" data-attr-stroke="self.graph.ports[pin].colorText" stroke-width="1.5"/></span>
            </div>
          </div>
          <div class="graph-inputs">
            <div class="graph-input-row" data-attr-style="self.graph.ports[pin].style + (self.graph.nodes[index].form == 2 ? self.graph.nodes[index].inputStyle : '')" data-attr-data-header="self.graph.ports[pin].header" data-attr-data-flow="self.graph.ports[pin].flow" data-for="pin : self.graph.nodes[index].inputs"><button class="btn sm graph-unfold-input" aria-label="Expand input expression" data-when="pin &gt;= 0 &amp;&amp; pin &lt; self.graph.foldedInputs.size &amp;&amp; self.graph.foldedInputs[pin] &gt;= 0" data-event-click="emit('StudioGraphMemberAction','unfold',self.graph.foldedInputs[pin],'',self.graph.document,self.graph.revision); stop()"><span class="icon">&#xea6c;</span></button>
              <button class="graph-port input" data-attr-data-connected="self.graph.ports[pin].connected" data-attr-data-type="self.graph.ports[pin].type" data-attr-data-selected="pin == self.graph.port" data-attr-data-flow="self.graph.ports[pin].flow" data-attr-data-tip="self.graph.ports[pin].type" data-event-click="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','port',pin,self.graph.document,self.graph.revision); stop()" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"><span class="socket"><shape-glyph class="socket-glyph" data-attr-shape="self.graph.ports[pin].flow ? 'arrow' : (self.graph.ports[pin].container != 0 ? 'square' : 'circle')" data-attr-fill="self.graph.ports[pin].connected ? self.graph.ports[pin].colorText : self.graph.nodeColor" data-attr-stroke="self.graph.ports[pin].colorText" stroke-width="1.5"/></span><span class="graph-pin-label">{{ self.graph.ports[pin].label }}</span></button>
              <button class="graph-source-chip" data-if="!self.graph.ports[pin].flow &amp;&amp; (self.graph.ports[pin].connected || self.graph.ports[pin].bound)" data-attr-data-tip="self.graph.ports[pin].source" data-event-click="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','port',pin,self.graph.document,self.graph.revision); stop()">{{ self.graph.ports[pin].source }}</button>
              <div class="graph-inline-field" data-if="!self.graph.ports[pin].flow &amp;&amp; !self.graph.ports[pin].connected &amp;&amp; !self.graph.ports[pin].bound" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-click="stop()">
                <div class="graph-vector-field" data-if="self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[pin].vector_width &gt; 0"><use ui="NumberField" float step="0.01" data-for="component : self.graph.ports[pin].components" data-attr-value="self.graph.ports[pin].values[component]" data-attr-aria-label="self.graph.ports[pin].label + ' component ' + (component + 1)" data-event-change="emit('StudioGraphVectorNumber',pin,self.graph.document,self.graph.revision,component,ev.value,ev.canceled)"/></div>
                <use ui="Checkbox" data-if="self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[pin].editable &amp;&amp; self.graph.ports[pin].type == 'bool'" data-attr-aria-label="self.graph.ports[pin].label" data-attrif-checked="self.graph.ports[pin].boolean" data-event-change="emit('StudioGraphValue',pin,self.graph.document,self.graph.revision,ev.value ? 'true' : 'false')" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
                <use ui="NumberField" data-attrif-integer="self.graph.ports[pin].type == 'int'" data-attrif-float="self.graph.ports[pin].type != 'int'" data-attr-step="self.graph.ports[pin].type == 'int' ? 1 : 0.01" data-if="self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[pin].editable &amp;&amp; (self.graph.ports[pin].type == 'float' || self.graph.ports[pin].type == 'double' || self.graph.ports[pin].type == 'int')" data-attr-aria-label="self.graph.ports[pin].label" data-attr-value="self.graph.ports[pin].number" data-event-change="emit('StudioGraphNumber',pin,self.graph.document,self.graph.revision,ev.value)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
                <div class="field text" data-if="self.graph.ports[pin].vector_width == 0 &amp;&amp; !(self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[pin].editable &amp;&amp; (self.graph.ports[pin].type == 'bool' || self.graph.ports[pin].type == 'float' || self.graph.ports[pin].type == 'double' || self.graph.ports[pin].type == 'int'))"><input class="part value" type="text" placeholder="Expression or property path" data-attr-aria-label="self.graph.ports[pin].label" data-attr-value="self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[pin].type != 'const char *' &amp;&amp; self.graph.ports[pin].type != 'name' &amp;&amp; self.graph.ports[pin].type != 'string' ? self.graph.ports[pin].value : self.graph.ports[pin].text" data-event-change="emit('StudioGraphValue',pin,self.graph.document,self.graph.revision,ev.value)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
              </div>
            </div>
          </div>
        </div>
      </div></div>
      <button class="graph-route-handle" data-attrif-disabled="self.graph.readonly || self.graph.busy" data-for="route : self.graph.routeSlots" data-attr-style="self.graph.routeStyle[route]" data-attr-aria-label="'Wire route point ' + (self.graph.routes[route].index + 1)" data-event-click="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','route',route,self.graph.document,self.graph.revision); stop()" data-event-dragstart="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','routeDragBegin',route,self.graph.document,self.graph.revision); stop()" data-event-drag="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','routeDrag',route,self.graph.document,self.graph.revision); stop()" data-event-dragend="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','routeDragEnd',route,self.graph.document,self.graph.revision); stop()" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"/>
      <div class="graph-selection-box" data-if="self.graph.box" data-attr-style="self.graph.boxStyle"/>
      <div class="graph-empty" data-if="self.graph.empty">No graph projection is available for this document.</div>
    </div>
    <aside class="graph-details" aria-label="Graph details">
      <span class="section-label">Details</span>
      <div class="field text"><input class="part value" type="text" aria-label="Graph declaration name" data-attr-value="self.graph.scopeName" data-event-change="emit('StudioGraphAction','rename',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
<section class="panel" data-when="self.graph.dialect == 'kdl'" data-open><header class="panel-head"><span class="title">Members</span></header><div class="panel-body"><button class="btn sm graph-member" data-for="index : self.graph.shownMembers" data-attr-aria-pressed="index == self.graph.nativeMemberSelected" data-event-click="emit('StudioGraphMemberAction','selectMember',index,'',self.graph.document,self.graph.revision)">{{ self.graph.structuredMembers[index].name }}<span class="meta">{{ self.graph.structuredMembers[index].kind }}</span></button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','membersPrevious',0,'',self.graph.document,self.graph.revision)">Previous</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','membersNext',0,'',self.graph.document,self.graph.revision)">More</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','addMember',0,'',self.graph.document,self.graph.revision)">Add variable</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','removeMember',0,'',self.graph.document,self.graph.revision)">Delete</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','duplicateMember',0,'',self.graph.document,self.graph.revision)">Duplicate</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','renameMember',0,'',self.graph.document,self.graph.revision)">Rename</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','typeMember',0,'',self.graph.document,self.graph.revision)">Apply type</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','defaultMember',0,'',self.graph.document,self.graph.revision)">Apply default</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','getMember',0,'',self.graph.document,self.graph.revision)">Create Get</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','setMember',0,'',self.graph.document,self.graph.revision)">Create Set</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','callMember',0,'',self.graph.document,self.graph.revision)">Create call</button><p class="dim">Name, type and value use the fields below.</p></div></section>
      <section class="panel" data-when="self.graph.callableEditable || self.graph.nativeMemberSelected &gt;= 0" data-open>
        <header class="panel-head"><span class="title">{{ self.graph.callableEditable ? 'Inputs &amp; outputs' : 'Member properties' }}</span></header>
        <div class="panel-body">
          <button class="btn sm graph-member" data-for="index : self.graph.shownPins" data-attr-aria-pressed="index == self.graph.pinSelected" data-event-click="emit('StudioGraphMemberAction','select',index,'',self.graph.document,self.graph.revision)"><span>{{ self.graph.callablePins[index].name }}</span><span class="meta">{{ self.graph.callablePins[index].result ? 'Output' : 'Input' }} · {{ self.graph.callablePins[index].type }}</span></button>
          <div class="graph-refactor-actions"><button class="btn sm" data-event-click="emit('StudioGraphMemberAction','pinsPrevious',0,'',self.graph.document,self.graph.revision)">Previous</button><button class="btn sm" data-event-click="emit('StudioGraphMemberAction','pinsNext',0,'',self.graph.document,self.graph.revision)">Next</button></div>
          <label class="field text"><span class="part label">Pin name</span><input class="part value" type="text" data-attr-value="self.graph.pinName" data-event-change="emit('StudioGraphMemberAction','name',0,ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></label>
          <label class="field text"><span class="part label">Exact type</span><input class="part value" type="text" data-attr-value="self.graph.pinType" data-event-change="emit('StudioGraphMemberAction','type',0,ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></label>
          <label class="field text"><span class="part label">Default value</span><input class="part value" type="text" data-attr-value="self.graph.pinValue" data-event-change="emit('StudioGraphMemberAction','value',0,ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></label>
          <div class="graph-refactor-actions" data-if="self.graph.dialect == 'kdl'"><button class="btn sm" data-attr-aria-pressed="self.graph.pinContainer == 0" data-event-click="emit('StudioGraphMemberAction','container',0,'',self.graph.document,self.graph.revision)">Single</button><button class="btn sm" data-attr-aria-pressed="self.graph.pinContainer == 1" data-event-click="emit('StudioGraphMemberAction','container',1,'',self.graph.document,self.graph.revision)">Array</button><button class="btn sm" data-attr-aria-pressed="self.graph.pinContainer == 2" data-event-click="emit('StudioGraphMemberAction','container',2,'',self.graph.document,self.graph.revision)">Set</button></div>
          <button class="btn sm" data-event-click="emit('StudioGraphMemberAction','result',0,'',self.graph.document,self.graph.revision)">{{ self.graph.pinResult ? 'Output pin' : 'Input pin' }}</button>
          <div class="graph-refactor-actions"><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','add',0,'',self.graph.document,self.graph.revision)">Add pin</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','remove',0,'',self.graph.document,self.graph.revision)">Remove</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','rename',0,'',self.graph.document,self.graph.revision)">Rename</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','retype',0,'',self.graph.document,self.graph.revision)">Apply type</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','default',0,'',self.graph.document,self.graph.revision)">Apply default</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','up',0,'',self.graph.document,self.graph.revision)">Move up</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','down',0,'',self.graph.document,self.graph.revision)">Move down</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','pure',0,'',self.graph.document,self.graph.revision)">Toggle pure</button></div>
          <button class="btn sm" data-event-click="emit('StudioGraphMemberAction','typeToggle',0,'',self.graph.document,self.graph.revision)">Choose a type</button><div data-when="self.graph.typePickerOpen"><div class="field search"><input class="part value" type="search" aria-label="Search types" data-attr-value="self.graph.typeQuery" data-event-input="emit('StudioGraphMemberAction','typeQuery',0,ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div><button class="menu-item" data-for="index : self.graph.shownTypes" data-event-click="emit('StudioGraphMemberAction','chooseType',index,'',self.graph.document,self.graph.revision)">{{ self.graph.callableTypes[index].name }}</button><button class="btn sm" data-event-click="emit('StudioGraphMemberAction','typePrevious',0,'',self.graph.document,self.graph.revision)">Previous types</button><button class="btn sm" data-event-click="emit('StudioGraphMemberAction','typeNext',0,'',self.graph.document,self.graph.revision)">More types</button></div>
        </div>
      </section>
      <section class="panel" data-when="self.graph.selected &gt;= 0 &amp;&amp; self.graph.selected &lt; self.graph.nodeCount" data-open><header class="panel-head"><span class="title">Selected node</span></header><div class="panel-body graph-refactor-actions"><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','disabled',0,'',self.graph.document,self.graph.revision)">Enable / disable</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','breakpoint',0,'',self.graph.document,self.graph.revision)">Toggle breakpoint</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','fold',0,'',self.graph.document,self.graph.revision)">Fold / expand inputs</button><button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphMemberAction','advanced',0,'',self.graph.document,self.graph.revision)">Advanced pins</button></div></section>
      <section class="panel" data-if="self.graph.dialect != 'kdl' &amp;&amp; self.graph.scopeEditable" data-attrif-data-open="self.graph.signatureOpen">
        <button class="panel-head" data-attr-aria-expanded="self.graph.signatureOpen ? 'true' : 'false'" data-event-click="emit('StudioGraphAction','signatureToggle','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"><span class="icon chev">&#xeab4;</span><span class="title">Function signature</span></button>
        <div class="panel-body" data-if="self.graph.signatureOpen">
          <p class="meta">{{ self.graph.scopeSignature }}</p>
          <label class="section-label">Parameters and results</label>
          <div class="field text"><input class="part value" type="text" aria-label="Replacement callable signature" placeholder="(Value: float) -&gt; float" data-attr-value="self.graph.signatureDraft" data-event-change="emit('StudioGraphAction','signatureDraft',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
          <button class="btn outline sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','signature','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Apply signature</button>
          <button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','scopeDisabled','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">{{ self.graph.scopeDisabled ? 'Enable function' : 'Disable function' }}</button>
        </div>
      </section>
      <section class="panel" data-if="self.graph.dialect != 'kdl' &amp;&amp; self.graph.selected >= 0" data-attrif-data-open="self.graph.refactorOpen">
        <button class="panel-head" data-attr-aria-expanded="self.graph.refactorOpen ? 'true' : 'false'" data-event-click="emit('StudioGraphAction','refactorToggle','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"><span class="icon chev">&#xeab4;</span><span class="title">Refactor selection</span></button>
        <div class="panel-body" data-if="self.graph.refactorOpen">
          <div class="field text"><input class="part value" type="text" aria-label="Result or extracted callable name" data-attr-value="self.graph.memberName" data-event-change="emit('StudioGraphAction','memberName',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
          <div class="graph-refactor-actions">
            <button class="btn outline sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','nameValue','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Name result</button>
            <button class="btn outline sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','extractFunction','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Extract function</button>
            <button class="btn outline sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','extractMacro','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Extract macro</button>
            <button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','inline','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Inline call</button>
            <button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','wrapIf','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Wrap in if</button>
            <button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','wrapWhile','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Wrap in while</button>
            <button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','wrapSequence','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Wrap in sequence</button>
          </div>
        </div>
      </section>
      <div data-when="self.graph.selected >= 0 &amp;&amp; self.graph.selected &lt; self.graph.nodes.size">
        <strong>{{ self.graph.nodes[self.graph.selected].label }}</strong>
        <div class="graph-refactor-actions" data-if="self.graph.dialect == 'chibi'"><button class="btn sm" data-event-click="emit('StudioGraphAction','goToDefinition','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Go to definition</button><button class="btn sm" data-event-click="emit('StudioGraphAction','findReferences','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Find references</button><button class="btn sm" data-event-click="emit('StudioGraphAction','callHierarchy','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Call hierarchy</button></div>
        <button class="btn sm" data-if="self.graph.dialect == 'chibi'" data-event-click="emit('StudioGraphAction','duplicate','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Duplicate</button>
        <button class="btn sm" data-event-click="emit('StudioGraphAction', 'delete' , '', self.graph.document, self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Delete statement</button>
      </div>
      <div data-when="self.graph.port >= 0 &amp;&amp; self.graph.port &lt; self.graph.ports.size">
        <span class="section-label">{{ self.graph.ports[self.graph.port].label }}</span>
        <span class="meta">{{ self.graph.ports[self.graph.port].type }}</span>
        <div class="graph-port-fields" data-if="self.graph.dialect == 'kdl'">
          <div data-if="self.graph.portColorWidth &gt;= 3"><use ui="ColorField" data-attr-value="self.graph.portColor" aria-label="Choose display color" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-change="emit('StudioGraphAction','portColor',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/><span class="meta">Linear color · numeric channels preserve HDR</span></div>
          <div class="graph-port-field" data-for="field, index : self.graph.portFields">
            <label>{{ field.label }} <span class="meta">{{ field.unit }}</span></label>
            <use ui="Select" data-if="self.graph.portFieldEnums[index]" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"><select data-attr-aria-label="field.label" data-value="field.value" data-attrif-disabled="!field.editable || self.graph.busy || self.graph.readonly" data-event-change="emit('StudioGraphFieldValue',index,self.graph.document,self.graph.revision,ev.value)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"><option data-for="choice : self.graph.portChoices" data-if="choice.path == field.path" data-attr-value="choice.value">{{ choice.label }}</option></select></use>
            <use ui="Checkbox" data-if="!self.graph.portFieldEnums[index] &amp;&amp; field.type == 'bool'" data-attr-aria-label="field.label" data-attrif-checked="field.value == 'true'" data-attrif-disabled="!field.editable || self.graph.busy || self.graph.readonly" data-event-change="emit('StudioGraphFieldValue',index,self.graph.document,self.graph.revision,ev.value ? 'true' : 'false')" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
            <use ui="NumberField" data-if="!self.graph.portFieldEnums[index] &amp;&amp; (field.type == 'float' || field.type == 'double' || field.type == 'int')" data-attrif-integer="field.type == 'int'" data-attrif-float="field.type != 'int'" data-attr-value="field.value" data-attr-min="field.range ? field.min : ''" data-attr-max="field.range ? field.max : ''" data-attr-aria-label="field.label" data-attrif-disabled="!field.editable || self.graph.busy || self.graph.readonly" data-event-change="emit('StudioGraphFieldNumber',index,self.graph.document,self.graph.revision,ev.value)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
            <div class="field text" data-if="!self.graph.portFieldEnums[index] &amp;&amp; field.type != 'bool' &amp;&amp; field.type != 'float' &amp;&amp; field.type != 'double' &amp;&amp; field.type != 'int'"><input class="part value" type="text" data-attr-aria-label="field.label" data-attr-value="self.graph.portFieldTexts[index]" data-attrif-disabled="!field.editable || self.graph.busy || self.graph.readonly" data-event-change="emit('StudioGraphFieldValue',index,self.graph.document,self.graph.revision,ev.value)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
          </div>
          <button class="btn sm" data-if="self.graph.portFieldsTotal &gt; 7" data-attrif-disabled="self.graph.portFieldsFirst == 0" data-event-click="emit('StudioGraphAction','fieldPrevious','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Previous fields</button><button class="btn sm" data-if="self.graph.portFieldsTotal &gt; 7" data-attrif-disabled="self.graph.portFieldsFirst + 7 &gt;= self.graph.portFieldsTotal" data-event-click="emit('StudioGraphAction','fieldNext','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Next fields</button>
        </div>
        <div class="graph-observation" data-if="self.graph.observationsOpen" data-attr-data-available="self.graph.observationAvailable"><span class="section-label">Retained observation</span><span>{{ self.graph.observation }}</span><span class="meta" data-if="self.graph.observationRetired">Retired debug session</span></div>
        <div data-if="self.graph.dialect != 'kdl' || self.graph.portFieldsTotal == 0">
        <use ui="NumberField" data-if="self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[self.graph.port].editable &amp;&amp; (self.graph.ports[self.graph.port].type == 'float' || self.graph.ports[self.graph.port].type == 'double' || self.graph.ports[self.graph.port].type == 'int')" data-attrif-integer="self.graph.ports[self.graph.port].type == 'int'" data-attrif-float="self.graph.ports[self.graph.port].type != 'int'" data-attr-step="self.graph.ports[self.graph.port].type == 'int' ? 1 : 0.01" data-attr-value="self.graph.ports[self.graph.port].number" data-attr-aria-label="self.graph.ports[self.graph.port].label" data-event-change="emit('StudioGraphNumber',self.graph.port,self.graph.document,self.graph.revision,ev.value)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
        <use ui="Checkbox" data-if="self.graph.ports[self.graph.port].editable &amp;&amp; self.graph.ports[self.graph.port].type == 'bool'" data-attrif-checked="self.graph.ports[self.graph.port].boolean" data-event-change="emit('StudioGraphValue',self.graph.port,self.graph.document,self.graph.revision,ev.value ? 'true' : 'false')" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
        <div class="field text" data-if="!self.graph.ports[self.graph.port].output &amp;&amp; !self.graph.ports[self.graph.port].flow &amp;&amp; !(self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[self.graph.port].editable &amp;&amp; ((self.graph.ports[self.graph.port].type == 'float' || self.graph.ports[self.graph.port].type == 'double' || self.graph.ports[self.graph.port].type == 'int') || self.graph.ports[self.graph.port].type == 'bool'))">
          <input class="part value" type="text" placeholder="Expression or property path" aria-label="Input source expression" data-attr-value="self.graph.dialect == 'kdl' &amp;&amp; self.graph.ports[self.graph.port].type != 'const char *' &amp;&amp; self.graph.ports[self.graph.port].type != 'name' &amp;&amp; self.graph.ports[self.graph.port].type != 'string' ? self.graph.ports[self.graph.port].value : self.graph.ports[self.graph.port].text" data-event-change="emit('StudioGraphValue', self.graph.port, self.graph.document, self.graph.revision, ev.value)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
        </div>
        </div>
        <div data-if="self.graph.dialect == 'chibi' &amp;&amp; !self.graph.ports[self.graph.port].output &amp;&amp; !self.graph.ports[self.graph.port].flow">
          <span class="section-label">Bind input</span>
          <div class="field text"><input class="part value" type="search" aria-label="Search input bindings" placeholder="State, component or global" data-attr-value="self.graph.bindingsQuery" data-event-input="emit('StudioGraphAction','bindingsQuery',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
          <div class="graph-palette-results"><button class="graph-choice btn sm" data-for="binding, index : self.graph.bindings" data-attrif-disabled="!binding.compatible || self.graph.busy || self.graph.readonly" data-attr-data-tip="binding.type" data-event-click="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','binding',index,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">{{ binding.label }}</button></div>
          <button class="btn sm" data-attrif-disabled="self.graph.bindingsFirst == 0" data-event-click="emit('StudioGraphAction','bindingsPrevious','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Previous</button><button class="btn sm" data-attrif-disabled="self.graph.bindingsFirst + 7 &gt;= self.graph.bindingsTotal" data-event-click="emit('StudioGraphAction','bindingsNext','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Next</button>
        </div>
        <div class="graph-palette-results" data-if="self.graph.dialect == 'chibi'">
          <button class="graph-choice btn sm" data-for="suggestion, index : self.graph.portCompletions" data-attr-data-tip="suggestion.detail" data-event-click="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','completion',index,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">{{ suggestion.label }}</button>
        </div>
        <button class="btn sm" data-if="!self.graph.ports[self.graph.port].output" data-event-click="emit('StudioGraphAction', 'disconnect', '', self.graph.document, self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Disconnect input</button>
      </div>
      <section class="panel" data-attrif-data-open="self.graph.notesOpen">
        <button class="panel-head" data-attr-aria-expanded="self.graph.notesOpen ? 'true' : 'false'" data-event-click="emit('StudioGraphAction','notesToggle','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"><span class="icon chev">&#xeab4;</span><span class="title">Notes and groups</span></button>
        <div class="panel-body" data-if="self.graph.notesOpen">
          <button class="btn sm" data-attrif-disabled="self.graph.selected &lt; 0 || self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','noteNew','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Comment node</button>
          <button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','boxNew','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">New group</button>
          <div class="graph-note-list"><button class="btn ghost sm" data-for="note : self.graph.noteSlots" data-event-click="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','note',note,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">{{ self.graph.notes[note].title }}</button></div>
          <div data-if="self.graph.noteNode != '0' || self.graph.noteIsBox">
            <div class="field text"><input class="part value" type="text" aria-label="Graph note text" data-attr-value="self.graph.noteText" data-event-change="emit('StudioGraphAction','noteText',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/></div>
            <button class="btn sm" data-if="!self.graph.noteIsBox" data-attr-aria-pressed="self.graph.noteHidden" data-event-click="emit('StudioGraphAction','noteHidden','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">{{ self.graph.noteHidden ? 'Show on canvas' : 'Hide on canvas' }}</button>
            <div data-if="self.graph.noteIsBox">
              <use ui="NumberField" float addon="X" aria-label="Group X" data-attr-value="self.graph.noteX" data-event-change="emit('StudioGraphPresentationNumber','x',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
              <use ui="NumberField" float addon="Y" aria-label="Group Y" data-attr-value="self.graph.noteY" data-event-change="emit('StudioGraphPresentationNumber','y',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
              <use ui="NumberField" float addon="Width" aria-label="Group Width" data-attr-value="self.graph.noteWidth" data-event-change="emit('StudioGraphPresentationNumber','width',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
              <use ui="NumberField" float addon="Height" aria-label="Group Height" data-attr-value="self.graph.noteHeight" data-event-change="emit('StudioGraphPresentationNumber','height',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
            </div>
            <div data-if="self.graph.noteIsBox"><label>Group color</label><use ui="ColorField" data-attr-value="self.graph.noteColor" aria-label="Group frame color" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-change="emit('StudioGraphAction','noteColor',ev.value,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/><button class="btn sm" data-attrif-disabled="self.graph.noteDefaultColor" data-event-click="emit('StudioGraphAction','noteDefaultColor','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Use theme color</button></div>
            <button class="btn outline sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','noteSave','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Save note</button>
            <button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','noteRemove','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Remove</button>
          </div>
        </div>
      </section>
      <section class="panel" data-if="self.graph.selectedEdge >= 0 || !self.graph.empty" data-attrif-data-open="self.graph.routesOpen">
        <button class="panel-head" data-attr-aria-expanded="self.graph.routesOpen ? 'true' : 'false'" data-event-click="emit('StudioGraphAction','routesToggle','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()"><span class="icon chev">&#xeab4;</span><span class="title">Wire route</span></button>
        <div class="panel-body" data-if="self.graph.routesOpen">
          <div class="graph-note-list"><button class="btn ghost sm" data-for="route : self.graph.routeSlots" data-event-click="emit('StudioPaneFocus', pane, 'graph', false); emit('StudioGraphPointer','route',route,self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Point {{ self.graph.routes[route].index + 1 }}</button></div>
          <div data-if="self.graph.selectedEdge >= 0">
            <use ui="NumberField" float addon="X" aria-label="Wire point X" data-attr-value="self.graph.routeX" data-event-change="emit('StudioGraphPresentationNumber','routeX',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
            <use ui="NumberField" float addon="Y" aria-label="Wire point Y" data-attr-value="self.graph.routeY" data-event-change="emit('StudioGraphPresentationNumber','routeY',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', true); stop()" data-event-mousedown="emit('StudioPaneFocus', pane, 'graph', true); stop()"/>
            <button class="btn outline sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','routeAdd','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Add point</button>
            <button class="btn sm" data-attrif-disabled="self.graph.routeSelected &lt; 0 || self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','routeSave','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Move point</button>
            <button class="btn sm" data-attrif-disabled="self.graph.routeSelected &lt; 0 || self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','routeRemove','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Remove point</button>
            <button class="btn sm" data-attrif-disabled="self.graph.busy || self.graph.readonly" data-event-click="emit('StudioGraphAction','routeClear','',self.graph.document,self.graph.revision)" data-event-focus="emit('StudioPaneFocus', pane, 'graph', false); stop()">Clear route</button>
          </div>
        </div>
      </section>
      <div class="graph-diagnostic" data-for="diagnostic : self.graph.diagnostics"><span class="icon">&#xea87;</span>{{ diagnostic.line }}:{{ diagnostic.column }} {{ diagnostic.message }}</div>
    </aside>
  </div>
  <footer class="graph-status" role="status">{{ self.graph.notice }}<span class="graph-activity-status" data-if="self.graph.activityStatus != ''">{{ self.graph.activityStatus }}</span></footer>
</div>
