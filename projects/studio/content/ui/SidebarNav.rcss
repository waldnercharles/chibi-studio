/* A settings sidebar, as VS Code's table of contents and macOS's Settings.
   Each item is <label class="nav-item"><input type="radio" .../><span
   class="nav-face">icon, label, count</span></label>; its radio takes
   focus. Bind data-keys="Up:NavPrevious Down:NavNext" on the use and give
   the entity NavKeys, so the arrows choose as they move. */
.sidebar-nav { display: flex; flex-direction: column; gap: 1dp; }
.nav-item { position: relative; display: flex; cursor: pointer; }
.nav-item input { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; opacity: 0; nav: none; cursor: pointer; }
.nav-face {
  display: flex; align-items: center; gap: 8dp; flex: 1 1 auto; height: var(--row); padding: 0dp 8dp;
  border-radius: var(--r); border: 1dp transparent; color: var(--muted-foreground); white-space: nowrap;
  transition: background-color color 0.11s cubic-out;
}
.nav-face .label { flex: 1 1 auto; }
.nav-item:hover .nav-face { background-color: var(--accent); color: var(--foreground); }
.nav-item input:checked ~ .nav-face { background-color: var(--selected); color: var(--foreground); }
.nav-item input:checked ~ .nav-face .icon { color: var(--primary-text); }
.nav-item input:focus-visible ~ .nav-face { border-color: var(--ring); }
.nav-item.dim .nav-face, .nav-item.dim input:checked ~ .nav-face { color: var(--disabled-foreground); }
.nav-item.dim .nav-face .icon, .nav-item.dim input:checked ~ .nav-face .icon { color: var(--disabled-foreground); }
.nav-face .count {
  height: var(--studio-height-16, 16dp); line-height: var(--studio-line-16, 16dp); padding: 0dp 5dp; border-radius: 8dp; font-size: var(--studio-font-10, 10dp);
  color: var(--primary-text); background-color: var(--primary-soft);
}
.nav-face .dot { width: 6dp; height: 6dp; border-radius: 3dp; background-color: var(--override); }
