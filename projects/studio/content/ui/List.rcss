/* A virtualized authored list: a scroll viewport, a spacer for the full
   collection height, and a window of fixed-height rows. Give the viewport an
   id, data-measure and data-event-scroll so its .chibi owner can publish the
   visible rows and spacer height from the current viewport geometry. */
body { display: block; height: 100%; }
.list { display: block; overflow-y: auto; height: 100%; }
.list-spacer { display: block; position: relative; box-sizing: border-box; }
