<use ui="Menu" id="graph-menu">
  <use ui="MenuGroup" data-if="graph_menu.group.label != ''" data-alias-group="graph_menu.group"/>
  <div class="graph-menu-entry" data-for="entry : graph_menu.items">
    <use ui="MenuSeparator" data-if="entry.sep"/>
    <use ui="MenuItem" data-when="!entry.sub" data-alias-item="entry" data-attr-data-tip="entry.label" data-attr-data-tip-about="entry.about" data-attrif-data-current="entry.current" data-event-click="emit('graph_menu.run', entry.key)"></use>
    <use ui="Submenu" data-when="entry.sub" data-alias-item="entry">
      <div class="graph-menu-entry" data-for="child : entry.items">
        <use ui="MenuSeparator" data-if="child.sep"/>
        <use ui="MenuItem" data-when="!child.sub &amp;&amp; child.swatch == ''" data-alias-item="child" data-attr-data-tip="child.label" data-attr-data-tip-about="child.about" data-attrif-data-current="child.current" data-event-click="emit('graph_menu.run', child.key)"></use>
        <div class="menu-item" role="menuitem" data-when="!child.sub &amp;&amp; child.swatch != ''" data-attrif-data-disabled="child.disabled" data-attrif-data-current="child.current" data-event-click="emit('graph_menu.run', child.key)"><span class="icon lead" data-style-color="child.swatch">{{ child.icon }}</span><span class="text"><span class="label">{{ child.label }}</span></span></div>
        <use ui="Submenu" data-when="child.sub" data-alias-item="child">
          <div class="graph-menu-entry" data-for="leaf : child.items">
            <use ui="MenuSeparator" data-if="leaf.sep"/>
            <use ui="MenuItem" data-when="leaf.swatch == ''" data-alias-item="leaf" data-attr-data-tip="leaf.label" data-attr-data-tip-about="leaf.about" data-attrif-data-current="leaf.current" data-event-click="emit('graph_menu.run', leaf.key)"></use>
            <div class="menu-item" role="menuitem" data-when="leaf.swatch != ''" data-attrif-data-disabled="leaf.disabled" data-attrif-data-current="leaf.current" data-event-click="emit('graph_menu.run', leaf.key)"><span class="icon lead" data-style-color="leaf.swatch">{{ leaf.icon }}</span><span class="text"><span class="label">{{ leaf.label }}</span></span></div>
          </div>
        </use>
      </div>
    </use>
  </div>
</use>
