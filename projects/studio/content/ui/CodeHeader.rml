<span class="dim" data-if="code_header.mode == 0">No file open</span>
<div class="code-head" data-if="code_header.mode == 1">
  <div class="code-history">
    <button class="btn sm icon-only" data-tip="Back" data-attr-data-kbd="code_header.backKbd" data-attrif-data-disabled="!code_header.back" data-event-click="emit('code_header.back')"><span class="icon">&#xea9b;</span></button>
    <button class="btn sm icon-only" data-tip="Forward" data-attr-data-kbd="code_header.forwardKbd" data-attrif-data-disabled="!code_header.forward" data-event-click="emit('code_header.forward')"><span class="icon">&#xea9c;</span></button>
  </div>
  <div class="code-file">
    <span class="name">{{ code_header.title }}</span>
    <div class="dirty-dot" data-if="code_header.dirty" data-tip="Unsaved" data-attr-data-kbd="commands.save.shortcut"></div>
  </div>
  <div class="segmented" data-if="code_header.behavior && (code_header.view != 2 || code_header.sourceOnly)" data-tip="Behavior view">
    <button class="seg" data-attrif-data-pressed="code_header.view == 0" data-attrif-data-disabled="code_header.sourceOnly" data-event-click="emit('code_header.view', 0)">Graph</button>
    <button class="seg" data-attrif-data-pressed="code_header.view == 1" data-event-click="emit('code_header.view', 1)">Code</button>
    <button class="seg" data-attrif-data-pressed="code_header.view == 2" data-attrif-data-disabled="code_header.sourceOnly" data-event-click="emit('code_header.view', 2)">Both</button>
  </div>
  <span class="dim code-runtime" data-if="code_header.runtimeLabel != '' && code_header.error == ''" data-tip="Runtime status" data-attr-data-tip-about="code_header.runtime">{{ code_header.runtimeLabel }}</span>
  <div class="code-problem" data-if="code_header.error != ''"><span class="icon">&#xea87;</span><span data-tip="Keeps the last valid version" data-attr-data-tip-about="code_header.error">Invalid</span></div>
  <div class="spacer"></div>
  <button class="btn icon-only" data-tip="Find" data-attr-data-kbd="commands.find.shortcut" data-attr-data-state="code_header.find ? 'on' : ''" data-event-click="emit('code_header.find')"><span class="icon">&#xea6d;</span></button>
  <button class="btn icon-only" data-tip="Rename Symbol" data-attr-data-kbd="commands.renameSymbol.shortcut" data-attrif-data-disabled="!code_header.rename" data-event-click="emit('studio.renameSymbol')"><span class="icon">&#xea73;</span></button>
  <button class="btn icon-only" data-tip="Show Call Hierarchy" data-attr-data-kbd="commands.callHierarchy.shortcut" data-attrif-data-disabled="!code_header.calls" data-event-click="emit('studio.callHierarchy')"><span class="icon">&#xeb92;</span></button>
  <span class="code-mode" data-if="code_header.vim != ''" data-tip="Vim mode">{{ code_header.vim }}</span>
  <button class="btn sm code-problems" data-class-errors="code_header.errors > 0" data-class-clear="code_header.problems == 0" data-attr-data-tip="code_header.problemsTip" data-attr-data-kbd="commands.nextProblem.shortcut" data-attrif-data-disabled="code_header.problems == 0" data-event-click="emit('studio.nextProblem')"><span class="icon" data-if="code_header.problems == 0">&#xeab2;</span><span class="icon" data-if="code_header.errors > 0">&#xea87;</span><span class="icon" data-if="code_header.problems > code_header.errors && code_header.errors == 0">&#xea6c;</span><span class="label">{{ code_header.problems }}</span></button>
  <button class="btn icon-only" data-tip="Save" data-attr-data-kbd="commands.save.shortcut" data-event-click="emit('code_header.save')"><span class="icon">&#xeb4b;</span></button>
  <div class="segmented" data-tip="Apply edits" data-tip-about="Live applies each valid edit as you type; On Save waits for the file">
    <button class="seg" data-attrif-data-pressed="code_header.live" data-event-click="emit('code_header.apply', 0)">Live</button>
    <button class="seg" data-attrif-data-pressed="!code_header.live" data-event-click="emit('code_header.apply', 1)">On Save</button>
  </div>
</div>
<div class="code-head" data-if="code_header.mode == 2">
  <div class="code-history">
    <button class="btn sm icon-only" data-tip="Back" data-attr-data-kbd="code_header.backKbd" data-attrif-data-disabled="!code_header.back" data-event-click="emit('code_header.back')"><span class="icon">&#xea9b;</span></button>
    <button class="btn sm icon-only" data-tip="Forward" data-attr-data-kbd="code_header.forwardKbd" data-attrif-data-disabled="!code_header.forward" data-event-click="emit('code_header.forward')"><span class="icon">&#xea9c;</span></button>
  </div>
  <div class="code-parts" data-if="code_header.parts">
    <div class="segmented">
      <button class="seg" data-attrif-data-pressed="code_header.part == 0" data-event-click="emit('code_header.part', 0)">RML</button>
      <button class="seg" data-attrif-data-pressed="code_header.part == 1" data-event-click="emit('code_header.part', 1)">RCSS</button>
    </div>
  </div>
  <div class="code-file">
    <span class="icon">{{ code_header.icon }}</span>
    <span class="name" data-attr-data-tip="code_header.path">{{ code_header.name }}</span>
    <div class="dirty-dot" data-if="code_header.dirty" data-tip="Unsaved" data-attr-data-kbd="commands.save.shortcut"></div>
  </div>
  <div class="code-problem" data-if="code_header.error != ''"><span class="icon">&#xea87;</span><span data-tip="Keeps the last valid version" data-attr-data-tip-about="code_header.error">Invalid</span></div>
  <div class="spacer"></div>
  <button class="btn icon-only" data-tip="Find" data-attr-data-kbd="commands.find.shortcut" data-attr-data-state="code_header.find ? 'on' : ''" data-event-click="emit('code_header.find')"><span class="icon">&#xea6d;</span></button>
  <span class="code-mode" data-if="code_header.vim != ''" data-tip="Vim mode">{{ code_header.vim }}</span>
  <button class="btn sm code-problems" data-class-errors="code_header.errors > 0" data-class-clear="code_header.problems == 0" data-attr-data-tip="code_header.problemsTip" data-attr-data-kbd="commands.nextProblem.shortcut" data-attrif-data-disabled="code_header.problems == 0" data-event-click="emit('studio.nextProblem')"><span class="icon" data-if="code_header.problems == 0">&#xeab2;</span><span class="icon" data-if="code_header.errors > 0">&#xea87;</span><span class="icon" data-if="code_header.problems > code_header.errors && code_header.errors == 0">&#xea6c;</span><span class="label">{{ code_header.problems }}</span></button>
  <div class="code-apply">
    <div class="segmented" data-tip="Apply edits" data-tip-about="Live applies each valid edit as you type; On Save waits for the file">
      <button class="seg" data-attrif-data-pressed="code_header.live" data-event-click="emit('code_header.apply', 0)">Live</button>
      <button class="seg" data-attrif-data-pressed="!code_header.live" data-event-click="emit('code_header.apply', 1)">On Save</button>
    </div>
  </div>
</div>
