        await set_ui_data(Name: "sceneRuntime.canEdit", Value: CanTransform())
        await set_ui_data(Name: "sceneRuntime.proposing", Value: ProposalPending)
        await set_ui_data(Name: "sceneRuntime.snap", Value: Snap)
        await set_ui_data(Name: "sceneRuntime.grab", Value: Grab)
        await set_ui_data(Name: "sceneRuntime.boxVisible", Value: BoxActive || BoxScanning)
        await set_ui_data(Name: "sceneRuntime.boxScanning", Value: BoxScanning)
        await set_ui_data(Name: "sceneRuntime.boxProgress", Value: BoxScan)
        await set_ui_data(Name: "sceneRuntime.boxStyle", Value: format_text("left: {}dp; top: {}dp; width: {}dp; height: {}dp;", min(BoxStartX, BoxX), min(BoxStartY, BoxY), abs(BoxX - BoxStartX), abs(BoxY - BoxStartY)))
        await set_ui_data(Name: "sceneRuntime.markerStyles", Value: MarkerStyles)
        await set_ui_data(Name: "sceneRuntime.markerNames", Value: MarkerNames)
        await set_ui_data(Name: "sceneRuntime.markerLocked", Value: MarkerLocked)
