        await set_ui_data(Name: "sceneRuntime.evidenceState", Value: EvidenceState)
        await set_ui_data(Name: "sceneRuntime.evidenceError", Value: EvidenceError)
        await set_ui_data(Name: "sceneRuntime.gizmoVisible", Value: GizmoVisible)
        await set_ui_data(Name: "sceneRuntime.gizmoOriginStyle", Value: format_text("left: {}dp; top: {}dp;", GizmoX - 3.0, GizmoY - 3.0))
        await set_ui_data(Name: "sceneRuntime.document", Value: Document)
        await set_ui_data(Name: "sceneRuntime.session", Value: Session)
        await set_ui_data(Name: "sceneRuntime.ready", Value: Ready)
        await set_ui_data(Name: "sceneRuntime.current", Value: RuntimeCurrent())
        await set_ui_data(Name: "sceneRuntime.preparing", Value: Preparing)
        await set_ui_data(Name: "sceneRuntime.playing", Value: Playing)
        await set_ui_data(Name: "sceneRuntime.image", Value: Image)
        await set_ui_data(Name: "sceneRuntime.error", Value: Error)
        await set_ui_data(Name: "sceneRuntime.toolError", Value: ToolError)
        await set_ui_data(Name: "sceneRuntime.perspective", Value: Perspective)
        await set_ui_data(Name: "sceneRuntime.local", Value: Local)
        await set_ui_data(Name: "sceneRuntime.log", Value: Log)
