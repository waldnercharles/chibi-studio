        await set_ui_data(Name: "sceneRuntime.colliders", Value: Colliders)
        await set_ui_data(Name: "sceneRuntime.cameras", Value: Cameras)
        for id in PresentationCommands {
            await send_event<"StudioCommandAvailability">(self, id, Ready)
        }
        await set_ui_data(Name: "sceneRuntime.grid", Value: Grid)
        await set_ui_data(Name: "sceneRuntime.selected", Value: length(Selection))
        await set_ui_data(Name: "sceneRuntime.span", Value: Span)
        runtime_source := RuntimeDocument
        if TargetPreview {
            runtime_source = 0
        }
        await send_event<"StudioRuntimeState">(self, Session, Ready, Playing, runtime_source, RuntimeRevision, Steps)
        await send_event<"StudioCommandAvailability">(self, "play", (TargetPreview && PreviewDocument > 0) || (!TargetPreview && (Ready || Document > 0)))
        await send_event<"StudioCommandAvailability">(self, "stop", Ready)
        await send_event<"StudioCommandAvailability">(self, "step", Ready && !Playing)
        await send_event<"StudioCommandAvailability">(self, "resetCamera", Ready)
        await send_event<"StudioCommandAvailability">(self, "frame", Ready && ((ModelPreview() && RuntimeCurrent()) || (!TargetPreview && RuntimeDocument == Document && RuntimeRevision == Revision && length(Selection) > 0)))
        await send_event<"StudioCommandAvailability">(self, "frameAll", Ready && ((ModelPreview() && RuntimeCurrent()) || (!TargetPreview && RuntimeDocument == Document && RuntimeRevision == Revision)))
        await send_event<"StudioCommandAvailability">(self, "toggleGrid", Ready && !Perspective)
        for id in ToolCommands {
            await send_event<"StudioCommandAvailability">(self, id, Document > 0 && !Playing && CanTransform())
        }
    }
    IsObject :: pure fn(Index: int) -> bool {
        if Index == 0 {
            return true
        }
        row := Fields[Index]
        if !text_equal(row.type, "object") || row.parent < 0 {
            return false
        }
        name := Fields[row.parent].name
        return text_equal(name, "entities") || text_equal(name, "children")
    }
    ParentOf :: pure fn(Index: int) -> int {
        index := Fields[Index].parent
        while index >= 0 {
            if IsObject(index) {
                return index
            }
            index = Fields[index].parent
        }
        return -1
    }
    NameOf :: pure fn(Index: int) -> string {
        i := Index + 1
        while i < length(Fields) {
            if Fields[i].depth <= Fields[Index].depth {
                break
            }
            if Fields[i].parent == Index && text_equal(Fields[i].name, "name") {
                return Fields[i].text
            }
            i += 1
        }
        return ""
    }
    Matches :: pure fn(Runtime: int, Field: int) -> bool {
        r := Runtime
        f := Field
        while r >= 0 && f > 0 {
            if !text_equal(Names[r], NameOf(f)) {
                return false
            }
            r = Parents[r]
            f = ParentOf(f)
        }
        return r < 0 && f <= 0
    }
    SourceField :: pure fn(Runtime: int) -> int {
        r := Runtime
        while r >= 0 {
            for field in Objects {
                if field > 0 && Matches(r, field) {
                    return field
                }
            }
            r = Parents[r]
        }
        return -1
    }
    Under :: pure fn(Field: int, Paths: string[]) -> bool {
        f := Field
        while f >= 0 {
            if contains(Paths, Fields[f].path) {
                return true
            }
            f = ParentOf(f)
        }
        return false
    }
    RefreshFields :: fn() {
        if Document <= 0 {
            return
        }
        inspected := workspace_asset_inspect(Document, Revision, "scene")
        if !inspected.Ok {
            Error = inspected.Error
            return
        }
        Fields = inspected.Fields
        Objects = []
        i: int = 0
        while i < length(Fields) {
            if IsObject(i) {
                Objects = array_add(Objects, i)
            }
            i += 1
        }
    }
    Exclusions :: fn() {
        if !Ready || (RuntimeDocument != Document || RuntimeRevision != Revision) {
            return
        }
        hidden: int[] = []
        locked: int[] = []
        i: int = 0
        while i < length(Names) {
            field := SourceField(i)
            if field >= 0 {
                hide := Under(field, Hidden) || (length(Isolated) > 0 && !Under(field, Isolated))
                if hide {
                    hidden = array_add(hidden, i)
                }
                if hide || Under(field, Locked) {
                    locked = array_add(locked, i)
                }
            }
            i += 1
        }
        await workspace_runtime_skip(Session, hidden, false)
        await workspace_runtime_skip(Session, locked, true)
    }
    Prepare :: fn() {
        if Preparing || Busy || Gesture {
            NeedsPrepare = true
            return
        }
        if TargetPreview {
            preview_read := workspace_document_read(PreviewDocument)
            if !preview_read.Ok {
                Error = preview_read.Error
                await Publish()
                return
            }
            if preview_read.Transaction {
                NeedsPrepare = true
                return
            }
            PreviewRevision = preview_read.Revision
            identity := workspace_asset_identity(PreviewDocument, PreviewRevision)
            if !identity.Ok || !text_equal(identity.Kind, PreviewKind) {
                Error = "The preview source is no longer the selected asset kind"
                PlayAfterPrepare = false
                NeedsPrepare = false
                await Publish()
                return
            }
            PreviewName = identity.Name
            source := await PreviewSource()
            if text_equal(source, "") {
                Error = "This asset cannot be used as a simulation preview"
                PlayAfterPrepare = false
                NeedsPrepare = false
                await Publish()
                return
            }
            path := format_text("scenes/StudioPreview-{}-{}.kdl", PreviewDocument, PreviewRevision)
            paths: string[] = [path]
            sources: string[] = [source]
            if ModelPreview() {
                fixtures := await ModelFixtureSources()
                suffixes: string[] = ["Object", "Camera", "Key", "Fill"]
                index: int = 0
                for suffix in suffixes {
                    paths = array_add(paths, format_text("prototypes/{}.kdl", ModelFixtureName(suffix)))
                    sources = array_add(sources, fixtures[index])
                    index += 1
                }
            }
            preview := await workspace_runtime_prepare_document_sources(PreviewDocument, PreviewRevision, path, paths, sources)
            Preparing = preview.Preparing
            Error = preview.Error
            NeedsPrepare = false
            Idle = 0.0
            await Publish()
            return
        }
        if Document > 0 {
            await read()
            if !read.Ok {
                Error = read.Error
                await Publish()
                return
            }
            if read.Transaction {
                NeedsPrepare = true
                return
            }
            Revision = read.Revision
        }
        await prepare()
        Preparing = prepare.Preparing
        Error = prepare.Error
        NeedsPrepare = false
        Idle = 0.0
        await Publish()
    }
    ReleaseGuard :: fn() {
        if !Authorized {
            return
        }
        document := GuardDocument
        request := GuardRequest
        Authorized = false
        GuardWaiting = false
        GuardMode = ""
        if !CandidateMode {
            await send_event<"StudioDocumentExternalEditComplete">(self, "scene", document, request)
        }
    }
    CacheCandidate :: fn(Entity: string, Relative: string, Value: double) {
        key := format_text("{}|{}", Entity, Relative)
        keys: string[] = []
        values: double[] = []
        found := false
        i: int = 0
        while i < length(CandidateKeys) {
            keys = array_add(keys, CandidateKeys[i])
            if text_equal(CandidateKeys[i], key) {
                values = array_add(values, Value)
                found = true
            } else {
                values = array_add(values, CandidateValues[i])
            }
            i += 1
        }
        if !found {
            keys = array_add(keys, key)
            values = array_add(values, Value)
        }
        CandidateKeys = keys
        CandidateValues = values
    }
    CandidateNumber :: pure fn(Entity: string, Fields: struct<"WorkspaceAssetField">[], Relative: string) -> double {
        if CandidateMode {
            i: int = 0
            while i < length(CandidateKeys) {
                if text_equal(CandidateKeys[i], format_text("{}|{}", Entity, Relative)) {
                    return CandidateValues[i]
                }
                i += 1
            }
        }
        return Number(Fields, Relative)
    }
    StartCandidate :: fn() {
        await read()
        if !read.Ok || read.Transaction {
            ToolError = "Finish the source edit before proposing a transform"
            return
        }
        CandidateMode = true
        CandidateText = ""
        CandidateKeys = []
        CandidateValues = []
        GestureBaseRevision = read.Revision
        Revision = read.Revision
        LiveObjects = []
        LiveFields = []
        LiveComponents = []
        LiveValues = []
        Authorized = true
        Gesture = true
        Busy = false
        for entity in Selection {
            inspected := workspace_object_inspect(Document, Revision, "scene", entity)
            if !inspected.Ok {
                ToolError = inspected.Error
                await Finish(true)
                return
            }
            for group in GroupNames {
                for axis in AxisNames {
                    relative := format_text("/components/Transform3D/{}/{}", group, axis)
                    await CacheCandidate(entity, relative, Number(inspected.Fields, relative))
                }
            }
            for relative in PlanarFields {
                await CacheCandidate(entity, relative, Number(inspected.Fields, relative))
            }
        }
    }
    RequestGuard :: fn(Mode: string) {
        if GuardWaiting || Authorized || ProposalPending {
            return
        }
        if CollaborationActive {
            if text_equal(Mode, "axis") {
                if !CanTransform() {
                    ToolError = "Your room role cannot edit this source right now"
                    return
                }
                await StartCandidate()
            } else {
                if !CollaborationReady || CollaborationPending {
                    ToolError = "Wait for the room to accept its pending source update"
                    return
                }
                await Prepare()
            }
            return
        }
        CandidateMode = false
        GuardMode = Mode
        GuardDocument = ActiveDocument
        if TargetPreview && (text_equal(Mode, "prepare") || text_equal(Mode, "play")) {
            GuardDocument = PreviewDocument
        }
        GuardRequest += 1
        if GuardRequest <= 0 {
            GuardRequest = 1
        }
        PendingAmount = 0.0
        PendingEnd = false
        PendingCanceled = false
        if ActiveDocument <= 0 {
            if text_equal(Mode, "prepare") || text_equal(Mode, "play") {
                await Prepare()
            }
            return
        }
        GuardWaiting = true
        await send_event<"StudioDocumentExternalEditRequested">(self, "scene", GuardDocument, GuardRequest)
    }
    Finish :: fn(Canceled: bool) {
        Grab = false
        RayActive = false
        RayInitialized = false
        InvertSnap = false
        if CandidateMode {
            Gesture = false
            Authorized = false
            if Canceled || text_equal(CandidateText, "") {
                await RestoreLive(true)
                CandidateMode = false
                CandidateText = ""
                await Publish()
                return
            }
            if ProposalRequest >= 2147483647 {
                ToolError = "Scene edit request limit reached"
                await RestoreLive(true)
                CandidateMode = false
                CandidateText = ""
                await Publish()
                return
            }
            ProposalRequest += 1
            ProposalPending = true
            await send_event<"StudioDocumentEdit">(self, Document, GestureBaseRevision, CandidateStart, CandidateEnd, CandidateReplacement, "scene", ProposalRequest)
            await Publish()
            return
        }
        if !Gesture {
            await RestoreLive(Canceled)
            await ReleaseGuard()
            return
        }
        await read()
        if read.Ok && read.Transaction {
            Revision = read.Revision
            if Canceled {
                await cancel_edit()
                if !cancel_edit.Ok {
                    Error = cancel_edit.Error
                    await Publish()
                    return
                }
            } else {
                await commit_edit()
                if !commit_edit.Ok {
                    Error = commit_edit.Error
                    await Publish()
                    return
                }
            }
        }
        Gesture = false
        await RestoreLive(Canceled)
        await read()
        if read.Ok {
            Revision = read.Revision
        }
        await RefreshFields()
        NeedsPrepare = true
        await send_event<"StudioDocumentChanged">(self, Document)
        await ReleaseGuard()
        await Publish()
    }
    Number :: pure fn(Fields: struct<"WorkspaceAssetField">[], Path: string) -> double {
        for field in Fields {
            if text_equal(field.relative, Path) {
                return field.number
            }
        }
        return 0.0
    }
    RuntimeObject :: pure fn(Path: string) -> int {
        i: int = 0
        while i < length(Names) {
            for field in Objects {
                if text_equal(Fields[field].path, Path) && Matches(i, field) {
                    return i
                }
            }
            i += 1
        }
        return -1
    }
    LiveField :: fn(Entity: string, Relative: string, Value: double) {
        if !Ready || Playing || RuntimeDocument != Document || RuntimeRevision != GestureBaseRevision {
            return
        }
        object := RuntimeObject(Entity)
        if object < 0 {
            return
        }
        name := ""
        component := "Transform3D"
        if text_equal(Relative, "/components/Transform/x") {
            component = "Transform"
            name = "x"
        }
        if text_equal(Relative, "/components/Transform/y") {
            component = "Transform"
            name = "y"
        }
        if text_equal(Relative, "/components/Orientation/radians") {
            component = "Orientation"
            name = "radians"
        }
        if text_equal(Relative, "/components/Appearance/width") {
            component = "Appearance"
            name = "width"
        }
        if text_equal(Relative, "/components/Appearance/height") {
            component = "Appearance"
            name = "height"
        }
        for group in GroupNames {
            for axis in AxisNames {
                if text_equal(Relative, format_text("/components/Transform3D/{}/{}", group, axis)) {
                    name = format_text("{}.{}", group, axis)
                }
            }
        }
        for axis in VectorAxes {
            if text_equal(Relative, format_text("/components/Collider3D/size/{}", axis)) {
                component = "Collider3D"
                name = format_text("size.{}", axis)
            }
        }
        for name3d in GeometryFields {
            if text_equal(Relative, format_text("/components/Geometry3D/{}", name3d)) {
                component = "Geometry3D"
                name = name3d
            }
        }
        if text_equal(Relative, "/components/Collider3D/radius") {
            component = "Collider3D"
            name = "radius"
        }
        if text_equal(Relative, "/components/Collider3D/height") {
            component = "Collider3D"
            name = "height"
        }
        if text_equal(name, "") {
            return
        }
        cached := false
        i: int = 0
        while i < length(LiveObjects) {
            if LiveObjects[i] == object && text_equal(LiveComponents[i], component) && text_equal(LiveFields[i], name) {
                cached = true
            }
            i += 1
        }
        if !cached {
            current := await workspace_runtime_number(Session, object, component, name, false, 0.0)
            if !current.Ok {
                return
            }
            LiveObjects = array_add(LiveObjects, object)
            LiveFields = array_add(LiveFields, name)
            LiveComponents = array_add(LiveComponents, component)
            LiveValues = array_add(LiveValues, current.Value)
        }
        await workspace_runtime_number(Session, object, component, name, true, Value)
    }
    RestoreLive :: fn(Canceled: bool) {
        if Canceled && Ready {
            i: int = 0
            while i < length(LiveObjects) {
                await workspace_runtime_number(Session, LiveObjects[i], LiveComponents[i], LiveFields[i], true, LiveValues[i])
                i += 1
            }
        }
        LiveObjects = []
        LiveFields = []
        LiveComponents = []
        LiveValues = []
    }
    EditField :: fn(Entity: string, Relative: string, Value: double) -> bool {
        if CandidateMode {
            candidate := workspace_objects_candidate(Document, GestureBaseRevision, "scene", [Entity], Relative, "set-number", format_text("{}", Value), CandidateText)
            if !candidate.Ok {
                ToolError = candidate.Error
                return false
            }
            CandidateText = candidate.Text
            CandidateStart = candidate.Start
            CandidateEnd = candidate.End
            CandidateReplacement = candidate.Replacement
            await CacheCandidate(Entity, Relative, Value)
            await LiveField(Entity, Relative, Value)
            return true
        }
        changed := await workspace_objects_edit(Document, Revision, "scene", [Entity], Relative, "set-number", format_text("{}", Value))
        if !changed.Ok {
            ToolError = changed.Error
            return false
        }
        await read()
        if !read.Ok {
            ToolError = read.Error
            return false
        }
        Revision = read.Revision
        await LiveField(Entity, Relative, Value)
        return true
    }
    Nudge2D :: fn(Path: string, Fields: struct<"WorkspaceAssetField">[], Delta: float) -> bool {
        component := "/components/Transform"
        if text_equal(Tool, "rotate") {
            component = "/components/Orientation"
        }
        if text_equal(Tool, "scale") {
            component = "/components/Appearance"
        }
        present := false
        for field in Fields {
            if text_equal(field.relative, component) {
                present = true
            }
        }
        if !present {
            ToolError = "Add the required Transform, Orientation or Appearance component in Properties first"
            return false
        }
        if text_equal(Tool, "rotate") {
            return await EditField(Path, "/components/Orientation/radians", CandidateNumber(Path, Fields, "/components/Orientation/radians") + Delta)
        }
        if text_equal(Axis, "z") {
            return true
        }
        if text_equal(Tool, "scale") {
            relative := "/components/Appearance/width"
            if text_equal(Axis, "y") {
                relative = "/components/Appearance/height"
            }
            return await EditField(Path, relative, max(0.001, CandidateNumber(Path, Fields, relative) + Delta))
        }
        dx: double = Delta
        dy: double = 0.0
        if text_equal(Axis, "y") {
            dx = 0.0
            dy = -Delta
        }
        if Local {
            radians := CandidateNumber(Path, Fields, "/components/Orientation/radians")
            x := dx * cos(radians) - dy * sin(radians)
            dy = dx * sin(radians) + dy * cos(radians)
            dx = x
        }
        if dx != 0.0 && !await EditField(Path, "/components/Transform/x", CandidateNumber(Path, Fields, "/components/Transform/x") + dx) {
            return false
        }
        if dy != 0.0 && !await EditField(Path, "/components/Transform/y", CandidateNumber(Path, Fields, "/components/Transform/y") + dy) {
            return false
        }
        return true
    }
    Nudge :: fn(Amount: float) {
        if !Authorized || Playing || length(Selection) == 0 || Document <= 0 {
            return
        }
        if length(Selection) > 128 {
            ToolError = "Transform at most 128 objects in one gesture"
            await Finish(true)
            return
        }
        ToolError = ""
        await read()
        if !read.Ok {
            ToolError = read.Error
            return
        }
        Revision = read.Revision
        if !Gesture {
            if read.Transaction {
                ToolError = "Finish the current source edit first"
                return
            }
            await begin_edit()
            if !begin_edit.Ok {
                ToolError = begin_edit.Error
                return
            }
            Gesture = true
            await send_event<"StudioDocumentChanged">(self, Document)
        }
        delta := Amount
        if Snapping() {
            increment := Increment
            if text_equal(Tool, "rotate") {
                increment = 0.2617994
            }
            AxisCarry += Amount
            delta = round(AxisCarry / increment) * increment
            AxisCarry -= delta
        }
        if delta == 0.0 {
            return
        }
        for path in Selection {
            inspected := workspace_object_inspect(Document, Revision, "scene", path)
            if !inspected.Ok {
                ToolError = inspected.Error
                await Finish(true)
                return
            }
            if !Perspective {
                if !await Nudge2D(path, inspected.Fields, delta) {
                    await Finish(true)
                    return
                }
                continue
            }
            present := false
            for field in inspected.Fields {
                if text_equal(field.relative, "/components/Transform3D") {
                    present = true
                }
            }
            if !present {
                ToolError = "Add Transform3D in Properties before using this tool"
                await Finish(true)
                return
            }
            qx := CandidateNumber(path, inspected.Fields, "/components/Transform3D/rotation/x")
            qy := CandidateNumber(path, inspected.Fields, "/components/Transform3D/rotation/y")
            qz := CandidateNumber(path, inspected.Fields, "/components/Transform3D/rotation/z")
            qw := CandidateNumber(path, inspected.Fields, "/components/Transform3D/rotation/w")
            norm := sqrt(qx * qx + qy * qy + qz * qz + qw * qw)
            if norm == 0.0 {
                qw = 1.0
            } else {
                qx /= norm
                qy /= norm
                qz /= norm
                qw /= norm
            }
            dx: double = 0.0
            dy: double = 0.0
            dz: double = 0.0
            if text_equal(Axis, "x") {
                dx = delta
            }
            if text_equal(Axis, "y") {
                dy = delta
            }
            if text_equal(Axis, "z") {
                dz = delta
            }
            if text_equal(Tool, "rotate") {
                sine := sin(delta * 0.5)
                cosine := cos(delta * 0.5)
                ax: double = 0.0
                ay: double = 0.0
                az: double = 0.0
                if text_equal(Axis, "x") {
                    ax = sine
                }
                if text_equal(Axis, "y") {
                    ay = sine
                }
                if text_equal(Axis, "z") {
                    az = sine
                }
                nx := cosine * qx + ax * qw + ay * qz - az * qy
                ny := cosine * qy - ax * qz + ay * qw + az * qx
                nz := cosine * qz + ax * qy - ay * qx + az * qw
                nw := cosine * qw - ax * qx - ay * qy - az * qz
                if Local {
                    nx = qw * ax + qx * cosine + qy * az - qz * ay
                    ny = qw * ay - qx * az + qy * cosine + qz * ax
                    nz = qw * az + qx * ay - qy * ax + qz * cosine
                }
                if !await EditField(path, "/components/Transform3D/rotation/x", nx) {
                    await Finish(true)
                    return
                }
                if !await EditField(path, "/components/Transform3D/rotation/y", ny) {
                    await Finish(true)
                    return
                }
                if !await EditField(path, "/components/Transform3D/rotation/z", nz) {
                    await Finish(true)
                    return
                }
                if !await EditField(path, "/components/Transform3D/rotation/w", nw) {
                    await Finish(true)
                    return
                }
            } else {
                relative := "/components/Transform3D/position/"
                if text_equal(Tool, "scale") {
                    relative = "/components/Transform3D/scale/"
                }
                if Local && text_equal(Tool, "move") {
                    tx := 2.0 * (qy * dz - qz * dy)
                    ty := 2.0 * (qz * dx - qx * dz)
                    tz := 2.0 * (qx * dy - qy * dx)
                    dx += qw * tx + qy * tz - qz * ty
                    dy += qw * ty + qz * tx - qx * tz
                    dz += qw * tz + qx * ty - qy * tx
                }
                for axis in VectorAxes {
                    change := dx
                    if text_equal(axis, "y") {
                        change = dy
                    }
                    if text_equal(axis, "z") {
                        change = dz
                    }
                    if change != 0.0 {
                        value := CandidateNumber(path, inspected.Fields, format_text("{}{}", relative, axis)) + change
                        if text_equal(Tool, "scale") && value < 0.001 {
                            value = 0.001
                        }
                        if !await EditField(path, format_text("{}{}", relative, axis), value) {
                            await Finish(true)
                            return
                        }
                    }
                }
            }
        }
        await RefreshFields()
        await Publish()
    }
    Frame :: fn(All: bool) {
        if ModelPreview() {
            await ModelViewChange("frame", 0.0)
            return
        }
        if !Ready || Playing || Gesture || GuardWaiting || RuntimeDocument != Document || RuntimeRevision != Revision || Width <= 0.0 || Height <= 0.0 {
            return
        }
        GameCamera = false;
        FrameAll = All;
        FrameScan = 0;
        FrameFound = false;
        FrameSized = false
        FrameDocument = Document;
        FrameRevision = Revision;
        FrameSession = Session
        FrameMin = [];
        FrameMax = [];
        FrameScanning = true
    }
    ResetView :: fn() {
        if ModelPreview() { await ModelViewChange("orbit", 0.0); return }
        GameCamera = false
        X = 0.0
        Y = 0.0
        Span = 24.0
        Yaw = 0.0
        Pitch = 0.6
        Elevation = 0.0
        if Ready {
            await view()
        }
        await Publish()
    }
    on Begin {
        await LoadPreferences()
        await Publish()
    }
    on StudioDocumentState {
        ActiveDocument = event.Document
        self.Busy = event.Busy && !Authorized
        if event.Document <= 0 {
            SelectedPreviewDocument = 0
            SelectedPreviewRevision = 0
            SelectedPreviewName = ""
            SelectedPreviewKind = ""
            Visible = false
            await Publish()
            return
        }
        identity := workspace_asset_identity(event.Document, event.Revision)
        SelectedPreviewDocument = 0
        SelectedPreviewRevision = 0
        SelectedPreviewName = ""
        SelectedPreviewKind = ""
        if identity.Ok && (text_equal(identity.Kind, "prototype") || text_equal(identity.Kind, "model")) {
            SelectedPreviewDocument = event.Document
            SelectedPreviewRevision = event.Revision
            SelectedPreviewName = identity.Name
            SelectedPreviewKind = identity.Kind
        }
        if TargetPreview && event.Document == PreviewDocument && event.Revision != PreviewRevision {
            PreviewRevision = event.Revision
            PreviewName = identity.Name
            NeedsPrepare = true
            Idle = 0.0
        }
        Visible = identity.Ok && (text_equal(identity.Kind, "scene") || (TargetPreview && event.Document == PreviewDocument))
        if identity.Ok && text_equal(identity.Kind, "scene") {
            if self.Document != event.Document && Gesture {
                await Finish(true)
            }
            if self.Document != event.Document && ProposalPending {
                return
            }
            if self.Document != event.Document || self.Revision != event.Revision {
                self.Document = event.Document
                self.Revision = event.Revision
                NeedsPrepare = true
                Idle = 0.0
                await RefreshFields()
                await RestorePresentation()
            }
        }
        await Publish()
    }
    on StudioPanelSelected {
        if text_equal(event.Area, "main") {
            Visible = text_equal(event.Panel, "scene")
        }
    }
    on StudioObjectSelection {
        CheckpointDirty = true
        if event.Document != self.Document || event.Revision != self.Revision {
            return
        }
        Selection = event.Paths
        OverlayKey = ""
        await Publish()
    }
    on StudioObjectVisibility {
        if event.Document != self.Document || event.Revision != self.Revision {
            return
        }
        self.Hidden = event.Hidden
        self.Locked = event.Locked
        self.Isolated = event.Isolated
        OverlayKey = ""
        await Exclusions()
    }
    on StudioSceneCommand {
        CheckpointDirty = true
        switch event.Id {
            case "playTarget": {
                if Preparing || Playing || Steps > 0 || Gesture || GuardWaiting {
                    ToolError = "Stop simulation to change target."
                    await Publish()
                    return
                }
                preview := text_equal(event.Argument, "preview")
                if !preview && !text_equal(event.Argument, "scene") {
                    return
                }
                if preview && SelectedPreviewDocument <= 0 {
                    ToolError = "Select a prototype or model to preview."
                    await Publish()
                    return
                }
                TargetPreview = preview
                FrameScanning = false
                BoxScanning = false
                BoxActive = false
                if preview {
                    if PreviewDocument != SelectedPreviewDocument {
                        ModelPartNode = 0
                        ModelPartAsset = ""
                        ModelPartPath = ""
                        ModelRejectedKeys = []
                        ModelRejectedValues = []
                        ModelRejectedErrors = []
                        ModelOverrideKeys = []
                        ModelOverrideValues = []
                    }
                    PreviewDocument = SelectedPreviewDocument
                    PreviewRevision = SelectedPreviewRevision
                    PreviewName = SelectedPreviewName
                    PreviewKind = SelectedPreviewKind
                    Visible = true
                }
                Ready = false
                Image = ""
                PlayAfterPrepare = false
                NeedsPrepare = true
                Idle = 0.0
                ToolError = ""
            }
            case "captureEvidence": {
                if EvidencePending {
                    return
                }
                if EvidenceSequence >= 2147483647 {
                    EvidenceError = "Evidence request limit reached"
                    return
                }
                EvidenceSequence += 1
                destination := format_text("runtime-evidence-{}-{}", Session, EvidenceSequence)
                capture := await workspace_runtime_evidence_begin(Session, destination)
                if capture.Ok {
                    EvidencePending = capture.Pending
                    EvidenceJob = capture.Job
                    EvidenceDirectory = capture.Directory
                    EvidenceState = capture.State
                } else {
                    EvidencePending = false
                    EvidenceState = "refused"
                }
                EvidenceError = capture.Error
            }
            case "cancelEvidence": {
                canceled := await workspace_runtime_evidence_cancel(EvidenceJob)
                EvidencePending = canceled.Ok && canceled.Pending
                EvidenceState = canceled.State
                EvidenceError = canceled.Error
            }
            case "applyLive": {
                NeedsPrepare = true
                Idle = 0.3
            }
            case "rebuild": {
                await RequestGuard("prepare")
            }
            case "cancelPrepare": {
                await workspace_runtime_cancel()
                Preparing = false
                PlayAfterPrepare = false
            }
            case "viewThroughCamera": {
                GameCamera = !GameCamera
            }
            case "generatedWorld": {
                Generated = !Generated
                number: double = 0.0
                if Generated {
                    number = 1.0
                }
                await send_event<"StudioPreferenceNumber">(self, "scene.generatedWorld", number)
            }
            case "showLighting": {
                Unlit = !Unlit
                PresentationDirty = true
                number: double = 0.0
                if !Unlit {
                    number = 1.0
                }
                await send_event<"StudioPreferenceNumber">(self, "scene.lighting", number)
            }
            case "showFog": {
                Fogless = !Fogless
                PresentationDirty = true
                number: double = 0.0
                if !Fogless {
                    number = 1.0
                }
                await send_event<"StudioPreferenceNumber">(self, "scene.fog", number)
            }
            case "showColliders": {
                Colliders = !Colliders
                PresentationDirty = true
                number: double = 0.0
                if Colliders {
                    number = 1.0
                }
                await send_event<"StudioPreferenceNumber">(self, "scene.colliders", number)
            }
            case "showCameraFrames": {
                Cameras = !Cameras
                PresentationDirty = true
                number: double = 0.0
                if Cameras {
                    number = 1.0
                }
                await send_event<"StudioPreferenceNumber">(self, "scene.cameraFrames", number)
            }
            case "resetCamera": {
                await ResetView()
            }
            case "frameAll": {
                await Frame(true)
            }
            case "frame": {
                await Frame(false)
            }
            case "grab": {
                if !Ready || !Perspective || Playing || length(Selection) == 0 || !CanTransform() || RuntimeDocument != Document || RuntimeRevision != Revision {
                    ToolError = "Grab requires a current paused 3D selection"
                    return
                }
                Tool = "move"
                Axis = "x"
                RayPart = "screen"
                RayPointerX = PointerX
                RayPointerY = PointerY
                RayActive = true
                RayInitialized = false
                if !await RayBegin() {
                    RayActive = false
                    await Publish()
                    return
                }
                Grab = true
                await RequestGuard("axis")
            }
            case "colliderTool": {
                Tool = "collider"
                Colliders = true
                PresentationDirty = true
            }
            case "selectTool": {
                Tool = "select"
            }
            case "moveTool": {
                Tool = "move"
            }
            case "rotateTool": {
                Tool = "rotate"
            }
            case "scaleTool": {
                Tool = "scale"
            }
            case "toggleSnap": {
                Snap = !Snap
                number: double = 0.0
                if Snap {
                    number = 1.0
                }
                await send_event<"StudioPreferenceNumber">(self, "scene.snap", number)
            }
            case "toggleGrid": {
                Grid = !Grid
                number: double = 0.0
                if Grid {
                    number = 1.0
                }
                await send_event<"StudioPreferenceNumber">(self, "scene.grid", number)
            }
            case "toggleLocalSpace": {
                Local = !Local
                number: double = 0.0
                if Local {
                    number = 1.0
                }
                await send_event<"StudioPreferenceNumber">(self, "scene.localSpace", number)
            }
            case "finerGrid": {
                Increment = max(1.0, Increment / 2.0)
                await send_event<"StudioPreferenceNumber">(self, "scene.gridIncrement", cast<double>(Increment))
            }
            case "coarserGrid": {
                Increment = min(128.0, Increment * 2.0)
                await send_event<"StudioPreferenceNumber">(self, "scene.gridIncrement", cast<double>(Increment))
            }
        }
        await Publish()
    }
    on StudioSceneTimeline {
        if text_equal(event.Operation, "record") || text_equal(event.Operation, "replay") {
            ReplayPrimed = false
        }
    }
    on StudioDebugCommand {
        CheckpointDirty = true
        operation := event.Id
        if Ready && Steps == 0 && !Playing && (text_equal(operation, "play") || text_equal(operation, "step")) {
            await workspace_simulation_materials(Session, "reset", 0.0, 0.0, 0.0)
        }
        if text_equal(operation, "play") {
            if !Ready || NeedsPrepare || !RuntimeCurrent() {
                PlayAfterPrepare = true
                await RequestGuard("play")
                return
            }
            if Playing {
                operation = "pause"
            }
        }
        if !text_equal(operation, "play") && !text_equal(operation, "pause") && !text_equal(operation, "step") && !text_equal(operation, "stop") {
            return
        }
        controlled := await workspace_runtime_control(Session, operation)
        Playing = controlled.Playing
        Error = controlled.Error
        if controlled.Ok && ModelPreview() && text_equal(operation, "stop") { await ModelInitialize() }
        if text_equal(operation, "stop") {
            await send_event<"StudioRuntimeStopped">(self, Session, RuntimeDocument, RuntimeRevision, controlled.Ok, controlled.Error)
        }
        await Publish()
    }
    on StudioScenePointer {
        if Playing {
            return
        }
        CheckpointDirty = true
        if event.Session != self.Session || !Ready || Busy {
            return
        }
        if ModelPreview() {
            if text_equal(event.Action, "orbit") || (text_equal(event.Action, "navigate") && event.Button == 0) {
                if text_equal(ModelView, "orbit") {
                    ModelYaw += event.Delta.x / PixelRatio / Width * 6.2831853
                    ModelPitch = clamp(ModelPitch + event.Delta.y / PixelRatio / Height * 3.14, -1.55, 1.55)
                    ModelDirty = true
                }
            }
            if text_equal(event.Action, "wheel") { Span = clamp(Span * (1.0 + event.Wheel.y * 0.1), 0.0001, 10000.0) }
            if text_equal(event.Action, "pan") || (text_equal(event.Action, "navigate") && event.Button == 1) {
                X -= event.Delta.x / PixelRatio * Span / Width
                Y += event.Delta.y / PixelRatio * Span / Width
            }
            await ModelUpdate()
            await view()
            await Publish()
            return
        }
        if Grab && text_equal(event.Action, "grabMove") {
            dx := event.LocalPointer.x / PixelRatio - RayPointerX
            dy := event.LocalPointer.y / PixelRatio - RayPointerY
            RayPointerX = event.LocalPointer.x / PixelRatio
            RayPointerY = event.LocalPointer.y / PixelRatio
            if GuardWaiting {
                RayPendingDX += dx
                RayPendingDY += dy
            }
            if Authorized {
                await RayDrag(dx, dy)
            }
            return
        }
        if Grab && (text_equal(event.Action, "grabAccept") || text_equal(event.Action, "grabCancel")) {
            canceled := text_equal(event.Action, "grabCancel")
            if GuardWaiting {
                PendingEnd = true
                PendingCanceled = canceled
            }
            if Authorized {
                await Finish(canceled)
            }
            return
        }
        PointerX = event.LocalPointer.x / PixelRatio
        PointerY = event.LocalPointer.y / PixelRatio
        if text_equal(event.Action, "boxStart") && event.Button == 0 && !Gesture && !GuardWaiting && RuntimeDocument == Document && RuntimeRevision == Revision {
            hit := await workspace_runtime_pick(self.Session, event.LocalPointer.x / PixelRatio / Width * 2.0 - 1.0, 1.0 - event.LocalPointer.y / PixelRatio / Height * 2.0)
            if hit.Ok && hit.Object < 0 {
                BoxActive = true
                BoxScanning = false
                BoxMod = event.Mod || event.Shift
                BoxStartX = event.LocalPointer.x / PixelRatio
                BoxStartY = event.LocalPointer.y / PixelRatio
                BoxX = BoxStartX
                BoxY = BoxStartY
            }
        }
        if BoxActive && text_equal(event.Action, "navigate") && event.Button == 0 {
            BoxX += event.Delta.x / PixelRatio
            BoxY += event.Delta.y / PixelRatio
        }
        if BoxActive && text_equal(event.Action, "boxEnd") {
            BoxActive = false
            BoxScanning = true
            BoxScan = 0
            BoxPaths = []
            BoxDocument = Document
            BoxRevision = Revision
            BoxSession = self.Session
            BoxView = OverlayStamp()
        }
        if Grab && text_equal(event.Action, "navigate") && event.Button == 0 {
            RayPointerX += event.Delta.x / PixelRatio
            RayPointerY += event.Delta.y / PixelRatio
            if Authorized {
                await RayDrag(event.Delta.x / PixelRatio, event.Delta.y / PixelRatio)
            }
        }
        if text_equal(event.Action, "pick") && event.Button == 0 && RuntimeDocument == Document && RuntimeRevision == Revision {
            marker := MarkerPick(event.LocalPointer.x / PixelRatio, event.LocalPointer.y / PixelRatio)
            if marker >= 0 {
                field := SourceField(marker)
                if field >= 0 {
                    await send_event<"StudioOutlinerSelect">(self, Fields[field].path, event.Mod, event.Shift)
                }
            } else {
                picked := await workspace_runtime_pick(self.Session, event.LocalPointer.x / PixelRatio / Width * 2.0 - 1.0, 1.0 - event.LocalPointer.y / PixelRatio / Height * 2.0)
                if picked.Ok && !text_equal(picked.Subject, "") {
                    field := -1
                    if picked.Object >= 0 {
                        field = SourceField(picked.Object)
                    }
                    if field >= 0 {
                        await send_event<"StudioOutlinerSelect">(self, Fields[field].path, event.Mod, event.Shift)
                    } else {
                        await send_event<"StudioRuntimeSubjectSelected">(self, self.Session, picked.Subject)
                    }
                } else {
                    if picked.Ok && !event.Mod && !event.Shift {
                        await send_event<"StudioSceneCommand">(self, "deselect", "")
                    }
                    if !picked.Ok {
                        ToolError = picked.Error
                    }
                }
            }
        }
        if text_equal(event.Action, "pan") || (text_equal(event.Action, "navigate") && event.Button == 1) {
            GameCamera = false
            X -= event.Delta.x / PixelRatio * Span / Width
            Y += event.Delta.y / PixelRatio * Span / Width
            await view()
        }
        if text_equal(event.Action, "orbit") || (text_equal(event.Action, "navigate") && event.Button == 2) {
            GameCamera = false
            Yaw += event.Delta.x / PixelRatio * 0.01
            Pitch = clamp(Pitch + event.Delta.y / PixelRatio * 0.01, -1.4, 1.4)
            await view()
        }
        if text_equal(event.Action, "wheel") {
            GameCamera = false
            Span = clamp(Span * (1.0 + event.Wheel.y * 0.1), 0.1, 10000.0)
            await view()
        }
        await Publish()
    }
    on StudioModelRuntimeView {
        if event.Session != Session { return }
        await ModelViewChange(event.Id, event.Value)
    }
    on StudioModelRuntimeParameter {
        if event.Session != Session { return }
        await ModelParameterWrite(event.Row, event.Value)
        await Publish()
    }
    on StudioSceneAxis {
        beginning := text_equal(event.Action, "begin") || text_equal(event.Action, "projectedBegin") || text_equal(event.Action, "planeBegin") || text_equal(event.Action, "centerBegin") || text_equal(event.Action, "ringBegin") || text_equal(event.Action, "colliderBegin")
        dragging := text_equal(event.Action, "drag") || text_equal(event.Action, "projectedDrag") || text_equal(event.Action, "planeDrag") || text_equal(event.Action, "centerDrag") || text_equal(event.Action, "ringDrag") || text_equal(event.Action, "colliderDrag")
        ending := text_equal(event.Action, "end") || text_equal(event.Action, "projectedEnd") || text_equal(event.Action, "planeEnd") || text_equal(event.Action, "centerEnd") || text_equal(event.Action, "ringEnd") || text_equal(event.Action, "colliderEnd")
        if beginning {
            if ActiveDocument != Document || Playing || !CanTransform() || RuntimeDocument != Document || RuntimeRevision != Revision {
                return
            }
            ProjectedAxis = !text_equal(event.Action, "begin")
            self.Axis = event.Axis
            AxisCarry = 0.0
            InvertSnap = event.Mod
            RayActive = ProjectedAxis && Perspective
            RayInitialized = false
            RayPendingDX = 0.0
            RayPendingDY = 0.0
            if RayActive {
                index: int = 0
                if text_equal(event.Axis, "y") {
                    index = 1
                }
                if text_equal(event.Axis, "z") {
                    index = 2
                }
                RayPart = "axis"
                RayPointerX = GizmoX + GizmoDX[index]
                RayPointerY = GizmoY + GizmoDY[index]
                if text_equal(event.Action, "planeBegin") {
                    RayPart = "plane"
                    RayPointerX = PlaneLeft[index] + 8.0
                    RayPointerY = PlaneTop[index] + 8.0
                }
                if text_equal(event.Action, "centerBegin") {
                    RayPart = "screen"
                    RayPointerX = GizmoX
                    RayPointerY = GizmoY
                }
                if text_equal(event.Action, "ringBegin") {
                    slot := cast<int>(event.Value)
                    if slot < 0 || slot >= length(RingLeft) {
                        return
                    }
                    RayPart = "ring"
                    RayPointerX = RingLeft[slot] + 6.0
                    RayPointerY = RingTop[slot] + 6.0
                }
                if text_equal(event.Action, "colliderBegin") {
                    slot := cast<int>(event.Value)
                    if slot < 0 || slot >= length(ColliderLeft) {
                        return
                    }
                    ColliderSlot = slot
                    RayPart = "collider"
                    RayPointerX = ColliderLeft[slot] + 6.0
                    RayPointerY = ColliderTop[slot] + 6.0
                }
                if !await RayBegin() {
                    RayActive = false
                    await Publish()
                    return
                }
                if text_equal(RayPart, "collider") {
                    if ColliderSlot % 2 == 0 {
                        RayAxis = Mul(RayAxis, -1.0)
                    }
                    colliderRay := await PointerRay()
                    if length(colliderRay) != 6 {
                        RayActive = false
                        return
                    }
                    parameter := AxisParameter(colliderRay)
                    if length(parameter) != 1 {
                        RayActive = false
                        return
                    }
                    ColliderBaseReach = ColliderReach[ColliderSlot]
                    ColliderAxisStart = parameter[0]
                }
            }
            await RequestGuard("axis")
        }
        if dragging {
            if RayActive {
                RayPointerX += event.Delta.x / PixelRatio
                RayPointerY += event.Delta.y / PixelRatio
                if GuardWaiting {
                    RayPendingDX += event.Delta.x / PixelRatio
                    RayPendingDY += event.Delta.y / PixelRatio
                }
                if Authorized {
                    await RayDrag(event.Delta.x / PixelRatio, event.Delta.y / PixelRatio)
                }
            } else {
                pixels := event.Delta.x / PixelRatio - event.Delta.y / PixelRatio
                amount := pixels * Span / Width
                if text_equal(Tool, "rotate") {
                    amount = pixels * 0.01
                }
                if text_equal(Tool, "scale") {
                    amount = pixels * 0.005
                }
                if GuardWaiting {
                    PendingAmount += amount
                }
                if Authorized {
                    await Nudge(amount)
                }
            }
        }
        if ending {
            if GuardWaiting {
                PendingEnd = true
                PendingCanceled = event.Canceled
            }
            if Authorized {
                await Finish(event.Canceled)
            }
        }
    }
    on StudioDocumentExternalEditReady {
        if !text_equal(event.Owner, "scene") || event.Document != GuardDocument || event.Request != GuardRequest {
            return
        }
        if !event.Ok {
            GuardWaiting = false
            ToolError = event.Error
            if Gesture {
                await Finish(true)
            }
            await Publish()
            return
        }
        if !GuardWaiting {
            return
        }
        GuardWaiting = false
        Authorized = true
        Busy = false
        mode := GuardMode
        if text_equal(mode, "prepare") || text_equal(mode, "play") {
            await Prepare()
            await ReleaseGuard()
        }
        if text_equal(mode, "axis") {
            self.Revision = event.Revision
            GestureBaseRevision = event.Revision
            LiveObjects = []
            LiveFields = []
            LiveComponents = []
            LiveValues = []
            await RefreshFields()
            if RayActive && RuntimeRevision != event.Revision {
                ToolError = "Source changed while the pointer tool waited; rebuild the preview"
                await Finish(true)
                return
            }
            if RayActive && !PendingCanceled {
                await RayDrag(RayPendingDX, RayPendingDY)
            }
            if PendingAmount != 0.0 && !PendingCanceled {
                await Nudge(PendingAmount)
            }
            if PendingEnd {
                await Finish(PendingCanceled)
            }
        }
        await Publish()
    }
    on StudioDocumentExternalEditCancelRequested {
        if text_equal(event.Owner, "scene") && event.Document == GuardDocument && event.Request == GuardRequest {
            await Finish(true)
        }
    }
    on StudioCollaborationState {
        CollaborationActive = event.Active
        CollaborationReady = event.Ready
        CollaborationPending = event.Pending
        CollaborationRole = event.Role
        CollaborationReplaying = event.Replaying
        if Gesture && !CanTransform() {
            await Finish(true)
        }
        await Publish()
    }
    on StudioDocumentEditResult {
        if !ProposalPending || !text_equal(event.Owner, "scene") || event.Request != ProposalRequest || event.Document != self.Document || event.ExpectedRevision != GestureBaseRevision {
            return
        }
        ProposalPending = false
        CandidateMode = false
        if !event.Ok {
            ToolError = event.Error
            await RestoreLive(true)
        } else {
            await RestoreLive(false)
            await read()
            if read.Ok {
                self.Revision = read.Revision
                await RefreshFields()
                NeedsPrepare = true
            }
        }
        CandidateText = ""
        CandidateKeys = []
        CandidateValues = []
        await send_event<"StudioDocumentCommand">(self, "refresh", "")
        await Publish()
    }
    on StudioSceneCancel {
        BoxActive = false
        BoxScanning = false
        Grab = false
        if GuardWaiting {
            PendingEnd = true
            PendingCanceled = true
        } else {
            await Finish(true)
        }
    }
    on Tick {
        await FrameStep()
        await MarqueeStep()
        if EvidencePending {
            captured := await workspace_runtime_evidence_poll(EvidenceJob)
            EvidencePending = captured.Ok && captured.Pending
            EvidenceState = captured.State
            EvidenceError = captured.Error
            EvidenceDirectory = captured.Directory
        }
        if Preparing {
            await status()
            Preparing = status.Preparing
            Ready = status.Ready
            Error = status.Error
            Log = status.Log
            if Session != status.Session {
                Session = status.Session
                RuntimeDocument = status.Document
                RuntimeRevision = status.Revision
                Image = ""
                CheckpointDirty = true
                PresentationDirty = true
                await objects()
                Names = objects.Names
                Parents = objects.Parents
                Perspective = objects.Perspective
                if ModelPreview() { await ModelInitialize() }
                await view()
                await Exclusions()
                if PlayAfterPrepare && RuntimeCurrent() {
                    played := await workspace_runtime_control(Session, "play")
                    Playing = played.Playing
                    CheckpointDirty = true
                    PlayAfterPrepare = false
                }
            }
            if TargetPreview && !RuntimeCurrent() {
                Ready = false
            }
        }
        if NeedsPrepare && !Preparing && !Busy && !Gesture {
            Idle += DeltaSeconds
            if Idle >= 0.3 {
                await RequestGuard("prepare")
            }
        }
        if Ready && Playing && !Visible && !Busy {
            advanced := await workspace_runtime_control(Session, "advance")
            Error = advanced.Error
            Steps = advanced.Steps
            Time = advanced.Time
        }
        if Ready && Visible && !Busy {
            measured := get_ui_view_width(Element: "#studio-scene-surface")
            width := measured."View Width"
            height := get_ui_scroll(Element: "#studio-scene-surface")."View Height"
            if width > 0.0 && height > 0.0 && measured.PixelRatio > 0.0 {
                Width = width
                Height = height
                PixelRatio = measured.PixelRatio
                scale := min(1.0, min(2048.0 / (width * PixelRatio), 2048.0 / (height * PixelRatio)))
                if Generated && !TargetPreview && !Playing && Steps == 0 {
                    generated := await workspace_simulation_materials(Session, "prepare", X, -Y, min(4096.0, 0.5 * sqrt(Span * Span + Span * Height / Width * Span * Height / Width)))
                    GenerationPending = generated.Pending
                    if !generated.Ok {
                        ToolError = generated.Error
                        Generated = false
                    }
                }
                await ModelUpdate()
                await ModelParametersStep()
                await ApplyPresentation()
                if Playing {
                    GameCamera = true
                }
                await ApplyView()
                timeline := await workspace_simulation_timeline(Session, "status", 0, "")
                seconds := min(DeltaSeconds, 0.25)
                if !timeline.Replaying {
                    ReplayPrimed = false
                }
                if timeline.Replaying {
                    seconds = 0.0
                    if ReplayPrimed && timeline.Steps < timeline.EndStep {
                        await workspace_runtime_control(Session, "step")
                    }
                    if timeline.Steps >= timeline.EndStep {
                        await workspace_simulation_timeline(Session, "stop-replay", 0, "")
                        await workspace_runtime_control(Session, "pause")
                    }
                }
                drawn := await workspace_runtime_draw(Session, cast<int>(Width * PixelRatio * scale), cast<int>(Height * PixelRatio * scale), seconds)
                Image = drawn.Image
                if ModelPreview() && drawn.Ok && !ModelDrawn {
                    ModelDrawn = true
                    ModelDirty = true
                }
                if !drawn.Ok {
                    Error = drawn.Error
                }
                Playing = drawn.Playing
                Steps = drawn.Steps
                Time = drawn.Time
                if timeline.Replaying && drawn.Ok {
                    ReplayPrimed = true
                }
                if timeline.Replaying && drawn.Ok && drawn.Steps < timeline.EndStep {
                    resumed := await workspace_runtime_control(Session, "play")
                    Playing = resumed.Playing
                }
            }
        }
        await OverlayStep()
        await UpdateGizmo()
        await UpdateCollider()
        await Publish()
    }
}
