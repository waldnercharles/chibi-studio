    GizmoX: float = 0.0
    GizmoY: float = 0.0
    GizmoDX: float[] = []
    GizmoDY: float[] = []
    LiveObjects: int[] = []
    LiveFields: string[] = []
    LiveComponents: string[] = []
    PlanarFields: string[] = ["/components/Transform/x", "/components/Transform/y", "/components/Orientation/radians", "/components/Appearance/width", "/components/Appearance/height"]
    LiveValues: double[] = []
