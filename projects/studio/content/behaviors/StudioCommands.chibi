        { id: "saveAsPrototype", label: "Save as New Prototype…", shortcut: "", context: "Global", keywords: "prefab variant instance create", icon: "", destination: "scene", group: "Scene", creation: false, available: false, aliasBinding: "" },
        { id: "newProject", label: "New Project", shortcut: "Mod+Shift+N", context: "Global", keywords: "create workspace game folder", icon: "", destination: "resource", group: "File", creation: false, available: false, aliasBinding: "" },
        { id: "openProject", label: "Open Project…", shortcut: "Mod+O", context: "Global", keywords: "folder load", icon: "", destination: "resource", group: "File", creation: false, available: false, aliasBinding: "" },
        { id: "quit", label: "Quit", shortcut: "Mod+Q", context: "Global", keywords: "exit close window", icon: "", destination: "resource", group: "File", creation: false, available: false, aliasBinding: "" },
        { id: "importProject", label: "Import Project…", shortcut: "", context: "Global", keywords: "project job", icon: "", destination: "resource", group: "File", creation: false, available: false, aliasBinding: "" },
        { id: "exportProject", label: "Export Project…", shortcut: "", context: "Global", keywords: "project job", icon: "", destination: "resource", group: "File", creation: false, available: false, aliasBinding: "" },
        { id: "compileProject", label: "Compile Project", shortcut: "", context: "Global", keywords: "project job", icon: "", destination: "resource", group: "Run", creation: false, available: false, aliasBinding: "" },
        { id: "cancelJob", label: "Cancel Job", shortcut: "", context: "Global", keywords: "project job", icon: "", destination: "resource", group: "Run", creation: false, available: false, aliasBinding: "" },
        { id: "convertModel", label: "Convert Model…", shortcut: "", context: "Global", keywords: "mesh import gltf recipe", icon: "", destination: "resource", group: "File", creation: false, available: false, aliasBinding: "" },
        { id: "reimportModel", label: "Reimport Model…", shortcut: "", context: "Global", keywords: "mesh recipe rebuild", icon: "", destination: "resource", group: "File", creation: false, available: false, aliasBinding: "" },
        { id: "breakpoint", label: "Toggle Node Breakpoint", shortcut: "F9", context: "Graph", keywords: "graph", icon: "", destination: "graph", group: "Graph", creation: false, available: false, aliasBinding: "" },
        { id: "disable", label: "Enable or Disable Node", shortcut: "D", context: "Graph", keywords: "graph", icon: "", destination: "graph", group: "Graph", creation: false, available: false, aliasBinding: "" },
        { id: "fold", label: "Fold or Expand Inputs", shortcut: "Mod+G", context: "Graph", keywords: "graph", icon: "", destination: "graph", group: "Graph", creation: false, available: false, aliasBinding: "" },
        { id: "selectLinked", label: "Select Connected Nodes", shortcut: "L", context: "Graph", keywords: "graph", icon: "", destination: "graph", group: "Graph", creation: false, available: false, aliasBinding: "" },
        { id: "arrangeLinked", label: "Arrange Connected Nodes", shortcut: "Shift+L", context: "Graph", keywords: "graph", icon: "", destination: "graph", group: "Graph", creation: false, available: false, aliasBinding: "" },
        { id: "back", label: "Previous Graph Location", shortcut: "Alt+Left", context: "Graph", keywords: "graph", icon: "", destination: "graph", group: "Graph", creation: false, available: false, aliasBinding: "" },
        { id: "forward", label: "Next Graph Location", shortcut: "Alt+Right", context: "Graph", keywords: "graph", icon: "", destination: "graph", group: "Graph", creation: false, available: false, aliasBinding: "" },
        { id: "left", label: "Select Node to Left", shortcut: "Left", context: "Graph", keywords: "graph", icon: "", destination: "graph", group: "Graph", creation: false, available: false, aliasBinding: "" },
        { id: "right", label: "Select Node to Right", shortcut: "Right", context: "Graph", keywords: "graph", icon: "", destination: "graph", group: "Graph", creation: false, available: false, aliasBinding: "" },
        { id: "up", label: "Select Node Above", shortcut: "Up", context: "Graph", keywords: "graph", icon: "", destination: "graph", group: "Graph", creation: false, available: false, aliasBinding: "" },
        { id: "down", label: "Select Node Below", shortcut: "Down", context: "Graph", keywords: "graph", icon: "", destination: "graph", group: "Graph", creation: false, available: false, aliasBinding: "" }
    ]
    NewMenu: struct<"StudioCommandRow"> = { id: "new", label: "New", shortcut: "", context: "Global", keywords: "", icon: "", destination: "resource", group: "File", creation: false, available: false, aliasBinding: "" }
    CommandIds: string[] = []
    Available: bool[] = []
    Enabled: bool[] = []
    Uses: int[] = []
    Query: string = ""
    Shown: bool[] = []
    Order: int[] = []
    Scores: int[] = []
    Matches: int = 0
    RegistryReady := false
    Shortcuts: string[] = []
    Customized: bool[] = []
    KeyEvents: string[] = []
    AliasBindings: string[] = []
    Bindings: string = "Escape:StudioShellClose"
    ShortcutError: string = ""
    Paused := false
    DebuggerPaused := false
    DocumentCanUndo := false
    DocumentCanRedo := false
    DocumentBusy := false
    GestureCancelable := false
    AssetCanUndo := false
    AssetCanRedo := false
    GraphAvailable := false
    GraphSelected := false
    GraphEditable := false
    GraphCanBack := false
    GraphCanForward := false
    Context: string = "Scene"
    TextEditing := false
    ensure_registry :: fn() {
        if RegistryReady {
            return
        }
        for row in Rows {
            await set_ui_data(Name: format_text("studioCommandIndex.{}", row.id), Value: length(CommandIds))
            CommandIds = array_add(CommandIds, row.id)
            Available = array_add(Available, row.available)
            Enabled = array_add(Enabled, row.available)
            Uses = array_add(Uses, cast<int>(0))
            Shown = array_add(Shown, true)
            Order = array_add(Order, length(Order))
            Scores = array_add(Scores, cast<int>(0))
            Shortcuts = array_add(Shortcuts, row.shortcut)
            Customized = array_add(Customized, false)
            KeyEvents = array_add(KeyEvents, format_text("StudioKey_{}", row.id))
            AliasBindings = array_add(AliasBindings, row.aliasBinding)
        }
        Matches = length(Rows)
        RegistryReady = true
        return
    }
    dispatch_key :: fn(Id: string) {
        ensure_registry()
        i: int = 0
        for row in Rows {
            if text_equal(row.id, Id) {
                if eligible(row.id, row.context) {
                    send_event<"StudioCommand">(self, Id, "")
                }
                return
            }
            i += 1
        }
    }
    graph_only :: pure fn(Id: string) -> bool {
        return text_equal(Id, "breakpoint") || text_equal(Id, "disable") || text_equal(Id, "fold") || text_equal(Id, "selectLinked") || text_equal(Id, "arrangeLinked") || text_equal(Id, "back") || text_equal(Id, "forward") || text_equal(Id, "left") || text_equal(Id, "right") || text_equal(Id, "up") || text_equal(Id, "down")
    }
    graph_command :: pure fn(Id: string) -> bool {
        return graph_only(Id) || text_equal(Id, "selectAll") || text_equal(Id, "deselect") || text_equal(Id, "selectPrevious") || text_equal(Id, "selectNext") || text_equal(Id, "extendPrevious") || text_equal(Id, "extendNext") || text_equal(Id, "frameAll") || text_equal(Id, "find") || text_equal(Id, "copy") || text_equal(Id, "paste") || text_equal(Id, "showLiveValues") || text_equal(Id, "cut") || text_equal(Id, "goToDefinition") || text_equal(Id, "findReferences") || text_equal(Id, "callHierarchy")
    }
    find_context :: pure fn(Context: string) -> bool {
        return text_equal(Context, "Text Editor") || text_equal(Context, "Graph") || text_equal(Context, "Behavior") || text_equal(Context, "Outliner") || text_equal(Context, "Properties") || text_equal(Context, "Assets") || text_equal(Context, "Output")
    }
    graph_field_command :: pure fn(Id: string) -> bool {
        return (graph_command(Id) && !text_equal(Id, "find")) || text_equal(Id, "undo") || text_equal(Id, "redo") || text_equal(Id, "duplicate") || text_equal(Id, "delete") || text_equal(Id, "rename")
    }
    eligible :: fn(Id: string, CommandContext: string) -> bool {
        if TextEditing && (text_equal(Context, "Graph") || text_equal(Context, "Behavior")) && graph_field_command(Id) {
            return false
        }
        if graph_only(Id) {
            return !TextEditing && (text_equal(Context, "Graph") || text_equal(Context, "Behavior"))
        }
        if text_equal(Id, "find") {
            return find_context(Context)
        }
        if text_equal(Context, "Assets") && (text_equal(Id, "undo") || text_equal(Id, "redo")) {
            return !TextEditing
        }
        if graph_command(Id) && (text_equal(Context, "Graph") || text_equal(Context, "Behavior")) {
            return true
        }
        common := text_equal(Id, "undo") || text_equal(Id, "redo") || text_equal(Id, "cut") || text_equal(Id, "copy") || text_equal(Id, "paste") || text_equal(Id, "selectAll") || text_equal(Id, "find")
        if common && (text_equal(Context, "Text Editor") || text_equal(Context, "Graph") || text_equal(Context, "Behavior")) {
            return true
        }
        if text_equal(CommandContext, "Global") || text_equal(CommandContext, "Area under pointer") {
            return true
        }
        if text_equal(CommandContext, "When paused") {
            return DebuggerPaused
        }
        if text_equal(CommandContext, "Unless paused in the debugger") {
            return !DebuggerPaused
        }
        if text_equal(CommandContext, "Except Behavior") {
            return !text_equal(Context, "Graph") && !text_equal(Context, "Behavior") && !TextEditing
        }
        if text_equal(CommandContext, Context) {
            return true
        }
        if text_equal(CommandContext, "Scene, Outliner") {
            return text_equal(Context, "Scene") || text_equal(Context, "Outliner")
        }
        if text_equal(CommandContext, "Scene, Properties") {
            return text_equal(Context, "Scene") || text_equal(Context, "Properties")
        }
        return false
    }
    rebuild_keys :: fn() {
        ensure_registry()
        Bindings = "Escape:StudioShellClose"
        i: int = 0
        for row in Rows {
            if Enabled[i] && eligible(row.id, row.context) {
                if !text_equal(Shortcuts[i], "") {
                    Bindings = format_text("{} {}:{}", Bindings, Shortcuts[i], KeyEvents[i])
                }
                if !Customized[i] && !text_equal(AliasBindings[i], "") {
                    Bindings = format_text("{} {}", Bindings, AliasBindings[i])
                }
            }
            i += 1
        }
        return
    }
    publish :: fn() {
        ensure_registry()
        i: int = 0
        for row in Rows {
            id := row.id
            Enabled[i] = Available[i]
            if (text_equal(Context, "Graph") || text_equal(Context, "Behavior")) && graph_command(id) {
                Enabled[i] = GraphAvailable && !TextEditing
                if graph_only(id) && (text_equal(id, "breakpoint") || text_equal(id, "disable") || text_equal(id, "fold")) {
                    Enabled[i] = GraphEditable && GraphSelected && !TextEditing
                }
                if text_equal(id, "back") {
                    Enabled[i] = GraphCanBack && !TextEditing
                }
                if text_equal(id, "forward") {
                    Enabled[i] = GraphCanForward && !TextEditing
                }
            }
            if text_equal(id, "find") {
                Enabled[i] = find_context(Context)
            }
            if text_equal(id, "undo") {
                Enabled[i] = (DocumentCanUndo && !DocumentBusy) || GestureCancelable
                if text_equal(Context, "Assets") {
                    Enabled[i] = AssetCanUndo && !TextEditing
                }
            }
            if text_equal(id, "redo") {
                Enabled[i] = DocumentCanRedo && !DocumentBusy
                if text_equal(Context, "Assets") {
                    Enabled[i] = AssetCanRedo && !TextEditing
                }
            }
            i += 1
        }
        await rebuild_keys()
        await set_ui_data(Name: "studioCommandBindings", Value: Bindings)
        await set_ui_data(Name: "studioCommandShortcuts", Value: Shortcuts)
        await set_ui_data(Name: "studioShortcutError", Value: ShortcutError)
        await set_ui_data(Name: "studioCommandEnabled", Value: Enabled)
        await set_ui_data(Name: "studioCommandShown", Value: Shown)
        await set_ui_data(Name: "studioCommandOrder", Value: Order)
        await set_ui_data(Name: "studioCommandMatches", Value: Matches)
        set_ui_data(Name: "studioCommandQuery", Value: Query)
        return
    }
    on Begin {
        ensure_registry()
        await set_ui_data(Name: "studioCommands", Value: Rows)
        await set_ui_data(Name: "studioNewMenu", Value: NewMenu)
        i: int = 0
        for row in Rows {
            uses := read_saved_number(format_text("studio.commandUses.{}", row.id), 0).Number
            if uses >= 0 && uses <= 1000000 {
                Uses[i] = cast<int>(uses)
            }
            stored := read_saved_text(format_text("studio.shortcut.{}", row.id), row.shortcut)
            if text_equal(stored.Text, "") || validate_ui_chord(stored.Text) {
                Shortcuts[i] = stored.Text
                Customized[i] = stored.Found
            }
            i += 1
        }
        publish()
    }
    action persist_recent = commit_save()
    after persist_recent.Failed {
        send_event<"StudioStatus">(self, "warning", "The command ran, but its recent history could not be saved.")
    }
    action persist_shortcuts = commit_save()
    after persist_shortcuts.Then {
        send_event<"StudioStatus">(self, "info", "Keyboard shortcuts saved.")
    }
    after persist_shortcuts.Failed {
        ShortcutError = "Shortcut changed, but could not be saved. Retry to keep it after restarting."
        await publish()
        send_event<"StudioStatus">(self, "error", ShortcutError)
    }
    on StudioShortcutRetry {
        ensure_registry()
        persist_shortcuts()
    }
    on StudioShortcutChanged {
        ensure_registry()
        if !text_equal(event.Chord, "") && !validate_ui_chord(event.Chord) {
            ShortcutError = "Use a key with optional Mod, Ctrl, Meta, Alt and Shift prefixes."
            await publish()
            return
        }
        i: int = 0
        for row in Rows {
            if text_equal(row.id, event.Id) {
                j: int = 0
                for other in Rows {
                    if j != i && !text_equal(event.Chord, "") && text_equal(Shortcuts[j], event.Chord) && (text_equal(row.context, other.context) || text_equal(row.context, "Global") || text_equal(other.context, "Global")) {
                        ShortcutError = format_text("That shortcut is already assigned to {}.", other.label)
                        await publish()
                        return
                    }
                    j += 1
                }
                Shortcuts[i] = event.Chord
                Customized[i] = true
                ShortcutError = ""
                await set_saved_text(format_text("studio.shortcut.{}", event.Id), event.Chord)
                await publish()
                persist_shortcuts()
                return
            }
            i += 1
        }
        send_event<"StudioStatus">(self, "error", "Unknown shortcut command.")
    }
    on StudioShortcutReset {
        ensure_registry()
        i: int = 0
        for row in Rows {
            if text_equal(row.id, event.Id) {
                Shortcuts[i] = row.shortcut
                Customized[i] = false
                ShortcutError = ""
                await remove_saved_text(format_text("studio.shortcut.{}", event.Id))
                await publish()
                persist_shortcuts()
                return
            }
            i += 1
        }
    }
    on StudioPlaybackState {
        ensure_registry()
        self.Paused = event.Paused
        publish()
    }
    on StudioDebuggerState {
        ensure_registry()
        DebuggerPaused = event.Attached && event.Paused
        publish()
    }
    on StudioSettingsShortcut {
        ensure_registry()
        send_event<"StudioCommand">(self, "settings", "")
    }
    on StudioSearchShortcut {
        ensure_registry()
        send_event<"StudioCommand">(self, "search", "")
    }
    on StudioRedoShortcut {
        ensure_registry()
        send_event<"StudioCommand">(self, "redo", "")
    }
    on StudioUndoShortcut {
        ensure_registry()
        send_event<"StudioCommand">(self, "undo", "")
    }
    on StudioSaveAllShortcut {
        ensure_registry()
        send_event<"StudioCommand">(self, "saveAll", "")
    }
    on StudioSaveShortcut {
        ensure_registry()
        send_event<"StudioCommand">(self, "save", "")
    }
    on StudioCommandQuery {
        ensure_registry()
        self.Query = event.Query
        Matches = 0
        i: int = 0
        for row in Rows {
            Scores[i] = text_rank(event.Query, format_text("{} {} {}", row.label, row.id, row.keywords), true)
            Shown[i] = text_equal(event.Query, "") || Scores[i] > 0
            if Shown[i] {
                Matches += 1
            }
            Order[i] = i
            i += 1
        }
        // Stable insertion sort keeps authored order when ranks tie.
        for i in 1..length(Rows) - 1 {
            index := Order[i]
            j := i
            while j > 0 && (Scores[Order[j - 1]] < Scores[index] || (Scores[Order[j - 1]] == Scores[index] && Uses[Order[j - 1]] < Uses[index])) {
                Order[j] = Order[j - 1]
                j -= 1
            }
            Order[j] = index
        }
        publish()
    }
    on StudioCommandAvailability {
        ensure_registry()
        i: int = 0
        for id in CommandIds {
            if text_equal(id, event.Id) {
                if Available[i] == event.Enabled {
                    return
                }
                Available[i] = event.Enabled
                publish()
                return
            }
            i += 1
        }
    }
    on StudioGraphCommandState {
        GraphAvailable = event.Available
        GraphSelected = event.Selected
        GraphEditable = event.Editable
        GraphCanBack = event.CanBack
        GraphCanForward = event.CanForward
        publish()
    }
    on StudioFocusState {
        ensure_registry()
        self.Context = event.Context
        self.TextEditing = event.TextEditing
        publish()
    }
    on StudioAssetHistoryState {
        ensure_registry()
        AssetCanUndo = event.CanUndo && !event.Busy
        AssetCanRedo = event.CanRedo && !event.Busy
        publish()
    }
    on StudioDocumentGestureState {
        ensure_registry()
        GestureCancelable = event.Cancelable
        publish()
    }
    on StudioDocumentState {
        ensure_registry()
        DocumentCanUndo = event.CanUndo
        DocumentCanRedo = event.CanRedo
        DocumentBusy = event.Busy
        GestureCancelable = false
        i: int = 0
        for row in Rows {
            id := row.id
            if text_equal(id, "save") {
                Available[i] = event.Document > 0 && event.Dirty && !event.Busy && !event.Conflict
            }
            if text_equal(id, "undo") {
                Available[i] = event.CanUndo && !event.Busy
            }
            if text_equal(id, "redo") {
                Available[i] = event.CanRedo && !event.Busy
            }
            i += 1
        }
        publish()
    }
    on StudioCommand {
        ensure_registry()
        i: int = 0
        for row in Rows {
            if text_equal(row.id, event.Id) {
                if text_equal(event.Id, "deselect") && text_equal(event.Argument, "escape-idle") && (!Enabled[i] || !eligible(row.id, row.context)) {
                    return
                }
                if !eligible(row.id, row.context) && (text_equal(event.Id, "find") || (TextEditing && (text_equal(Context, "Graph") || text_equal(Context, "Behavior")) && graph_field_command(event.Id))) {
                    return
                }
                if !Enabled[i] {
                    send_event<"StudioStatus">(self, "warning", "This command is unavailable in the current document.")
                    return
                }
                if text_equal(event.Id, "find") {
                    if text_equal(Context, "Outliner") {
                        await send_event<"StudioOutlinerFind">(self)
                    }
                    if text_equal(Context, "Properties") {
                        await send_event<"StudioObjectPropertiesFind">(self)
                    }
                    if text_equal(Context, "Assets") {
                        await send_event<"StudioShellCommand">(self, "findAssets", "")
                    }
                    if text_equal(Context, "Output") {
                        await send_event<"StudioShellCommand">(self, "findOutput", "")
                    }
                    if text_equal(Context, "Outliner") || text_equal(Context, "Properties") || text_equal(Context, "Assets") || text_equal(Context, "Output") {
                        await send_event<"StudioPaletteClose">(self)
                        return
                    }
                }
                destination := row.destination
                command := event.Id
                if text_equal(Context, "Assets") && text_equal(event.Id, "undo") {
                    destination = "resource"
                    command = "undoAssetDeletion"
                }
                if text_equal(Context, "Assets") && text_equal(event.Id, "redo") {
                    destination = "resource"
                    command = "redoAssetDeletion"
                }
                contextual := text_equal(event.Id, "undo") || text_equal(event.Id, "redo") || text_equal(event.Id, "cut") || text_equal(event.Id, "copy") || text_equal(event.Id, "paste") || text_equal(event.Id, "selectAll") || text_equal(event.Id, "find")
                if contextual && text_equal(Context, "Text Editor") {
                    destination = "text"
                }
                if (graph_command(event.Id) || contextual || text_equal(event.Id, "duplicate") || text_equal(event.Id, "delete") || text_equal(event.Id, "rename") || text_equal(event.Id, "showLiveValues")) && (text_equal(Context, "Graph") || text_equal(Context, "Behavior")) {
                    destination = "graph"
                }
                switch destination {
                    case "shell": {
                        send_event<"StudioShellCommand">(self, event.Id, event.Argument)
                    }
                    case "document": {
                        send_event<"StudioDocumentCommand">(self, event.Id, event.Argument)
                    }
                    case "resource": {
                        send_event<"StudioResourceCommand">(self, command, event.Argument)
                    }
                    case "scene": {
                        send_event<"StudioSceneCommand">(self, event.Id, event.Argument)
                    }
                    case "graph": {
                        send_event<"StudioGraphCommand">(self, event.Id, event.Argument)
                    }
                    case "text": {
                        send_event<"StudioTextCommand">(self, event.Id, event.Argument)
                    }
                    case "debug": {
                        send_event<"StudioDebugCommand">(self, event.Id, event.Argument)
                    }
                    case "collaboration": {
                        send_event<"StudioCollaborationCommand">(self, event.Id, event.Argument)
                    }
                }
                if !text_equal(event.Id, "search") {
                    await send_event<"StudioPaletteClose">(self)
                }
                if Uses[i] < 1000000 {
                    Uses[i] += 1
                }
                await set_saved_number(format_text("studio.commandUses.{}", row.id), cast<double>(Uses[i]))
                persist_recent()
                return
            }
            i += 1
        }
        send_event<"StudioStatus">(self, "error", "Unknown command.")
    }
    on StudioKey_search {
        dispatch_key("search")
    }
    on StudioKey_settings {
        dispatch_key("settings")
    }
    on StudioKey_save {
        dispatch_key("save")
    }
    on StudioKey_saveAll {
        dispatch_key("saveAll")
    }
    on StudioKey_revert {
        dispatch_key("revert")
    }
    on StudioKey_undo {
        dispatch_key("undo")
    }
    on StudioKey_redo {
        dispatch_key("redo")
    }
    on StudioKey_duplicate {
        dispatch_key("duplicate")
    }
    on StudioKey_delete {
        dispatch_key("delete")
    }
    on StudioKey_openPrototype {
        dispatch_key("openPrototype")
    }
    on StudioKey_frame {
        dispatch_key("frame")
    }
    on StudioKey_resetCamera {
        dispatch_key("resetCamera")
    }
    on StudioKey_hideSelected {
        dispatch_key("hideSelected")
    }
    on StudioKey_hideUnselected {
        dispatch_key("hideUnselected")
    }
    on StudioKey_showAll {
        dispatch_key("showAll")
    }
    on StudioKey_toggleAssets {
        dispatch_key("toggleAssets")
    }
    on StudioKey_toggleOutput {
        dispatch_key("toggleOutput")
    }
    on StudioKey_togglePerformance {
        dispatch_key("togglePerformance")
    }
    on StudioKey_maximize {
        dispatch_key("maximize")
    }
    on StudioKey_resetLayout {
        dispatch_key("resetLayout")
    }
    on StudioKey_zoomIn {
        dispatch_key("zoomIn")
    }
    on StudioKey_zoomOut {
        dispatch_key("zoomOut")
    }
    on StudioKey_zoomReset {
        dispatch_key("zoomReset")
    }
    on StudioKey_play {
        dispatch_key("play")
    }
    on StudioKey_stop {
        dispatch_key("stop")
    }
    on StudioKey_step {
        dispatch_key("step")
    }
    on StudioKey_recordGameplay {
