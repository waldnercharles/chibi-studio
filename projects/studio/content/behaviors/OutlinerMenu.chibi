// Keeps the Outliner's row menu current: its heading names the selection, Break
// When Spawned shows whether the selection's prototype breaks, and the Live and
// object items follow the run; sets the eye's Alt+click tip for the platform.
OutlinerMenu :: behavior {
    action set_ui_data_8 = set_ui_data(0, "menu.actor", convert<To_Real>(selection().Count) > 0)
    on Begin {
        await set_ui_data(0, "menu.spawnBreak.label", string("Break When Spawned"))
        await set_ui_data(0, "menu.spawnBreak.icon", string(""))
        await set_ui_data(0, "menu.spawnBreak.shortcut", string(""))
        if editor_state().Mac {
            set_ui_data(0, "isolateTip", string("⌥-click shows only this object"))
        } else {
            set_ui_data(0, "isolateTip", string("Alt+click shows only this object"))
        }
    }
    on Refresh {
        Count := selection().Count
        if convert<To_Real>(Count) == 1 {
            await set_ui_data(0, "menu.label", selection().Name)
            set_ui_data_8()
        } else {
            await set_ui_data(0, "menu.label", format_text("{} objects", Count))
            set_ui_data_8()
        }
    }
    after set_ui_data_8 {
        await set_ui_data(0, "menu.live", editor_state().Live)
        set_ui_data(0, "menu.spawnBreak.checked", breaks_when_spawned(selection().Prototype))
    }
}
