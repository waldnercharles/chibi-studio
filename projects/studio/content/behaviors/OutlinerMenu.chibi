behavior "OutlinerMenu" {
    action set_ui_data_8 = set_ui_data(0, "menu.actor", convert<"To Real">(selection().Count) > 0)
    on Begin {
        await set_ui_data(0, "menu.spawnBreak.label", engine["String"]("Break When Spawned"))
        await set_ui_data(0, "menu.spawnBreak.icon", engine["String"](""))
        await set_ui_data(0, "menu.spawnBreak.shortcut", engine["String"](""))
        if editor_state().Mac {
            set_ui_data(0, "isolateTip", engine["String"]("⌥-click shows only this object"))
        } else {
            set_ui_data(0, "isolateTip", engine["String"]("Alt+click shows only this object"))
        }
    }
    on Refresh {
        Count := selection().Count
        if convert<"To Real">(Count) == 1 {
            await set_ui_data(0, "menu.label", selection().Name)
            set_ui_data_8()
        } else {
            await set_ui_data(0, "menu.label", format_text("{} objects", Count))
            set_ui_data_8()
        }
    }
    after set_ui_data_8 {
        await set_ui_data(0, "menu.live", editor_state().Live)
        set_ui_data(0, "menu.spawnBreak.checked", breaks_when_spawned(selection().Prototype))
    }
}
