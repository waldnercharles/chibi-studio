// Renames an object in its Outliner row: a committed name renames it as one
// Undo step and closes the field; Escape closes it first, so nothing commits;
// Enter and Escape return the keyboard to the list; a field left without a
// commit closes at the refresh after its events.
OutlinerRename :: behavior {
    // Rename
    Left: string = ""
    // Commits only while this row still renames: Escape ended the rename before
    // its field's blur commits.
    on RenameCommitted :: (Key: string, Name: string) {
        if text_equal(renaming_object(), Key) {
            await rename_object(Key, Name)
            end_rename()
        }
    }
    on RenameCancel :: () {
        await end_rename()
        focus_ui_element(0, "#outliner-list")
    }
    on RenameEnter :: () {
        focus_ui_element(0, "#outliner-list")
    }
    on RenameLeft :: (Key: string) {
        Left = Key
    }
    // A field left without a commit closes here, after the commit its blur may
    // also send.
    on Refresh :: () {
        if text_equal(Left, renaming_object()) {
            await end_rename()
            Left = ""
        } else {
            Left = ""
        }
    }
}
