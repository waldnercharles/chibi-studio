behavior "OutlinerRename" {
    Left: string = ""
    action left_3 = set_variable<"Left">("")
    on RenameCommitted {
        if text_equal(renaming_object(), event.Key) {
            await rename_object(event.Key, event.Name)
            end_rename()
        }
    }
    on RenameCancel {
        await end_rename()
        focus_ui_element(0, "#outliner-list")
    }
    on RenameEnter {
        focus_ui_element(0, "#outliner-list")
    }
    on RenameLeft {
        state."Left" = event.Key
    }
    on Refresh {
        if text_equal(state."Left", renaming_object()) {
            await end_rename()
            left_3()
        } else {
            left_3()
        }
    }
}
