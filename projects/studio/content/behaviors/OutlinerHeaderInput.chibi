// The Outliner's header: the filter field sets the object filter the rows and
// Up and Down follow, and shows it when Studio clears it; Add lists the scene's
// prototypes and places the one chosen, while the scene is editable.
OutlinerHeaderInput :: behavior {
    action prototype_choices_action = prototype_choices()
    on Refresh {
        prototype_choices_action()
    }
    after prototype_choices_action {
        await set_ui_data(0, "editable", editor_state().Editable)
        await set_ui_data(0, "filter", scene_info().Filter)
        set_ui_data(0, "prototypes", prototype_choices_action.Options)
    }
    on FilterTyped {
        set_object_filter(event.Filter)
    }
    on AddObject {
        add_object(event.Prototype)
    }
}
