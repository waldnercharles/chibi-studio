behavior "OutlinerHeaderInput" {
    action prototype_choices = engine["Prototype Choices"]()
    on Refresh {
        prototype_choices()
    }
    after prototype_choices {
        await set_ui_data(0, "editable", editor_state().Editable)
        await set_ui_data(0, "filter", scene_info().Filter)
        set_ui_data(0, "prototypes", prototype_choices.Options)
    }
    on FilterTyped {
        set_object_filter(event.Filter)
    }
    on AddObject {
        add_object(event.Prototype)
    }
}
