OutlinerRows :: behavior {
    First: int = 0
    Count: int = 0
    Collapsed: bool = false
    ShownOpen: bool = true

    on Begin {
    }

    on ShowRows {
        state.First = event.First
        state.Count = event.Count
    }

    on Refresh {
        captured := capture_outliner()
        projected := OutlinerRowPolicies.Project(
            captured.Actors, captured.Prototypes, captured.ComponentIcons,
            captured.FieldKinds, captured.AttachmentEntities, captured.Scene,
            First, Count, Collapsed, ""
        )
        if publish_outliner(projected.Projection, projected.Rows) {
            ShownOpen = !Collapsed
        }
    }

    on FoldRoot {
        Collapsed = true
    }

    on UnfoldRoot {
        Collapsed = false
    }

    on ToggleRoot {
        Collapsed = !Collapsed
    }

    on RootClicked {
        if (event.Open && !ShownOpen) || (!event.Open && ShownOpen) {
            Collapsed = !event.Open
        }
    }

    on RevealObject {
        Collapsed = false
        captured := capture_outliner()
        projected := OutlinerRowPolicies.Project(
            captured.Actors, captured.Prototypes, captured.ComponentIcons,
            captured.FieldKinds, captured.AttachmentEntities, captured.Scene,
            First, Count, Collapsed, event.Object
        )
        if publish_outliner(projected.Projection, projected.Rows) {
            ShownOpen = !Collapsed
        }
    }
}
