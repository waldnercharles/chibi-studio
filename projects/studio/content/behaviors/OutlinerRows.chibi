behavior "OutlinerRows" {
    First: int = 0
    Count: int = 0
    Collapsed := false
    ShownOpen := true
    action scene_objects = engine["Scene Objects"](convert<"To Integer">("max(First - 1, 0)"(First)), convert<"To Integer">("Count - 1 + step(1, First)"(Count, First)))
    action branch_3 = engine["Branch"](convert<"To Real">(scene_objects.Shown) > 0)
    on Begin {
        await set_ui_data(0, "root.icon", engine["String"](""))
        await set_ui_data(0, "root.parent", engine["Bool"](true))
        set_ui_data(0, "root.depth", integer(0))
    }
    on ShowRows {
        state."First" = event.First
        state."Count" = event.Count
    }
    on Refresh {
        scene_objects()
    }
    after scene_objects {
        await set_ui_data(0, "rootShown", cast<double>(First) == 0)
        Shown := scene_objects.Shown
        await set_ui_data(0, "count", Shown)
        await set_ui_data(0, "root.label", scene_info().Title)
        await set_ui_data(0, "root.open", !Collapsed)
        state."ShownOpen" = !Collapsed
        if Collapsed {
            await set_ui_data(0, "rows", clear(scene_objects.Rows))
            await set_ui_data(0, "total", integer(1))
            branch_3()
        } else {
            await set_ui_data(0, "rows", scene_objects.Rows)
            await set_ui_data(0, "total", "1 + Shown"(Shown))
            branch_3()
        }
    }
    after branch_3.True {
        await set_ui_data(0, "filtered", engine["Bool"](false))
        set_ui_data(0, "notice", engine["String"](""))
    }
    after branch_3.False {
        if text_equal(scene_info().Filter, "") {
            await set_ui_data(0, "filtered", engine["Bool"](false))
            set_ui_data(0, "notice", engine["String"]("No objects. Add a prototype to start."))
        } else {
            await set_ui_data(0, "filtered", engine["Bool"](true))
            set_ui_data(0, "notice", format_text("No objects match “{}”", scene_info().Filter))
        }
    }
    on FoldRoot {
        state."Collapsed" = true
    }
    on UnfoldRoot {
        state."Collapsed" = false
    }
    on ToggleRoot {
        state."Collapsed" = !Collapsed
    }
    on RootClicked {
        if (event.Open && !ShownOpen) || (!event.Open && ShownOpen) {
            state."Collapsed" = !event.Open
        }
    }
    on RevealObject {
        state."Collapsed" = false
        if convert<"To Real">(object_row(event.Object)) >= 0 {
            reveal_ui_list_row(0, "#outliner-list", convert<"To Integer">("Row + 1"(object_row(event.Object))))
        }
    }
    "max(First - 1, 0)" :: pure fn<T0: int, T1: double>(First: T0 = 0) -> (Result: T1 = 0.0) {
        return max(convert<"To Real">(entry) - real(1.0), real(0.0))
    }
    "Count - 1 + step(1, First)" :: pure fn<T0: int, T1: int, T2: double>(Count: T0 = 0, First: T1 = 0) -> (Result: T2 = 0.0) {
        return convert<"To Real">(entry.Count) - real(1.0) + step(convert<"To Real">(entry.First), real(1.0))
    }
    "1 + Shown" :: pure fn<T0: int, T1: double>(Shown: T0 = 0) -> (Result: T1 = 0.0) {
        return real(1.0) + convert<"To Real">(entry)
    }
    "Row + 1" :: pure fn<T0: int, T1: double>(Row: T0 = 0) -> (Result: T1 = 0.0) {
        return convert<"To Real">(entry) + real(1.0)
    }
}
