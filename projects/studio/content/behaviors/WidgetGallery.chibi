// Feeds the widget gallery's VirtualList ten thousand rows: it sets self.total,
// and answers ShowRows with the rows in view as self.rows.
WidgetGallery :: behavior {
    // List
    Rows: int[] = []
    action rows_2 = set_variable<Rows>(resize(Rows, 10000))
    on Begin {
        rows_2()
    }
    after rows_2 {
        set_ui_data(Name: "total", Value: length(rows_2.Value))
    }
    on ShowRows {
        set_ui_data(Name: "rows", Value: slice(Rows, event.First, event.Count))
    }
}
