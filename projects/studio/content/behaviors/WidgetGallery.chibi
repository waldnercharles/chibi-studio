behavior "WidgetGallery" {
    state Rows: int[] = []
    value rows = get_variable<"Rows">()
    action rows_2 = set_variable<"Rows">(resize(rows, 10000))
    value rows_3 = get_variable<"Rows">()
    on Begin {
        rows_2()
    }
    after rows_2 {
        set_ui_data(Name: "total", Value: length(rows_2.Value))
    }
    on ShowRows {
        set_ui_data(Name: "rows", Value: slice(rows_3, event.First, event.Count))
    }
}
