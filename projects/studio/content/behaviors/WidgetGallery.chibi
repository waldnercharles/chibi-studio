behavior "WidgetGallery" {
    state Rows: int[] = []
    action rows_2 = set_variable<"Rows">(resize(get_variable<"Rows">(), 10000))
    on Begin {
        rows_2()
    }
    after rows_2 {
        set_ui_data(Name: "total", Value: length(rows_2.Value))
    }
    on ShowRows {
        set_ui_data(Name: "rows", Value: slice(get_variable<"Rows">(), event.First, event.Count))
    }
}
