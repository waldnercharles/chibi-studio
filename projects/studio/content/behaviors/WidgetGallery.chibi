// Feeds the widget gallery's VirtualList ten thousand rows: it sets self.total,
// and answers ShowRows with the rows in view as self.rows.
WidgetGallery :: behavior {
    // List
    Rows: int[] = []
    on Begin :: () {
        Rows = resize(Rows, 10000)
        set_ui_data(Name: "total", Value: length(Rows))
    }
    on ShowRows :: (First: int, Count: int) {
        set_ui_data(Name: "rows", Value: slice(Rows, First, Count))
    }
}
