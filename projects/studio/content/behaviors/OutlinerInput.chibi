// Turns the Outliner's row events into editor actions: a click selects (Mod
// toggles, Shift extends), a right click keeps a selection it lands in and
// opens the row menu at the pointer, the eye hides or with Alt isolates, the
// lock locks, drops attach or assign on a row and place prototypes on the list,
// and the menu's Break When Spawned toggles.
OutlinerInput :: behavior {
    action show_ui_popover_action = show_ui_popover(0, "#outliner-menu", rowmenu.Pointer)
    on RowClicked {
        select_object(event.Key, event.Mod, event.Shift)
    }
    // A right click keeps a selection it lands in (Unity), then opens the row
    // menu at the pointer.
    on RowMenu as rowmenu {
        if object_selected(rowmenu.Key) {
            show_ui_popover_action()
        } else {
            await select_object(rowmenu.Key, false, false)
            show_ui_popover_action()
        }
    }
    on EyeClicked {
        if event.Alt {
            isolate_object(event.Key)
        } else {
            set_object_hidden(event.Key, !event.Hidden)
        }
    }
    on LockClicked {
        set_object_locked(event.Key, !event.Locked)
    }
    on RowDropped {
        if text_equal(event.Type, "object") {
            move_objects(event.Payload, event.Key, event.Zone)
        } else {
            drop_on_object(event.Key, event.Type, event.Payload)
        }
    }
    // A row's drop stops at the row (RowDropped), so the list takes only
    // prototypes.
    on ListDropped {
        if text_equal(event.Type, "prototype") {
            add_object(event.Payload)
        } else {
            if text_equal(event.Type, "object") {
                move_objects(event.Payload, "", "root")
            }
        }
    }
    on ClearFilter {
        set_object_filter("")
    }
    on SpawnBreak {
        toggle_spawn_break(selection().Prototype)
    }
}
