// Turns the Outliner's row events into editor actions: a click selects (Mod
// toggles, Shift extends), a right click keeps a selection it lands in and
// opens the row menu at the pointer, the eye hides or with Alt isolates, the
// lock locks, drops attach or assign on a row and place prototypes on the list,
// and the menu's Break When Spawned toggles.
OutlinerInput :: behavior {
    menu_at: vec2 = null
    action show_ui_popover_action = show_ui_popover(0, "#outliner-menu", menu_at)
    on RowClicked :: (Key: string, Shift: bool, Mod: bool) {
        select_object(Key, Mod, Shift)
    }
    // A right click keeps a selection it lands in (Unity), then opens the row
    // menu at the pointer.
    on RowMenu :: (Key: string, Pointer: vec2) {
        menu_at = Pointer
        if object_selected(Key) {
            show_ui_popover_action()
        } else {
            await select_object(Key, false, false)
            show_ui_popover_action()
        }
    }
    on EyeClicked :: (Key: string, Hidden: bool, Alt: bool) {
        if Alt {
            isolate_object(Key)
        } else {
            set_object_hidden(Key, !Hidden)
        }
    }
    on LockClicked :: (Key: string, Locked: bool) {
        set_object_locked(Key, !Locked)
    }
    on RowDropped :: (Key: string, Type: string, Payload: string, Zone: string) {
        if text_equal(Type, "object") {
            move_objects(Payload, Key, Zone)
        } else {
            drop_on_object(Key, Type, Payload)
        }
    }
    // A row's drop stops at the row (RowDropped), so the list takes only
    // prototypes.
    on ListDropped :: (Type: string, Payload: string) {
        if text_equal(Type, "prototype") {
            add_object(Payload)
        } else {
            if text_equal(Type, "object") {
                move_objects(Payload, "", "root")
            }
        }
    }
    on ClearFilter :: () {
        set_object_filter("")
    }
    on SpawnBreak :: () {
        toggle_spawn_break(selection().Prototype)
    }
}
