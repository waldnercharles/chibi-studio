// Up and Down in a SidebarNav move focus to the next or previous item and
// choose it, so the selection follows focus.
NavKeys :: behavior {
    on NavNext :: () {
        await move_ui_focus(Element: ".nav-item input", Step: 1)
        click_ui_element(Element: ".nav-item input:focus")
    }
    on NavPrevious :: () {
        await move_ui_focus(Element: ".nav-item input", Step: -1)
        click_ui_element(Element: ".nav-item input:focus")
    }
}
