version 3
name "StudioUIDesignerField"
domain "event"
id_counter 5
(array)variables {
    - id=1 name="Index" type="int" category="Payload"
    - id=2 name="Name" type="const char *" category="Payload"
    - id=3 name="Value" type="const char *" category="Payload"
    - id=4 name="Remove" type="bool" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
