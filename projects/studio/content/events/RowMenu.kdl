version 3
name "RowMenu"
domain "event"
id_counter 3
description "A row was right-clicked at Pointer, in the document's pixels, where its menu opens."
(array)variables {
    - id=1 name="Key" type="const char *" category="Payload"
    - id=2 name="Pointer" type="struct" type_name="CF_V2" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
