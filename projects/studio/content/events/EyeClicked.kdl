version 3
name "EyeClicked"
domain "event"
id_counter 4
description "A row's eye was clicked; Hidden is whether its object was hidden, and Alt was held."
(array)variables {
    - id=1 name="Key" type="const char *" category="Payload"
    - id=2 name="Hidden" type="bool" category="Payload"
    - id=3 name="Alt" type="bool" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
