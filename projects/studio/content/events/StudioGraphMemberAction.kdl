version 3
name "StudioGraphMemberAction"
domain "event"
id_counter 6
(array)variables {
    - id=1 name="Action" type="const char *" category="Payload"
    - id=2 name="Index" type="int" category="Payload"
    - id=3 name="Value" type="const char *" category="Payload"
    - id=4 name="Document" type="int" category="Payload"
    - id=5 name="Revision" type="int" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
