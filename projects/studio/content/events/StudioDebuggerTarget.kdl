version 3
name "StudioDebuggerTarget"
domain "event"
id_counter 5
(array)variables {
    - id=1 name="Name" type="const char *" category="Payload"
    - id=2 name="Owner" type="uint64" category="Payload"
    - id=3 name="Session" type="int" category="Payload"
    - id=4 name="Revision" type="int" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
