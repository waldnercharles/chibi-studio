version 3
name "StudioDebuggerPoint"
domain "event"
id_counter 5
(array)variables {
    - id=1 name="Id" type="const char *" category="Payload"
    - id=2 name="Kind" type="const char *" category="Payload"
    - id=3 name="Index" type="int" category="Payload"
    - id=4 name="Revision" type="int" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
