version 3
name "StudioRuntimeStopped"
domain "event"
id_counter 6
(array)variables {
    - id=1 name="Session" type="int" category="Payload"
    - id=2 name="Document" type="int" category="Payload"
    - id=3 name="Revision" type="int" category="Payload"
    - id=4 name="Ok" type="bool" category="Payload"
    - id=5 name="Error" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
