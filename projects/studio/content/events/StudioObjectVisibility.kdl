version 3
name "StudioObjectVisibility"
domain "event"
id_counter 6
(array)variables {
    - id=1 name="Document" type="int" category="Payload"
    - id=2 name="Revision" type="int" category="Payload"
    - id=3 name="Hidden" type="const char *" container=1 category="Payload"
    - id=4 name="Locked" type="const char *" container=1 category="Payload"
    - id=5 name="Isolated" type="const char *" container=1 category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
