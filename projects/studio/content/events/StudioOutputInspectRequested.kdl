version 3
name "StudioOutputInspectRequested"
domain "event"
id_counter 5
(array)variables {
    - id=1 name="Document" type="int" category="Payload"
    - id=2 name="Revision" type="int" category="Payload"
    - id=3 name="Offset" type="int" category="Payload"
    - id=4 name="Id" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
