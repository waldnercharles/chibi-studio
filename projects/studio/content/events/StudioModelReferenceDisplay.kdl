version 3
name "StudioModelReferenceDisplay"
domain "event"
id_counter 5
(array)variables {
    - id=1 name="Document" type="int" category="Payload"
    - id=2 name="Revision" type="int" category="Payload"
    - id=3 name="Visible" type="bool" category="Payload"
    - id=4 name="Opacity" type="float" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
