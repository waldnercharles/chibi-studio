version 3
name "StudioScenePointer"
domain "event"
id_counter 9
(array)variables {
    - id=1 name="Action" type="const char *" category="Payload"
    - id=2 name="Session" type="int" category="Payload"
    - id=3 name="LocalPointer" type="struct" type_name="CF_V2" category="Payload"
    - id=4 name="Delta" type="struct" type_name="CF_V2" category="Payload"
    - id=5 name="Wheel" type="struct" type_name="CF_V2" category="Payload"
    - id=6 name="Button" type="int" category="Payload"
    - id=7 name="Shift" type="bool" category="Payload"
    - id=8 name="Mod" type="bool" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
