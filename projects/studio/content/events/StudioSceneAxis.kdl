version 3
name "StudioSceneAxis"
domain "event"
id_counter 8
(array)variables {
    - id=1 name="Action" type="const char *" category="Payload"
    - id=2 name="Axis" type="const char *" category="Payload"
    - id=3 name="Delta" type="struct" type_name="CF_V2" category="Payload"
    - id=4 name="Value" type="float" category="Payload"
    - id=5 name="Canceled" type="bool" category="Payload"
    - id=6 name="LocalPointer" type="struct" type_name="CF_V2" category="Payload"
    - id=7 name="Mod" type="bool" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
