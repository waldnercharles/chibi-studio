version 3
name "StudioUICanvasPointer"
domain "event"
id_counter 8
(array)variables {
    - id=1 name="Action" type="const char *" category="Payload"
    - id=2 name="Document" type="int" category="Payload"
    - id=3 name="Revision" type="int" category="Payload"
    - id=4 name="LocalPointer" type="struct" type_name="CF_V2" category="Payload"
    - id=5 name="Delta" type="struct" type_name="CF_V2" category="Payload"
    - id=6 name="Button" type="int" category="Payload"
    - id=7 name="Canceled" type="bool" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
