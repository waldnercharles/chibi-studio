version 3
name "StudioNoticeAction"
domain "event"
id_counter 4
(array)variables {
    - id=1 name="Owner" type="const char *" category="Payload"
    - id=2 name="Request" type="int" category="Payload"
    - id=3 name="Action" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
