version 3
name "StudioTextViewState"
domain "event"
id_counter 11
(array)variables {
    - id=1 name="Request" type="int" category="Payload"
    - id=2 name="Document" type="int" category="Payload"
    - id=3 name="Path" type="const char *" category="Payload"
    - id=4 name="Revision" type="int" category="Payload"
    - id=5 name="Start" type="int" category="Payload"
    - id=6 name="End" type="int" category="Payload"
    - id=7 name="Caret" type="int" category="Payload"
    - id=8 name="VimMode" type="const char *" category="Payload"
    - id=9 name="Ready" type="bool" category="Payload"
    - id=10 name="Error" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
