version 3
name "StudioSceneInputKey"
domain "event"
id_counter 8
(array)variables {
    - id=1 name="Action" type="const char *" category="Payload"
    - id=2 name="Session" type="int" category="Payload"
    - id=3 name="Key" type="const char *" category="Payload"
    - id=4 name="Mod" type="bool" category="Payload"
    - id=5 name="Shift" type="bool" category="Payload"
    - id=6 name="Alt" type="bool" category="Payload"
    - id=7 name="Modifiers" type="int" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
