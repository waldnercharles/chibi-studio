version 3
name "RowDropped"
domain "event"
id_counter 5
description "A drag of Type carrying Payload was dropped before, inside or after row Key, as Zone names."
(array)variables {
    - id=1 name="Key" type="const char *" category="Payload"
    - id=2 name="Type" type="const char *" category="Payload"
    - id=3 name="Payload" type="const char *" category="Payload"
    - id=4 name="Zone" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
