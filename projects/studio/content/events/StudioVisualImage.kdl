version 3
name "StudioVisualImage"
domain "event"
id_counter 4
(array)variables {
    - id=1 name="Id" type="const char *" category="Payload"
    - id=2 name="Document" type="int" category="Payload"
    - id=3 name="Value" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
