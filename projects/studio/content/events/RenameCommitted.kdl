version 3
name "RenameCommitted"
domain "event"
id_counter 3
description "The name field of the row Key names committed Name, with Enter or by losing focus."
(array)variables {
    - id=1 name="Key" type="const char *" category="Payload"
    - id=2 name="Name" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
