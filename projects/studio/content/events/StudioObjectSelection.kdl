version 3
name "StudioObjectSelection"
domain "event"
id_counter 5
(array)variables {
    - id=1 name="Document" type="int" category="Payload"
    - id=2 name="Revision" type="int" category="Payload"
    - id=3 name="Kind" type="const char *" category="Payload"
    - id=4 name="Paths" type="const char *" container=1 category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
