version 3
name "RevealObject"
domain "event"
id_counter 2
description "Studio asks the panels that list objects to show Object, the active one after Up, Down, a Find jump or F2, as Unity's Hierarchy pings an object."
(array)variables {
    - id=1 name="Object" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
