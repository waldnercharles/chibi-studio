version 3
name "StudioPanelRegistered"
domain "event"
id_counter 5
(array)variables {
    - id=1 name="Key" type="const char *" category="Payload"
    - id=2 name="Name" type="const char *" category="Payload"
    - id=3 name="Document" type="const char *" category="Payload"
    - id=4 name="Owner" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
