version 3
name "StudioVisualParameter"
domain "event"
id_counter 7
(array)variables {
    - id=1 name="Document" type="int" category="Payload"
    - id=2 name="Slot" type="int" category="Payload"
    - id=3 name="Axis" type="int" category="Payload"
    - id=4 name="Value" type="double" category="Payload"
    - id=5 name="Committed" type="bool" category="Payload"
    - id=6 name="Canceled" type="bool" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
