version 3
name "StudioDebuggerActivity"
domain "event"
id_counter 9
(array)variables {
    - id=1 name="Handle" type="int" category="Payload"
    - id=2 name="Session" type="int" category="Payload"
    - id=3 name="Generation" type="uint64" category="Payload"
    - id=4 name="Owner" type="uint64" category="Payload"
    - id=5 name="Retired" type="bool" category="Payload"
    - id=6 name="Rows" type="struct" type_name="WorkspaceDebugActivity" container=1 category="Payload"
    - id=7 name="Dropped" type="uint64" category="Payload"
    - id=8 name="Error" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
