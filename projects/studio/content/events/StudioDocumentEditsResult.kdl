version 3
name "StudioDocumentEditsResult"
domain "event"
id_counter 9
(array)variables {
    - id=1 name="Document" type="int" category="Payload"
    - id=2 name="ExpectedRevision" type="int" category="Payload"
    - id=3 name="Ok" type="bool" category="Payload"
    - id=4 name="Documents" type="int" container=1 category="Payload"
    - id=5 name="Revisions" type="int" container=1 category="Payload"
    - id=6 name="Error" type="const char *" category="Payload"
    - id=7 name="Owner" type="const char *" category="Payload"
    - id=8 name="Request" type="int" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
