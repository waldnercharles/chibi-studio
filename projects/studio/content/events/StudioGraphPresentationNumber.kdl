version 3
name "StudioGraphPresentationNumber"
domain "event"
id_counter 6
(array)variables {
    - id=1 name="Id" type="const char *" category="Payload"
    - id=2 name="Value" type="float" category="Payload"
    - id=3 name="Canceled" type="bool" category="Payload"
    - id=4 name="Document" type="int" category="Payload"
    - id=5 name="Revision" type="int" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
