version 3
name "StudioRuntimePropertiesReveal"
domain "event"
id_counter 5
(array)variables {
    - id=1 name="Session" type="int" category="Payload"
    - id=2 name="Subject" type="const char *" category="Payload"
    - id=3 name="Component" type="const char *" category="Payload"
    - id=4 name="Field" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
