version 3
name "StudioDocumentFlushReady"
domain "event"
id_counter 5
(array)variables {
    - id=1 name="Document" type="int" category="Payload"
    - id=2 name="Request" type="int" category="Payload"
    - id=3 name="Ok" type="bool" category="Payload"
    - id=4 name="Error" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
