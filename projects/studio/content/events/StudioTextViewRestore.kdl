version 3
name "StudioTextViewRestore"
domain "event"
id_counter 8
(array)variables {
    - id=1 name="Document" type="int" category="Payload"
    - id=2 name="Path" type="const char *" category="Payload"
    - id=3 name="Revision" type="int" category="Payload"
    - id=4 name="Start" type="int" category="Payload"
    - id=5 name="End" type="int" category="Payload"
    - id=6 name="Caret" type="int" category="Payload"
    - id=7 name="VimMode" type="const char *" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
