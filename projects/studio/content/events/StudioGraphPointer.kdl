version 3
name "StudioGraphPointer"
domain "event"
id_counter 12
(array)variables {
    - id=1 name="Action" type="const char *" category="Payload"
    - id=2 name="Index" type="int" category="Payload"
    - id=3 name="Document" type="int" category="Payload"
    - id=4 name="Revision" type="int" category="Payload"
    - id=5 name="Pointer" type="struct" type_name="CF_V2" category="Payload"
    - id=6 name="Delta" type="struct" type_name="CF_V2" category="Payload"
    - id=7 name="Wheel" type="struct" type_name="CF_V2" category="Payload"
    - id=8 name="Button" type="int" category="Payload"
    - id=9 name="Shift" type="bool" category="Payload"
    - id=10 name="Mod" type="bool" category="Payload"
    - id=11 name="LocalPointer" type="struct" type_name="CF_V2" category="Payload"
}
(array)graphs {
    - kind="event" name=""
}
