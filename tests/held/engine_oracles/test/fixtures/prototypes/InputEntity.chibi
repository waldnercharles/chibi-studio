package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("InputEntity")),
            data.Field.Named("components", data.Object([
                data.Field.Named("GAME.GameAppearance", data.Object([
                    data.Field.Named("antialias", data.Value.Real(1.0)),
                    data.Field.Named("color", data.Value.UInt(1938931455)),
                    data.Field.Named("height", data.Value.Real(32.0)),
                    data.Field.Named("width", data.Value.Real(32.0))
                ])),
                data.Field.Named("GAME.GameBody", data.Object([
                    data.Field.Named("type", data.Value.Text("Dynamic"))
                ])),
                data.Field.Named("GAME.GameCollider", data.Object([
                    data.Field.Named("category", data.Value.UInt(1)),
                    data.Field.Named("radius", data.Value.Real(16.0))
                ])),
                data.Field.Named("GAME.GameHealth", data.Object([
                    data.Field.Named("current", data.Value.UInt(100)),
                    data.Field.Named("maximum", data.Value.UInt(100))
                ])),
                data.Field.Named("GAME.GameInput", data.Object([])),
                data.Field.Named("GAME.GameMovement", data.Object([
                    data.Field.Named("speed", data.Value.Real(180.0))
                ])),
                data.Field.Named("GAME.GameOrientation", data.Object([])),
                data.Field.Named("GAME.GameTransform", data.Object([
                    data.Field.Named("x", data.Value.Real(320.0)),
                    data.Field.Named("y", data.Value.Real(180.0))
                ])),
                data.Field.Named("GAME.GameVelocity", data.Object([]))
            ])),
            data.Field.Named("behaviors", data.List([
                data.Value.Text("InputBehavior")
            ]))
        ])
    )
}
