behavior "Pursuit" {
    owner "ecs.entity";
    value find_nearest_entity = find_nearest_entity(Position: &component("GAME.GameTransform"), Radius: 600.0, Categories: 1, Exclude: 0);
    value direction_speed_velocity = (direction_to(Origin: &component("GAME.GameTransform"), Target: convert<"game_transform_to_cf">(find_nearest_entity.Position)) * cast<double>(&component("GAME.GameMovement", "speed")) - &component("GAME.GameVelocity"));
    on Tick as tick(DeltaSeconds: float = 0.0) {
        if (find_nearest_entity.Found) {
            &component("GAME.GameVelocity") += direction_speed_velocity * min(1, 120.0 * cast<double>(&delta) / max(length(direction_speed_velocity), 0.0001));
        } else {
            &component("GAME.GameVelocity") = vec2(0, 0);
        }
    }
}
