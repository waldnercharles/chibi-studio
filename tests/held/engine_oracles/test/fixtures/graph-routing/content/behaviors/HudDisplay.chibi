behavior "HudDisplay" {
    owner "ecs.entity";
    value get_global_variable: handle<"ecs.entity"> = get_global_variable(Name: "Player");
    value has_component = has_component(Component: "GAME.GameHealth", Entity: &local.player);
    value get_component = get_component(Component: "GAME.GameHealth", Entity: &local.player);
    value current_max_maximum_1 = "current / max(maximum, 1)"(current: int = &local.current, maximum: int = &local.maximum);
    value get_component_2 = get_component(Component: "GAME.GameVelocity", Entity: &local.player);
    value length_vec2_velocity_x_velocity_y = "length(vec2(velocity.x, velocity.y))"(velocity: struct<"GameVelocity"> = get_component_2);
    local player = get_global_variable;
    local hull = current_max_maximum_1;
    local current = get_component.Value.current;
    local maximum = get_component.Value.maximum;
    local alive = has_component;
    on Tick as tick(DeltaSeconds: float = 0.0) {
        if (&local.alive) {
            await set_ui_value(Entity: 0, Element: "#hull .bar", Value: &local.hull);
            await set_ui_text(Entity: 0, Element: "#hull .readout", Text: format_text(Format: "{} / {}", Arg0: int = &local.current, Arg1: plain int = &local.maximum));
            await set_ui_value(Entity: 0, Element: "#speed", Value: length_vec2_velocity_x_velocity_y);
            if (&local.hull < 0.3) {
                set_ui_class(Entity: 0, Element: "#hull", Class: "critical", On: true);
            } else {
                set_ui_class(Entity: 0, Element: "#hull", Class: "critical", On: false);
            }
        } else {
            await set_ui_value(Entity: 0, Element: "#hull .bar", Value: 0.0);
            set_ui_text(Entity: 0, Element: "#status", Text: "Ship lost");
        }
    }
    on Repair as repair() {
        if (&local.alive) {
            set_component(Component: "GAME.GameHealth", Entity: &local.player, Value.current: int = &local.maximum);
        } else {
        }
    }
    pure function "current / max(maximum, 1)"<T0: int, T1: int, T2: double>(current: T0 = 0, maximum: T1 = 0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        value real = real(Value: 1.0);
        value max = max(A: double = convert<"To Real">(entry.maximum), B: double = real);
        value divide = divide(A: double = convert<"To Real">(entry.current), B: double = max);
        result Result: double = divide;
    }
    pure function "length(vec2(velocity.x, velocity.y))"<T0: struct<"GameVelocity">, T1: double>(velocity: T0 = null) -> (Result: T1 = 0.0) {
        depth_limit 64;
        value make_cf_v2 = make_cf_v2(x: entry.velocity.x, y: entry.velocity.y);
        value vector_length = vector_length(Value: make_cf_v2);
        result Result: double = vector_length;
    }
}
