package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("name", data.Value.Text("Projectile")),
            data.Field.Named("components", data.Object([
                data.Field.Named("GAME.GameProjectile", data.Object([]))
            ]))
        ])
    )
}
