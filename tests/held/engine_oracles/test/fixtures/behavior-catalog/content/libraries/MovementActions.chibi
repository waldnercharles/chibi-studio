library "MovementActions" {
    pure function "Movement Velocity"<T0: struct<"CF_V2">, T1: struct<"GameMovement">, T2: struct<"CF_V2">>(direction: T0 = null, speed: T1 = null) -> (Velocity: T2 = null) {
        depth_limit 64;
        value multiply = multiply(A: struct<"CF_V2"> = entry.direction, B: float = convert<"Unwrap_GameMovement">(entry.speed));
        result Velocity: struct<"CF_V2"> = multiply;
    }
}
