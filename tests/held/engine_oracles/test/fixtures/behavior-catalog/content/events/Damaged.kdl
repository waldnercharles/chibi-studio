version 3
name "Damaged"
domain "event"
id_counter 4
description "Accepted health loss after damage is applied. Amount is the actual health lost."
(array)variables {
    - id=2 name="Amount" type="int" type_name="int" category="Payload"
    - id=3 name="Source" type="handle" type_name="ecs.entity" category="Payload"
}
(array)graphs {
    - kind="event" name="Events"
}
