version 3
name "SmoothUnion"
domain "shape"
bounds_x 52.0
bounds_y 34.0
id_counter 38
description "Two circles joined by a smooth union. Radius and Smoothness are exposed; bounds are explicit half extents."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - id=1 type="Shader Shape Output"
            - id=3 type="Shader Position"
            - {
                id 5
                type "Shader Parameter"
                reference_name "Radius"
                outputs Value=24.0
            }
            - {
                id 7
                type "Shader Parameter"
                reference_id 1
                reference_name "Smoothness"
                outputs Value=12.0
            }
            - {
                id 9
                type "Shader Vector2"
                inputs X=-18.0
            }
            - {
                id 13
                type "Shader Vector2"
                inputs X=18.0
            }
            - id=17 type="Shader Subtract"
            - id=21 type="Shader Subtract"
            - id=25 type="Shader Circle"
            - id=29 type="Shader Circle"
            - id=33 type="Shader SmoothUnion"
        }
        (array)edges {
            - from="3.Position" to="17.A"
            - from="3.Position" to="21.A"
            - from="5.Value" to="25.Radius"
            - from="5.Value" to="29.Radius"
            - from="7.Value" to="33.Smoothness"
            - from="9.Value" to="17.B"
            - from="13.Value" to="21.B"
            - from="17.Value" to="25.Position"
            - from="21.Value" to="29.Position"
            - from="25.Value" to="33.A"
            - from="29.Value" to="33.B"
            - from="33.Value" to="1.Distance"
        }
    }
}
