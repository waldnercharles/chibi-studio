version 3
name "ShaderMath"
domain "shader-library"
id_counter 163
description "Shared pulse and ring masking functions with explicit inputs."
(array)graphs {
    - kind="event" name="Functions"
    - {
        id 56
        kind "function"
        name "Pulse"
        entry_id 57
        return_id 59
        call_depth_limit 64
        (array)nodes {
            - {
                id 57
                type "Function Entry"
                (array)outputs {
                    - id=61 name="Time" type="float" kind="data"
                    - id=62 name="Speed" type="float" kind="data"
                }
            }
            - {
                id 59
                type "Return"
                (array)inputs {
                    - id=63 name="Brightness" type="float" kind="data"
                }
            }
            - id=64 type="Shader Multiply"
            - id=68 type="Shader Sin"
            - {
                id 71
                type "Shader Add"
                inputs {
                    B type_name="float" default=1.0
                }
            }
            - {
                id 75
                type "Shader Multiply"
                inputs {
                    B type_name="float" default=0.5
                }
            }
        }
        (array)edges {
            - from="57.Time" to="64.A"
            - from="57.Speed" to="64.B"
            - from="64.Value" to="68.Value"
            - from="68.Value" to="71.A"
            - from="71.Value" to="75.A"
            - from="75.Value" to="59.Brightness"
        }
    }
    - {
        id 102
        kind "function"
        name "Ring Mask"
        entry_id 103
        return_id 107
        call_depth_limit 64
        (array)nodes {
            - {
                id 103
                type "Function Entry"
                (array)outputs {
                    - {
                        id 104
                        name "Position"
                        type "struct"
                        type_name "ShaderVec2"
                        kind "data"
                        default x=0.0 y=0.0
                    }
                    - id=105 name="Radius" type="float" kind="data" default=35.0
                    - id=106 name="Width" type="float" kind="data" default=3.0
                }
            }
            - {
                id 107
                type "Return"
                (array)inputs {
                    - id=108 name="Mask" type="float" kind="data"
                }
            }
            - {
                id 110
                type "Shader Circle"
                inputs {
                    Position {
                        default x=0.0 y=0.0
                    }
                }
            }
            - {
                id 114
                type "Shader Abs"
                inputs {
                    Value flags=0 group=0
                }
                outputs {
                    Value flags=0 group=0
                }
            }
            - {
                id 117
                type "Shader Max"
                inputs {
                    A flags=0 group=0
                    B flags=0 group=0 default=0.001
                }
                outputs {
                    Value flags=0 group=0
                }
            }
            - {
                id 121
                type "Shader Divide"
                inputs {
                    A flags=0 group=0
                    B flags=0 group=0
                }
                outputs {
                    Value flags=0 group=0
                }
            }
            - {
                id 125
                type "Shader Subtract"
                inputs {
                    A flags=0 group=0 default=1.0
                    B flags=0 group=0
                }
                outputs {
                    Value flags=0 group=0
                }
            }
            - {
                id 129
                type "Shader Saturate"
                inputs {
                    Value flags=0 group=0
                }
                outputs {
                    Value flags=0 group=0
                }
            }
        }
        (array)edges {
            - from="103.Position" to="110.Position"
            - from="103.Radius" to="110.Radius"
            - from="103.Width" to="117.A"
            - from="110.Value" to="114.Value"
            - from="114.Value" to="121.A"
            - from="117.Value" to="121.B"
            - from="121.Value" to="125.B"
            - from="125.Value" to="129.Value"
            - from="129.Value" to="107.Mask"
        }
    }
}
