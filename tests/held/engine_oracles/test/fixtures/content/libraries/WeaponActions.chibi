library "WeaponActions" {
    pure function "Check Firing Interval"(Elapsed: float = 0.0, Cooldown: float = 0.0) -> (Ready: bool = false, Remainder: float = 0.0) {
        depth_limit 64;
        value max = max(A: float = entry.Cooldown, B: float = 0.01);
        value greater_or_equal = greater_or_equal(A: entry.Elapsed, B: max);
        value subtract = subtract(A: float = entry.Elapsed, B: float = max);
        result Ready: bool = greater_or_equal;
        result Remainder: float = subtract;
    }
    function "Fire Projectile"(Origin: struct<"CF_V2"> = null, Direction: struct<"CF_V2"> = null, Damage: int = 0, Prototype: name = "Projectile", Shooter: handle<"ecs.entity"> = 0) -> (Entity: handle<"ecs.entity"> = 0) {
        depth_limit 64;
        action spawn_prototype = engine["Spawn Prototype"](Prototype: entry.Prototype);
        value getentity_gameprojectile = get_entity_game_projectile(Entity: spawn_prototype.Entity);
        value normalize_vector_2 = vec2_norm(Value: entry.Direction);
        value multiply: struct<"CF_V2"> = multiply(A: plain struct<"CF_V2"> = normalize_vector_2.Result, B: plain float = getentity_gameprojectile.Value.speed);
        result Entity: handle<"ecs.entity"> = spawn_prototype.Entity;
        after spawn_prototype {
            await set_entity_game_transform(Entity: spawn_prototype.Entity, Value: entry.Origin);
            await set_entity_game_velocity(Entity: spawn_prototype.Entity, Value: multiply);
            await set_entity_game_orientation(Entity: spawn_prototype.Entity, Value: "DirectionMath"."Direction Orientation"(X: normalize_vector_2.Result.x, Y: normalize_vector_2.Result.y));
            await set_game_projectile_damage(Value: entry.Damage, Target: spawn_prototype.Entity);
            await set_game_collider_ignore_entity(Value: entry.Shooter, Target: spawn_prototype.Entity);
            return();
        }
        after entry {
            spawn_prototype();
        }
    }
}
