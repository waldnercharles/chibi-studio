package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("version", data.Value.UInt(3)),
            data.Field.Named("name", data.Value.Text("Died")),
            data.Field.Named("domain", data.Value.Text("event")),
            data.Field.Named("id_counter", data.Value.UInt(4)),
            data.Field.Named("description", data.Value.Text("An entity reached zero health. Source identifies the accepted lethal damage source.")),
            data.Field.Named("variables", data.List([
                data.Object([
                    data.Field.Named("id", data.Value.UInt(3)),
                    data.Field.Named("name", data.Value.Text("Source")),
                    data.Field.Named("type", data.Value.Text("handle")),
                    data.Field.Named("type_name", data.Value.Text("ecs.entity")),
                    data.Field.Named("category", data.Value.Text("Payload"))
                ])
            ])),
            data.Field.Named("graphs", data.List([
                data.Object([
                    data.Field.Named("kind", data.Value.Text("event")),
                    data.Field.Named("name", data.Value.Text("Events"))
                ])
            ]))
        ])
    )
}
