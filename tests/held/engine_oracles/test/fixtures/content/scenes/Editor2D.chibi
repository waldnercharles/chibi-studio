package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("version", data.Value.UInt(1)),
            data.Field.Named("name", data.Value.Text("Editor 2D Fixture")),
            data.Field.Named("entities", data.List([
                data.Object([
                    data.Field.Named("name", data.Value.Text("Floor")),
                    data.Field.Named("prototype", data.Value.Text("ArenaFloor")),
                    data.Field.Named("components", data.Object([
                        data.Field.Named("GameTransform", data.Object([
                            data.Field.Named("x", data.Value.Real(220.0)),
                            data.Field.Named("y", data.Value.Real(300.0))
                        ])),
                        data.Field.Named("GameAppearance", data.Object([
                            data.Field.Named("width", data.Value.Real(665.1075)),
                            data.Field.Named("height", data.Value.Real(352.0)),
                            data.Field.Named("color", data.Value.UInt(320549119)),
                            data.Field.Named("shape", data.Value.Text("Box"))
                        ]))
                    ]))
                ]),
                data.Object([
                    data.Field.Named("name", data.Value.Text("Player")),
                    data.Field.Named("prototype", data.Value.Text("ArenaPlayer")),
                    data.Field.Named("components", data.Object([
                        data.Field.Named("GameTransform", data.Object([
                            data.Field.Named("x", data.Value.Real(400.0)),
                            data.Field.Named("y", data.Value.Real(300.0))
                        ])),
                        data.Field.Named("GameAppearance", data.Object([
                            data.Field.Named("width", data.Value.Real(20.0)),
                            data.Field.Named("height", data.Value.Real(18.0)),
                            data.Field.Named("color", data.Value.UInt(4294967295)),
                            data.Field.Named("shape", data.Value.Text("Stroked Chevron")),
                            data.Field.Named("glow_radius", data.Value.Real(8.0)),
                            data.Field.Named("glow_color", data.Value.UInt(4294967120)),
                            data.Field.Named("stroke_width", data.Value.Real(1.0)),
                            data.Field.Named("antialias", data.Value.Real(1.0))
                        ]))
                    ]))
                ]),
                data.Object([
                    data.Field.Named("name", data.Value.Text("Enemy")),
                    data.Field.Named("prototype", data.Value.Text("ArenaEnemy")),
                    data.Field.Named("components", data.Object([
                        data.Field.Named("GameTransform", data.Object([
                            data.Field.Named("x", data.Value.Real(580.0)),
                            data.Field.Named("y", data.Value.Real(300.0))
                        ])),
                        data.Field.Named("GameAppearance", data.Object([
                            data.Field.Named("width", data.Value.Real(11.0)),
                            data.Field.Named("height", data.Value.Real(11.0)),
                            data.Field.Named("color", data.Value.UInt(336527615)),
                            data.Field.Named("shape", data.Value.Text("Diamond")),
                            data.Field.Named("border_width", data.Value.Real(2.0)),
                            data.Field.Named("border_color", data.Value.UInt(4291559679)),
                            data.Field.Named("glow_radius", data.Value.Real(3.0)),
                            data.Field.Named("glow_color", data.Value.UInt(4291559488))
                        ]))
                    ]))
                ])
            ]))
        ])
    )
}
