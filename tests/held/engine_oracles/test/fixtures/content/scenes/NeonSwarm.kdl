version 1
name "Neon Swarm"
(array)entities {
    - {
        name "Encounter_1"
        prototype "Encounter"
        (array)behaviors "WaveBehavior"
    }
    - {
        name "Player_1"
        prototype "Player"
        (array)behaviors "InputBehavior" "WeaponBehavior" "HealthBehavior" "AutoWeaponBehavior" "PlayerContactBehavior" "MovementTrailBehavior"
    }
}
