components {
    GAME.EngineSystem icon="system"
    GAME.GameActionBinding tab="Gameplay" icon="keyboard"
    GAME.GameAim tab="Gameplay"
    GAME.GameAppearance {
        icon "shape"
        fields {
            antialias {
                (array)range 0 1
            }
        }
    }
    GAME.GameBody tab="Physics"
    GAME.GameCamera icon="camera"
    GAME.GameCollider {
        tab "Physics"
        fields {
            radius unit="u"
            restitution {
                (array)range 0 1
            }
            friction {
                (array)range 0 1
            }
        }
    }
    GAME.GameCombustion {
        tab "Gameplay"
        fields {
            blast_radius {
                (array)range 0 1024
                unit "u"
            }
        }
    }
    GAME.GameDash {
        fields {
            speed unit="u/s"
            cooldown unit="s"
        }
    }
    GAME.GameDestructible tab="Physics" icon="diamond"
    GAME.GameDrive {
        tab "Physics"
        fields {
            acceleration unit="u/s²"
        }
    }
    GAME.GameFluidVolume {
        tab "Physics"
        icon "water"
        fields {
            absorption {
                (array)range 0 1
            }
        }
    }
    GAME.GameFragmentGlow tab="Material"
    GAME.GameFuel tab="Gameplay"
    GAME.GameHRC2D {
        tab "Material"
        icon "light"
        fields {
            resolution {
                (array)range 0.1 1
            }
            target_fps unit="fps"
            min_resolution {
                (array)range 0.1 1
            }
            lighting_margin unit="u"
            bounce_hysteresis {
                (array)range 0 1
            }
            radiance_hysteresis {
                (array)range 0 1
            }
            trace_levels {
                (array)range 1 5
            }
            surface_radius unit="u"
            exposure unit="EV"
            bloom {
                (array)range 0 1
            }
        }
    }
    GAME.GameHealth tab="Gameplay" icon="health"
    GAME.GameInput tab="Gameplay" icon="gamepad"
    GAME.GameMaterial {
        tab "Material"
        fields {
            emission_intensity {
                (array)range 0 4
            }
            absorption {
                (array)range 0 1
            }
            edge_light {
                (array)range 0 1
            }
        }
    }
    GAME.GameMaterialCavity {
        fields {
            radius unit="u"
        }
    }
    GAME.GameMovement {
        tab "Gameplay"
        fields {
            speed unit="u/s"
        }
    }
    GAME.GameParticleEmitter {
        icon "emitter"
        fields {
            absorption {
                (array)range 0 1
            }
        }
    }
    GAME.GamePickup {
        fields {
            lifetime unit="s"
        }
    }
    GAME.GamePointLight {
        fields {
            radius unit="u"
        }
    }
    GAME.GameProjectile {
        icon "projectile"
        fields {
            speed unit="u/s"
            lifetime unit="s"
        }
    }
    GAME.GameReflection tab="Material"
    GAME.GameStarfield2D tab="Material"
    GAME.GameSubstance tab="Physics"
    GAME.GameSurfaceInfluence {
        fields {
            radius unit="u"
        }
    }
    GAME.GameTrail {
        fields {
            lifetime unit="s"
        }
    }
    GAME.GameVelocity tab="Physics"
    GAME.GameVision {
        fields {
            radius unit="u"
        }
    }
    GAME.GameWeapon {
        tab "Gameplay"
        fields {
            cooldown unit="s"
        }
    }
    GAME.MaterialBreakProfile tab="Physics"
    GAME.MaterialTerrain tab="Material" icon="terrain"
}
