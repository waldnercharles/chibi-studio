package asset

import data "game:assets"

pub Build :: () -> byte[] {
    return data.Encode(
        data.Object([
            data.Field.Named("version", data.Value.UInt(1)),
            data.Field.Named("name", data.Value.Text("Sandbox")),
            data.Field.Named("entities", data.List([
                data.Object([
                    data.Field.Named("name", data.Value.Text("Player")),
                    data.Field.Named("prototype", data.Value.Text("Player"))
                ]),
                data.Object([
                    data.Field.Named("name", data.Value.Text("Camera")),
                    data.Field.Named("prototype", data.Value.Text("Camera"))
                ])
            ]))
        ])
    )
}
