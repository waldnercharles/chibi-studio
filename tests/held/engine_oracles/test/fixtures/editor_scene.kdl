version 1
name "Editor interaction fixture"
(array)entities {
    - {
        name "Enemy_1"
        prototype "Enemy"
        (array)behaviors "HealthBehavior" "EnemyBehavior"
    }
    - {
        name "InputEntity_1"
        prototype "InputEntity"
        (array)behaviors "InputBehavior"
    }
    - {
        name "Player_1"
        prototype "Player"
        (array)behaviors "InputBehavior" "WeaponBehavior" "HealthBehavior" "AutoWeaponBehavior" "PlayerContactBehavior" "MovementTrailBehavior"
    }
    - name="StaticEntity_1" prototype="StaticEntity"
    - {
        name "Projectile_1"
        prototype "Projectile"
        (array)behaviors "ProjectileBehavior" "ProjectileHitBehavior"
    }
}
