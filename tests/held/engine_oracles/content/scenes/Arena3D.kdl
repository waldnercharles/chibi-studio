version 1
name "Arena 3D"
presentation "3d"
(array)entities {
    - name="Arena" prototype="ArenaFloor"
    - {
        name "Encounter"
        prototype "ArenaEncounter"
        (array)behaviors "ArenaWaveBehavior"
    }
    - {
        name "Player"
        prototype "ArenaPlayer"
        (array)behaviors "TwinStickInputBehavior" "TwinStickWeaponBehavior" "HealthBehavior" "PlayerContactBehavior" "ArenaShipMotionBehavior" "CombatFeedback" "ArenaImpactFeedback"
    }
    - name="Phase Warden" prototype="PhaseWarden"
    - {
        name "Boundary 1"
        prototype "ArenaWallHorizontal"
        components {
            GameTransform x=39.83717 y=-265.0
            GameOrientation radians=-1.0471976
            GameGeometry3D primitive=0 width=205.2273 depth=1.6 height=2.0 elevation=0.0
            GameCollider radius=0.0 category=8 mask=7 shape="Box" width=208.2273 height=4.0 sensor=#false ignore_entity=#null
        }
    }
    - {
        name "Boundary 2"
        prototype "ArenaWallHorizontal"
        components {
            GameTransform x=323.31616 y=-354.0
            GameOrientation radians=0.0
            GameGeometry3D primitive=0 width=463.88022 depth=1.6 height=2.0 elevation=0.0
            GameCollider radius=0.0 category=8 mask=7 shape="Box" width=466.88022 height=4.0 sensor=#false ignore_entity=#null
        }
    }
    - {
        name "Boundary 3"
        prototype "ArenaWallHorizontal"
        components {
            GameTransform x=606.7951 y=-265.0
            GameOrientation radians=1.0471976
            GameGeometry3D primitive=0 width=205.2273 depth=1.6 height=2.0 elevation=0.0
            GameCollider radius=0.0 category=8 mask=7 shape="Box" width=208.2273 height=4.0 sensor=#false ignore_entity=#null
        }
    }
    - {
        name "Boundary 4"
        prototype "ArenaWallHorizontal"
        components {
            GameTransform x=606.7951 y=-87.0
            GameOrientation radians=2.0943952
            GameGeometry3D primitive=0 width=205.2273 depth=1.6 height=2.0 elevation=0.0
            GameCollider radius=0.0 category=8 mask=7 shape="Box" width=208.2273 height=4.0 sensor=#false ignore_entity=#null
        }
    }
    - {
        name "Boundary 5"
        prototype "ArenaWallHorizontal"
        components {
            GameTransform x=323.31616 y=2.0
            GameOrientation radians=3.1415927
            GameGeometry3D primitive=0 width=463.88022 depth=1.6 height=2.0 elevation=0.0
            GameCollider radius=0.0 category=8 mask=7 shape="Box" width=466.88022 height=4.0 sensor=#false ignore_entity=#null
        }
    }
    - {
        name "Boundary 6"
        prototype "ArenaWallHorizontal"
        components {
            GameTransform x=39.83717 y=-87.0
            GameOrientation radians=-2.0943952
            GameGeometry3D primitive=0 width=205.2273 depth=1.6 height=2.0 elevation=0.0
            GameCollider radius=0.0 category=8 mask=7 shape="Box" width=208.2273 height=4.0 sensor=#false ignore_entity=#null
        }
    }
    - name="Environment" prototype="ArenaEnvironment"
    - {
        name "Space Dash"
        prototype "ActionBinding"
        components {
            GameActionBinding source="Space" action="Dash" firing=#false
        }
    }
    - {
        name "Shift Dash"
        prototype "ActionBinding"
        components {
            GameActionBinding source="Shift" action="Dash" firing=#false
        }
    }
    - {
        name "Pad Dash"
        prototype "ActionBinding"
        components {
            GameActionBinding source="Pad A" action="Dash" firing=#false
        }
    }
    - {
        name "Stick Fire"
        prototype "ActionBinding"
        components {
            GameActionBinding source="Aim Stick" action="Fire" firing=#true
        }
    }
    - {
        name "Trigger Fire"
        prototype "ActionBinding"
        components {
            GameActionBinding source="Pad Right Trigger" action="Fire" firing=#true
        }
    }
    - {
        name "Mouse Fire"
        prototype "ActionBinding"
        components {
            GameActionBinding source="Mouse Left" action="Fire" firing=#true disabled=#false
        }
    }
}
